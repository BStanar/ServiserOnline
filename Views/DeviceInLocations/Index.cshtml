@model IEnumerable<ServiserOnline.Models.DeviceInLocation>
@{
    ViewBag.Title = "Uređaji na lokaciji";

    var byLocation = Model
        .GroupBy(d => new {
            Id   = d.Location?.ID,
            Name = d.Location?.LocationName ?? "—",
            City = d.Location?.City ?? ""
        })
        .OrderBy(g => g.Key.Name);

    int totalDevices  = Model.Count();
    int locationCount = byLocation.Count();
    var selectedLocationId = ViewBag.CreateID is Guid g ? g : Guid.Empty;
    Guid? selectedClientId = ViewBag.CreateIDClient as Guid?;

    bool canAdd = selectedLocationId != Guid.Empty && selectedClientId.HasValue;

    // Action menus — built once, reused in table and card list
    var actionMenus = Model.ToDictionary(
        item => item.ID,
        item => new List<ActionMenuItem>
        {
            new ActionMenuItem
            {
                Text = "Izmjeni",
                Url  = Url.Action("Edit", "DeviceInLocations",
                           new { id = item.ID, SelectedClient = selectedClientId })
            },
            new ActionMenuItem
            {
                Text       = "Izbriši",
                Variant    = "danger",
                DataAction = "delete-dil",
                DataJson   = System.Text.Json.JsonSerializer.Serialize(new {
                    id       = item.ID,
                    serial   = item.Device?.SerialNumber ?? "",
                    location = item.Location?.LocationName ?? ""
                })
            }
        }
    );

    var filterButtons = new List<FilterButton>();
    if (selectedLocationId != Guid.Empty)
    {
        filterButtons.Add(new FilterButton
        {
            Text    = "Očisti filter",
            Url     = Url.Action("Index", "DeviceInLocations", new { SelectedClient = selectedClientId }),
            Variant = "danger",
            Active  = true
        });
    }

    string? addOnClick = canAdd
        ? $"window.location.href='{Url.Action("Create", "DeviceInLocations", new { SelectedLocation = selectedLocationId, SelectedClient = selectedClientId })}'"
        : null;
}

@section Styles {
    <style>
        .dil-date {
            font-family: var(--mono);
            font-size: 12.5px;
            color: var(--text-2);
        }
    </style>
}

<div class="sp-page-wrap dil-page">

    @await Html.PartialAsync("_Header", new HeaderViewModel
    {
        Title              = "Uređaji na lokaciji",
        RowCount           = totalDevices,
        MetaText           = $"{locationCount} lokacija",
        ShowSearch         = false,
        ShowDropdownFilter = true,
        DropdownName       = "SelectedLocation",
        DropdownLabel      = "Lokacija: sve",
        DropdownItems      = (ViewBag.SelectedLocation as IEnumerable<SelectListItem>)?.ToList() ?? new List<SelectListItem>(),
        ShowAddButton      = canAdd,
        AddButtonText      = "Dodijeli novi",
        AddButtonOnClick   = addOnClick,
        FormAction         = "Index",
        FormController     = "DeviceInLocations",
        HiddenFields       = selectedClientId.HasValue
                                 ? new Dictionary<string, string> { ["SelectedClient"] = selectedClientId.Value.ToString() }
                                 : new Dictionary<string, string>(),
        FilterButtons      = filterButtons
    })

    @if (!Model.Any())
    {
        <div class="sp-empty-state" style="text-align:center;padding:60px 20px;color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"
                 stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;opacity:.5;">
                <path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
            <p style="font-size:14px;margin:0 0 6px 0;">Nema uređaja za prikaz.</p>
            @if (canAdd)
            {
                <a class="sp-btn sp-btn-primary sp-btn-sm" style="margin-top:8px;"
                   href="@Url.Action("Create", "DeviceInLocations", new { SelectedLocation = selectedLocationId, SelectedClient = selectedClientId })">
                    Dodijeli uređaj
                </a>
            }
        </div>
    }
    else
    {
        <!-- TABLE (desktop) -->
        <div class="sp-tablewrap">
            <table class="sp-table" id="dilTable">
                <thead>
                    <tr>
                        <th style="width:26%">Model</th>
                        <th style="width:22%">Serijski broj</th>
                        <th style="width:14%">Instalacija</th>
                        <th style="width:14%">Garancija do</th>
                        <th style="width:32px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var locGroup in byLocation)
                    {
                        var locationKey  = "loc-" + (locGroup.Key.Id?.ToString("N") ?? "none");
                        var locAddClick  = (locGroup.Key.Id.HasValue && selectedClientId.HasValue)
                            ? $"window.location.href='{Url.Action("Create", "DeviceInLocations", new { SelectedLocation = locGroup.Key.Id, SelectedClient = selectedClientId })}'"
                            : null;
                        var locMeta = (string.IsNullOrEmpty(locGroup.Key.City) ? "" : locGroup.Key.City + " · ")
                                      + locGroup.Count() + " uređaja";

                        @await Html.PartialAsync("GroupRow", new GroupRowViewModel
                        {
                            GroupKey          = locationKey,
                            Title             = locGroup.Key.Name,
                            Meta              = locMeta,
                            Colspan           = 5,
                            AddButtonText     = locGroup.Key.Id.HasValue && selectedClientId.HasValue ? "+ Dodijeli" : null,
                            AddButtonOnClick  = locAddClick
                        })

                        foreach (var item in locGroup.OrderBy(x => x.Model?.Name).ThenBy(x => x.Device?.SerialNumber))
                        {
                            var payload = System.Text.Json.JsonSerializer.Serialize(new {
                                id           = item.ID,
                                serial       = item.Device?.SerialNumber ?? "",
                                model        = item.Model?.Name ?? "",
                                location     = item.Location?.LocationName ?? "",
                                locationCity = item.Location?.City ?? "",
                                install      = item.DateOfInstalation.ToString("dd.MM.yyyy"),
                                guarantee    = item.DateOfGuarantieEnd.ToString("dd.MM.yyyy"),
                                description  = item.DeviceInLocationDescription ?? "",
                                editUrl      = Url.Action("Edit", "DeviceInLocations", new { id = item.ID, SelectedClient = selectedClientId })
                            });

                            <tr class="sp-data-row group-@locationKey"
                                style="cursor:pointer;"
                                data-action="open-details"
                                data-json="@payload">
                                <td>@(item.Model?.Name ?? "—")</td>
                                <td><span class="sp-mono">@(item.Device?.SerialNumber ?? "—")</span></td>
                                <td><span class="dil-date">@item.DateOfInstalation.ToString("dd.MM.yyyy")</span></td>
                                <td><span class="dil-date">@item.DateOfGuarantieEnd.ToString("dd.MM.yyyy")</span></td>
                                <td onclick="event.stopPropagation();">
                                    @await Html.PartialAsync("ActionMenu", actionMenus[item.ID])
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- CARD LIST (mobile) -->
        <div class="sp-card-list">
            @foreach (var locGroup in byLocation)
            {
                var locAddClick2 = (locGroup.Key.Id.HasValue && selectedClientId.HasValue)
                    ? $"window.location.href='{Url.Action("Create", "DeviceInLocations", new { SelectedLocation = locGroup.Key.Id, SelectedClient = selectedClientId })}'"
                    : null;

                var cardItems = locGroup
                    .OrderBy(x => x.Model?.Name).ThenBy(x => x.Device?.SerialNumber)
                    .Select(item => new CardItemViewModel
                    {
                        Title       = item.Device?.SerialNumber ?? "—",
                        Subtitle    = item.Model?.Name ?? "—",
                        MetaLeft    = "Inst: " + item.DateOfInstalation.ToString("dd.MM.yyyy"),
                        MetaRight   = "Gar: "  + item.DateOfGuarantieEnd.ToString("dd.MM.yyyy"),
                        MenuItems   = actionMenus[item.ID]
                    }).ToList();

                @await Html.PartialAsync("CardGroup", new CardGroupViewModel
                {
                    Title           = locGroup.Key.Name,
                    Meta            = locGroup.Key.City,
                    AddButtonText   = locGroup.Key.Id.HasValue && selectedClientId.HasValue ? "+ Dodijeli" : null,
                    AddButtonOnClick = locAddClick2,
                    Sections = new List<CardSectionViewModel>
                    {
                        new CardSectionViewModel
                        {
                            Title     = locGroup.Count() + " uređaja",
                            EmptyText = "Nema uređaja na ovoj lokaciji.",
                            Items     = cardItems
                        }
                    }
                })
            }
        </div>
    }

    <div style="margin-top:16px;">
        @Html.ActionLink("← Lista lokacija", "Index", "ClientLocations",
            new { SelectedClient = selectedClientId },
            new { @class = "sp-btn sp-btn-ghost sp-btn-sm" })
    </div>
</div>

<!-- ========== Modal: Details ========== -->
<div class="sp-modal-scrim" id="detailsScrim" data-modal-close="detailsScrim,detailsModal"></div>
<div class="sp-modal sp-modal-md" id="detailsModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title sp-mono" id="detailsTitle"></div>
                <div class="sp-modal-sub" id="detailsSubtitle"></div>
            </div>
            <button type="button" class="sp-iconbtn" data-modal-close="detailsScrim,detailsModal">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                    <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
                </svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div class="sp-formgrid">
                <div class="sp-field sp-col-2">
                    <label class="sp-label">Lokacija</label>
                    <div class="sp-field-display" id="detailsLocation"></div>
                </div>
                <div class="sp-field">
                    <label class="sp-label">Datum instalacije</label>
                    <div class="sp-field-display sp-mono" id="detailsInstall"></div>
                </div>
                <div class="sp-field">
                    <label class="sp-label">Garancija do</label>
                    <div class="sp-field-display sp-mono" id="detailsGuarantee"></div>
                </div>
                <div class="sp-field sp-col-2">
                    <label class="sp-label">Opis</label>
                    <div class="sp-field-display" id="detailsDescription"
                         style="white-space:pre-wrap;min-height:48px;"></div>
                </div>
            </div>
        </div>
        <div class="sp-modal-foot">
            <span></span>
            <div style="display:flex;gap:8px;">
                <button type="button" class="sp-btn sp-btn-ghost"
                        data-modal-close="detailsScrim,detailsModal">Zatvori</button>
                <a class="sp-btn sp-btn-ghost" id="detailsEditLink" href="#" style="text-decoration:none;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <path d="M11 2.5l2.5 2.5L5 13.5H2.5V11z" />
                    </svg>
                    Izmjeni
                </a>
                <button type="button" class="sp-btn sp-btn-danger" id="detailsDeleteBtn">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" />
                    </svg>
                    Izbriši
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== Modal: Delete ========== -->
<div class="sp-modal-scrim" id="deleteScrim" data-modal-close="deleteScrim,deleteModal"></div>
<div class="sp-modal sp-modal-sm" id="deleteModal">
    <div class="cl-modal-wrap">
        <form method="post" id="deleteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div class="sp-modal-body" style="padding:22px 24px 12px;">
                <div class="sp-danger-icon">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" />
                    </svg>
                </div>
                <div class="sp-modal-title" style="margin-top:14px;">Ukloni uređaj sa lokacije?</div>
                <div class="sp-modal-sub" style="margin-top:6px;line-height:1.5;">
                    Uređaj <span class="sp-mono" id="deleteSerial"></span> bit će uklonjen sa lokacije
                    <b id="deleteLocation"></b>.
                </div>
                <label class="sp-confirm">
                    <input type="checkbox" id="deleteConfirmCheck" />
                    <span>Razumijem da je ovo trajna radnja.</span>
                </label>
            </div>
            <div class="sp-modal-foot">
                <button type="button" class="sp-btn sp-btn-ghost"
                        data-modal-close="deleteScrim,deleteModal">Odustani</button>
                <button type="submit" class="sp-btn sp-btn-danger" id="btnConfirmDelete" disabled>Izbriši</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        window.PAGE = {
            deleteBaseUrl: '@Url.Action("Delete", "DeviceInLocations")'
        };
    </script>
    <script src="~/js/device-in-locations.js" asp-append-version="true"></script>
}
