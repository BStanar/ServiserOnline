@model IEnumerable<ServiserOnline.Models.DeviceInLocation>
@{
    ViewBag.Title = "Uređaji na lokaciji";

    var byLocation = Model
        .GroupBy(d => new
        {
            Id = d.Location?.ID,
            Name = d.Location?.LocationName ?? "—",
            City = d.Location?.City ?? ""
        })
        .OrderBy(g => g.Key.Name);

    int totalDevices = Model.Count();
    int locationCount = byLocation.Count();
    var selectedLocationId = ViewBag.CreateID is Guid g ? g : Guid.Empty;
    Guid? selectedClientId = ViewBag.CreateIDClient as Guid?;
}

@section Styles {
    <link rel="stylesheet" href="~/css/sp-styles.css" asp-append-version="true" />

    <style>
        .dil-date-cell {
            font-family: var(--mono);
            font-size: 12.5px;
            color: var(--text-2);
        }

        .dil-location-sub {
            color: var(--muted);
            font-size: 12px;
            margin-left: 6px;
        }

        .dil-link-btn {
            text-decoration: none;
        }

        .dil-desc {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }
    </style>
}

<div class="sp-page-wrap">
    <div class="sp-pagehead">
        <div>
            <h1 class="sp-h1">Uređaji na lokaciji</h1>
            <div class="sp-sub">
                <span>@totalDevices uređaja &middot; @locationCount lokacija</span>
                @if (selectedLocationId != Guid.Empty)
                {
                    <span>Prikazana je odabrana lokacija</span>
                }
            </div>
        </div>

        <div class="sp-actions">
            @using (Html.BeginForm("Index", "DeviceInLocations", FormMethod.Get, new { @class = "d-flex gap-2 align-items-center" }))
            {
                <div class="sp-search" style="min-width:260px;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="7" cy="7" r="4.5" /><path d="M14 14l-3.2-3.2" /></svg>
                    @Html.DropDownList("SelectedLocation", null, "Lokacija: sve", new { @class = "sp-chip", style = "border:none;background:transparent;cursor:pointer;width:100%;", onchange = "this.form.submit()" })
                    @Html.Hidden("SelectedClient", selectedClientId)
                </div>
            }

            <span class="sp-divider-v"></span>

            @if (selectedLocationId != Guid.Empty && selectedClientId.HasValue)
            {
                <a class="sp-btn sp-btn-primary dil-link-btn"
                       href="@Url.Action("Create", "DeviceInLocations", new { SelectedLocation = selectedLocationId, SelectedClient = selectedClientId })">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
                    Dodijeli novi
                </a>
            }
            else
            {
                <button type="button" class="sp-btn sp-btn-primary" disabled title="Odaberite lokaciju prije dodjele">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
                    Dodijeli novi
                </button>
            }
        </div>
    </div>

    <div class="sp-toolbar">
        <div class="sp-chips">
            @if (selectedLocationId != Guid.Empty)
            {
                <a href="@Url.Action("Index", "DeviceInLocations", new { SelectedClient = selectedClientId })" class="sp-chip" style="color:var(--danger);text-decoration:none;">
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
                    Očisti filter
                </a>
            }
        </div>
        <div class="sp-meta">@totalDevices redova</div>
    </div>

    @if (!Model.Any())
    {
        <div class="sp-empty-state" style="text-align:center;padding:60px 20px;color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;opacity:.5;"><path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            <p style="font-size:14px;margin:0 0 6px 0;">Nema uređaja za prikaz na odabranoj lokaciji.</p>
            @if (selectedLocationId != Guid.Empty && selectedClientId.HasValue)
            {
                <a class="sp-btn sp-btn-primary sp-btn-sm dil-link-btn" style="margin-top:8px;"
                       href="@Url.Action("Create", "DeviceInLocations", new { SelectedLocation = selectedLocationId, SelectedClient = selectedClientId })">
                    Dodijeli uređaj
                </a>
            }
        </div>
    }
    else
    {
        <div class="sp-tablewrap">
            <table class="sp-table" id="dilTable">
                <thead>
                    <tr>
                        <th style="width:28%">Lokacija</th>
                        <th style="width:24%">Model</th>
                        <th style="width:18%">Serijski broj</th>
                        <th style="width:13%">Instalacija</th>
                        <th style="width:13%">Garancija</th>
                        <th style="width:32px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var locGroup in byLocation)
                    {
                        var locationKey = "loc-" + (locGroup.Key.Id?.ToString("N") ?? "none");
                        <tr class="sp-mfr-row" data-group="@locationKey" onclick="toggleGroup('@locationKey')">
                            <td colspan="6">
                                <div style="display:flex;align-items:center;width:100%;">
                                    <span class="sp-mfr-arrow" id="arrow-@locationKey">
                                        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l5 5 5-5" /></svg>
                                    </span>
                                    <span class="sp-mfr-tag">@locGroup.Key.Name</span>
                                    @if (!string.IsNullOrEmpty(locGroup.Key.City))
                                    {
                                        <span class="dil-location-sub">@locGroup.Key.City</span>
                                    }
                                    <span class="sp-mfr-count">@locGroup.Count() uređaja</span>

                                    @if (locGroup.Key.Id.HasValue && selectedClientId.HasValue)
                                    {
                                        <a class="sp-btn sp-btn-xs sp-btn-ghost sp-model-add dil-link-btn"
                                               onclick="event.stopPropagation();"
                                               href="@Url.Action("Create", "DeviceInLocations", new { SelectedLocation = locGroup.Key.Id, SelectedClient = selectedClientId })">
                                            + Dodijeli uređaj
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>

                        foreach (var item in locGroup.OrderBy(x => x.Model?.Name).ThenBy(x => x.Device?.SerialNumber))
                        {
                            <tr class="sp-data-row group-@locationKey dil-row"
                                data-id="@item.ID"
                                data-location="@(item.Location?.LocationName ?? "")"
                                data-location-city="@(item.Location?.City ?? "")"
                                data-model="@(item.Model?.Name ?? "")"
                                data-serial="@(item.Device?.SerialNumber ?? "")"
                                data-install="@item.DateOfInstalation.ToString("dd.MM.yyyy")"
                                data-guarantee="@item.DateOfGuarantieEnd.ToString("dd.MM.yyyy")"
                                data-description="@(item.DeviceInLocationDescription ?? "")">
                                <td class="sp-name-cell">
                                    @item.Location?.LocationName
                                    @if (!string.IsNullOrEmpty(item.Location?.City))
                                    {
                                        <span class="dil-location-sub">@item.Location.City</span>
                                    }
                                </td>
                                <td>@(item.Model?.Name ?? "—")</td>
                                <td><span class="sp-mono">@(item.Device?.SerialNumber ?? "—")</span></td>
                                <td><span class="dil-date-cell">@item.DateOfInstalation.ToString("dd.MM.yyyy")</span></td>
                                <td><span class="dil-date-cell">@item.DateOfGuarantieEnd.ToString("dd.MM.yyyy")</span></td>
                                <td onclick="event.stopPropagation();">
                                    <div class="sp-more-wrap sp-row-actions">
                                        <button type="button" class="sp-iconbtn sp-more-trigger">
                                            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="3.5" cy="8" r=".9" fill="currentColor" /><circle cx="8" cy="8" r=".9" fill="currentColor" /><circle cx="12.5" cy="8" r=".9" fill="currentColor" /></svg>
                                        </button>
                                        <div class="sp-more-menu">
                                            <a class="sp-more-item" style="text-decoration:none;"
                                                   href="@Url.Action("Edit", "DeviceInLocations", new { id = item.ID, SelectedClient = selectedClientId })">
                                                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M11 2.5l2.5 2.5L5 13.5H2.5V11z" /></svg>
                                                Izmjeni
                                            </a>
                                            <div class="sp-more-item danger dil-delete-trigger"
                                                 data-id="@item.ID"
                                                 data-serial="@(item.Device?.SerialNumber ?? "")"
                                                 data-location="@(item.Location?.LocationName ?? "")">
                                                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" /></svg>
                                                Izbriši
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="sp-mobile-cards">
            @foreach (var locGroup in byLocation)
            {
                <div class="sp-mc-mfr">
                    <div class="sp-mc-mfr-head">
                        <div>
                            <div class="sp-mc-mfr-name">@locGroup.Key.Name</div>
                            <div class="sp-mc-mfr-meta">
                                <span>@locGroup.Count() uređaja</span>
                                @if (!string.IsNullOrEmpty(locGroup.Key.City))
                                {
                                    <span>@locGroup.Key.City</span>
                                }
                            </div>
                        </div>
                        @if (locGroup.Key.Id.HasValue && selectedClientId.HasValue)
                        {
                            <a class="sp-mc-mfr-add dil-link-btn"
                                   href="@Url.Action("Create", "DeviceInLocations", new { SelectedLocation = locGroup.Key.Id, SelectedClient = selectedClientId })">
                                + Dodijeli
                            </a>
                        }
                    </div>

                    @foreach (var item in locGroup.OrderBy(x => x.Model?.Name).ThenBy(x => x.Device?.SerialNumber))
                    {
                        <div class="sp-mc-item dil-card"
                             data-id="@item.ID"
                             data-location="@(item.Location?.LocationName ?? "")"
                             data-location-city="@(item.Location?.City ?? "")"
                             data-model="@(item.Model?.Name ?? "")"
                             data-serial="@(item.Device?.SerialNumber ?? "")"
                             data-install="@item.DateOfInstalation.ToString("dd.MM.yyyy")"
                             data-guarantee="@item.DateOfGuarantieEnd.ToString("dd.MM.yyyy")"
                             data-description="@(item.DeviceInLocationDescription ?? "")">
                            <div class="sp-mc-item-row1">
                                <div class="sp-mc-item-title">@(item.Model?.Name ?? "—")</div>
                                <span class="sp-badge sp-badge-ok">Aktivno</span>
                            </div>
                            <div class="sp-mc-item-row2">
                                <span class="sp-mc-item-muted">SN: @(item.Device?.SerialNumber ?? "—")</span>
                                <span class="sp-mc-item-muted">Inst: @item.DateOfInstalation.ToString("dd.MM.yyyy")</span>
                                <span class="sp-mc-item-muted">Gar: @item.DateOfGuarantieEnd.ToString("dd.MM.yyyy")</span>
                            </div>
                            <div class="sp-mc-item-row3" onclick="event.stopPropagation();">
                                <div></div>
                                <div style="display:flex;gap:6px;flex-wrap:wrap;">
                                    <a class="sp-btn sp-btn-ghost sp-btn-sm dil-link-btn"
                                           href="@Url.Action("Edit", "DeviceInLocations", new { id = item.ID, SelectedClient = selectedClientId })">
                                        Izmjeni
                                    </a>
                                    <button type="button" class="sp-btn sp-btn-danger sp-btn-sm dil-delete-trigger"
                                            data-id="@item.ID"
                                            data-serial="@(item.Device?.SerialNumber ?? "")"
                                            data-location="@(item.Location?.LocationName ?? "")">
                                        Izbriši
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div style="margin-top:16px;">
        @Html.ActionLink("← Lista lokacija", "Index", "ClientLocations", new { SelectedClient = selectedClientId }, new { @class = "sp-btn sp-btn-ghost sp-btn-sm" })
    </div>
</div>

<!-- ========== Modal: Details ========== -->
<div class="sp-modal-scrim" id="detailsScrim"></div>
<div class="sp-modal sp-modal-md" id="detailsModal">
    <div class="dv-modal-wrap">
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title" id="detailsSerial"></div>
                <div class="sp-modal-sub" id="detailsModel"></div>
            </div>
            <button type="button" class="sp-iconbtn" id="btnCloseDetails">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div class="dv-dl">
                <span class="dv-dl-label">Lokacija</span><span class="dv-dl-value" id="detailsLocation"></span>
                <span class="dv-dl-label">Model</span><span class="dv-dl-value" id="detailsModel2"></span>
                <span class="dv-dl-label">Serijski broj</span><span class="dv-dl-value sp-mono" id="detailsSerial2"></span>
                <span class="dv-dl-label">Datum instalacije</span><span class="dv-dl-value sp-mono" id="detailsInstall"></span>
                <span class="dv-dl-label">Garancija do</span><span class="dv-dl-value sp-mono" id="detailsGuarantee"></span>
                <span class="dv-dl-label">Opis</span><span class="dv-dl-value dil-desc" id="detailsDescription"></span>
            </div>
        </div>
        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" id="btnCloseDetails2">Zatvori</button>
            <div style="display:flex;gap:8px;">
                <a class="sp-btn sp-btn-ghost dil-link-btn" id="detailsEditLink" href="#">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M11 2.5l2.5 2.5L5 13.5H2.5V11z" /></svg>
                    Izmjeni
                </a>
                <button type="button" class="sp-btn sp-btn-danger" id="detailsDeleteBtn" data-id="" data-serial="" data-location="">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" /></svg>
                    Izbriši
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== Modal: Delete ========== -->
<div class="sp-modal-scrim" id="deleteScrim"></div>
<div class="sp-modal sp-modal-sm" id="deleteModal">
    <div class="dv-modal-wrap">
        <form method="post" id="deleteForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <div class="sp-modal-body" style="padding:22px 24px 12px;">
                <div class="sp-danger-icon">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" /></svg>
                </div>
                <div class="sp-modal-title" style="margin-top:14px;">Ukloni uređaj sa lokacije?</div>
                <div class="sp-modal-sub" style="margin-top:6px;line-height:1.5;">
                    Uređaj <span class="sp-mono" id="deleteSerial"></span> bit će uklonjen sa lokacije <b id="deleteLocation"></b>.
                </div>
                <label class="sp-confirm">
                    <input type="checkbox" id="deleteConfirmCheck" />
                    <span>Razumijem da je ovo trajna radnja.</span>
                </label>
            </div>
            <div class="sp-modal-foot">
                <button type="button" class="sp-btn sp-btn-ghost" id="btnCancelDelete">Odustani</button>
                <button type="submit" class="sp-btn sp-btn-danger" id="btnConfirmDelete" disabled>Izbriši</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(scrimId, modalId) {
            document.getElementById(scrimId).classList.add('open');
            document.getElementById(modalId).classList.add('open');
        }

        function closeModal(scrimId, modalId) {
            document.getElementById(scrimId).classList.remove('open');
            document.getElementById(modalId).classList.remove('open');
        }

        function toggleGroup(group) {
            const rows = document.querySelectorAll('.group-' + group);
            const arrow = document.getElementById('arrow-' + group);
            const isOpen = Array.from(rows).some(r => r.style.display !== 'none');
            rows.forEach(r => { r.style.display = isOpen ? 'none' : ''; });
            if (arrow) arrow.classList.toggle('collapsed', isOpen);
        }

        function closeAllMenus() {
            document.querySelectorAll('.sp-more-menu.open').forEach(m => m.classList.remove('open'));
        }

        document.querySelectorAll('.sp-more-trigger').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                const menu = this.nextElementSibling;
                const wasOpen = menu.classList.contains('open');
                closeAllMenus();
                if (!wasOpen) menu.classList.add('open');
            });
        });
        document.addEventListener('click', closeAllMenus);

        document.getElementById('btnCloseDetails').onclick = () => closeModal('detailsScrim', 'detailsModal');
        document.getElementById('btnCloseDetails2').onclick = () => closeModal('detailsScrim', 'detailsModal');
        document.getElementById('detailsScrim').onclick = () => closeModal('detailsScrim', 'detailsModal');

        function openDetails(el) {
            const d = el.dataset;
            const locationText = d.location ? d.location + (d.locationCity ? ', ' + d.locationCity : '') : '—';

            document.getElementById('detailsSerial').textContent = d.serial || '—';
            document.getElementById('detailsSerial2').textContent = d.serial || '—';
            document.getElementById('detailsModel').textContent = d.model || '';
            document.getElementById('detailsModel2').textContent = d.model || '—';
            document.getElementById('detailsLocation').textContent = locationText;
            document.getElementById('detailsInstall').textContent = d.install || '—';
            document.getElementById('detailsGuarantee').textContent = d.guarantee || '—';
            document.getElementById('detailsDescription').textContent = d.description || '—';

            const edit = document.getElementById('detailsEditLink');
            edit.href = '/DeviceInLocations/Edit/' + d.id + '?SelectedClient=@selectedClientId';

            const del = document.getElementById('detailsDeleteBtn');
            del.dataset.id = d.id;
            del.dataset.serial = d.serial || '';
            del.dataset.location = d.location || '';

            openModal('detailsScrim', 'detailsModal');
        }

        document.querySelectorAll('.dil-row').forEach(row => {
            row.addEventListener('click', () => openDetails(row));
        });

        document.querySelectorAll('.dil-card').forEach(card => {
            card.addEventListener('click', () => openDetails(card));
        });

        document.getElementById('btnCancelDelete').onclick = () => closeModal('deleteScrim', 'deleteModal');
        document.getElementById('deleteScrim').onclick = () => closeModal('deleteScrim', 'deleteModal');
        document.getElementById('deleteConfirmCheck').addEventListener('change', function () {
            document.getElementById('btnConfirmDelete').disabled = !this.checked;
        });

        function openDeleteModal(id, serial, location) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteSerial').textContent = serial || '';
            document.getElementById('deleteLocation').textContent = location || '';
            document.getElementById('deleteConfirmCheck').checked = false;
            document.getElementById('btnConfirmDelete').disabled = true;
            document.getElementById('deleteForm').action = '/DeviceInLocations/Delete/' + id;
            closeAllMenus();
            closeModal('detailsScrim', 'detailsModal');
            openModal('deleteScrim', 'deleteModal');
        }

        document.querySelectorAll('.dil-delete-trigger').forEach(el => {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
                openDeleteModal(this.dataset.id, this.dataset.serial, this.dataset.location);
            });
        });

        document.getElementById('detailsDeleteBtn').addEventListener('click', function(e) {
            e.stopPropagation();
            openDeleteModal(this.dataset.id, this.dataset.serial, this.dataset.location);
        });
    </script>
}
