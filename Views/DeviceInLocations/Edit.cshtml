@model ServiserOnline.Models.DeviceInLocation

@{
    ViewBag.Title = "Izmjeni uređaj na lokaciji";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Izmjeni uređaj na lokaciji</h2>
    @Html.ActionLink("← Nazad na listu", "Index", new { SelectedLocation = Model.Location?.ID, SelectedClient = Model.SelectedClientID }, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)
            @Html.HiddenFor(model => model.SelectedClientID)

            <div class="mb-3">
                <label class="form-label fw-semibold">Lokacija</label>
                @Html.DropDownList("LocationID", null, new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.LocationID, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Manufacturer, "Proizvođač", new { @class = "form-label fw-semibold" })
                @Html.DropDownList("Manufacturer", ViewBag.Manufacturer as SelectList, "-- Odaberi proizvođača --", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Model, "Model", new { @class = "form-label fw-semibold" })
                @Html.DropDownList("Model", ViewBag.Model as SelectList, "-- Odaberi model --", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Device, "Uređaj", new { @class = "form-label fw-semibold" })
                @Html.DropDownList("Device", ViewBag.Device as SelectList, "-- Odaberi uređaj --", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateOfInstalation, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.DateOfInstalation, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DateOfInstalation, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateOfGuarantieEnd, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.DateOfGuarantieEnd, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DateOfGuarantieEnd, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DeviceInLocationDescription, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.DeviceInLocationDescription, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DeviceInLocationDescription, "", new { @class = "text-danger small" })
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
                @Html.ActionLink("Odustani", "Index", new { SelectedLocation = Model.Location?.ID, SelectedClient = Model.SelectedClientID }, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('Manufacturer').addEventListener('change', function () {
            fetch('/DeviceInLocations/GetModelsList?SelectedManufacturer=' + this.value)
                .then(r => r.json())
                .then(data => {
                    const modelSel = document.getElementById('Model');
                    const deviceSel = document.getElementById('Device');
                    modelSel.innerHTML = '<option value="">-- Odaberi model --</option>';
                    deviceSel.innerHTML = '<option value="">-- Odaberi uređaj --</option>';
                    data.forEach(row => {
                        const opt = document.createElement('option');
                        opt.value = row.id;
                        opt.textContent = row.name;
                        modelSel.appendChild(opt);
                    });
                });
        });

        document.getElementById('Model').addEventListener('change', function () {
            fetch('/DeviceInLocations/GetDevicesList?SelectedModel=' + this.value)
                .then(r => r.json())
                .then(data => {
                    const deviceSel = document.getElementById('Device');
                    deviceSel.innerHTML = '<option value="">-- Odaberi uređaj --</option>';
                    data.forEach(row => {
                        const opt = document.createElement('option');
                        opt.value = row.id;
                        opt.textContent = row.serialNumber;
                        deviceSel.appendChild(opt);
                    });
                });
        });
    </script>
}
