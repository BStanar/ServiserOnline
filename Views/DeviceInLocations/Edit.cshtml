@model ServiserOnline.Models.DeviceInLocation

@{
    ViewBag.Title = "Edit";
}
<script>
    $(document).ready(function () {
        $("#Model").change(function () {
            $.get("/DeviceInLocations/GetDevicesList", { SelectedModel: $("#Model").val() }, function (data) {
                $("#Device").empty();
                $.each(data, function (index, row) {
                    $("#Device").append("<option value='" + row.ID + "'>" + row.SerialNumber + "</option>")
                });
            });
        })
    });
    $(document).ready(function () {
        $("#Manufacturer").change(function () {
            $.get("/DeviceInLocations/GetModelsList", { SelectedManufacturer: $("#Manufacturer").val() }, function (data) {
                $("#Model").empty();
                $.each(data, function (index, row) {
                    $("#Model").append("<option value='" + row.ID + "'>" + row.Name + "</option>")
                });
            });
        })
    });
</script>
<h2>Izmjeni</h2>


@using (Html.BeginForm())
{
