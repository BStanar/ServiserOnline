@using ServiserOnline.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<ServiserOnline.Models.SparePart>
@{
    ViewBag.Title = "Rezervni dijelovi";

    var byManufacturer = Model
        .GroupBy(s => new { Id = s.Model?.Manufacturer?.ID, Name = s.Model?.Manufacturer?.Name ?? "—" })
        .OrderBy(g => g.Key.Name);

    int totalAll   = (int)(ViewBag.TotalAll  ?? 0);
    int outOfStock = (int)(ViewBag.TotalOut  ?? 0);
    int mfrCount   = (int)(ViewBag.MfrCount  ?? 0);
    int modelCount = (int)(ViewBag.ModelCount ?? 0);
    int rowsShown  = Model.Count();

    string? search    = ViewBag.CurrentFilter as string;
    string  activeTab = ViewBag.ActiveTab as string ?? "all";
    var createId      = ViewBag.CreateID is Guid g ? g : Guid.Empty;
    var modelMfrMap   = ViewBag.ModelMfrMap as Dictionary<string, string> ?? new Dictionary<string, string>();
    var modelOptions  = ((IEnumerable<SelectListItem>)(ViewBag.SelectedProductModel ?? Enumerable.Empty<SelectListItem>())).ToList();
    var groupedModelOptions = modelOptions
        .GroupBy(o => o.Group?.Name ?? "Bez proizvođača")
        .OrderBy(g => g.Key).ToList();

    var headerVm = new HeaderViewModel
    {
        Title             = "Rezervni dijelovi",
        MetaText          = $"{totalAll} stavki · {mfrCount} proizvođača · {modelCount} modela",
        CriticalText      = outOfStock > 0 ? $"{outOfStock} nema na stanju" : null,
        ShowSearch        = true,
        FormAction        = "Index",
        FormController    = "SpareParts",
        SearchName        = "searchString",
        SearchValue       = search,
        SearchPlaceholder = "Pretraži naziv ili kat. br...",
        ShowAddButton     = true,
        AddButtonText     = "+ Kreiraj novi",
        AddButtonId       = "btnOpenCreate",
        AddButtonOnClick  = "openCreateModal()",
        ShowDropdownFilter = true,
        DropdownName      = "SelectedProductModel",
        DropdownLabel     = "Model: svi",
        DropdownItems     = modelOptions,
        FilterButtons = new List<FilterButton>
        {
            new FilterButton
            {
                Text   = "Svi",
                Active = activeTab == "all",
                Url    = Url.Action("Index", "SpareParts", new { ActiveTab = "all",  searchString = search })!
            },
            new FilterButton
            {
                Text    = "Nema",
                Badge   = ((int)(ViewBag.TotalOut ?? 0)) > 0 ? ((int)ViewBag.TotalOut).ToString() : null,
                Active  = activeTab == "out",
                Variant = "danger",
                Url     = Url.Action("Index", "SpareParts", new { ActiveTab = "out", searchString = search })!
            },
            new FilterButton
            {
                Text    = "Malo",
                Badge   = ((int)(ViewBag.TotalLow ?? 0)) > 0 ? ((int)ViewBag.TotalLow).ToString() : null,
                Active  = activeTab == "low",
                Url     = Url.Action("Index", "SpareParts", new { ActiveTab = "low", searchString = search })!
            }
        },
        RowCount = rowsShown
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/card-style.css" asp-append-version="true" />
    <style>
        .sp-price-display { cursor:pointer; border-radius:4px; padding:1px 4px; }
        .sp-price-display:hover { background:var(--primary-bg); }
        .sp-edit-cell { display:none; }
        tr.editing-price .sp-price-display { display:none; }
        tr.editing-price .sp-edit-cell { display:flex; }

        @@media (min-width: 901px) {
            .sp-tablewrap { display:block !important; }
            .sp-card-list { display:none !important; }
        }
    </style>
}

<div class="sp-page-wrap">

    <partial name="_Header" model="headerVm" />

    @if (!string.IsNullOrWhiteSpace(search) || createId != Guid.Empty || activeTab != "all")
    {
        <div style="padding:4px 0 2px;">
            <a href="/SpareParts" class="sp-chip" style="color:var(--danger);">
                <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
                Očisti filter
            </a>
        </div>
    }

    @if (Model.Any())
    {
        @* ── DESKTOP TABLE ── *@
        <div class="sp-tablewrap">
            <table class="sp-table" id="spTable">
                <thead>
                    <tr>
                        <th style="width:30%">Naziv</th>
                        <th style="width:13%">Kat. br.</th>
                        <th style="width:13%">Ser. br.</th>
                        <th style="width:10%" class="num">Na stanju</th>
                        <th style="width:10%" class="num">Cijena (KM)</th>
                        <th style="width:10%">Status</th>
                        <th style="width:32px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mfrGroup in byManufacturer)
                    {
                        var mfrTotal        = mfrGroup.Count();
                        var manufacturerKey = "mfr-" + (mfrGroup.Key.Id?.ToString("N") ?? "none");

                        <partial name="GroupRow" model='@(new GroupRowViewModel {
                            GroupKey         = manufacturerKey,
                            Colspan          = 7,
                            Title            = mfrGroup.Key.Name,
                            Meta             = $"{mfrTotal} dijelova",
                            AddButtonText    = "+ Dodaj dio",
                            AddButtonOnClick = $"openCreateWithMfr('{mfrGroup.Key.Id}', '{mfrGroup.Key.Name}', event)"
                        })' />

                        @foreach (var modelGroup in mfrGroup
                            .GroupBy(s => new { Id = s.Model?.ID, Name = s.Model?.Name ?? "—" })
                            .OrderBy(g => g.Key.Name))
                        {
                            var modelKey   = "model-" + (modelGroup.Key.Id?.ToString("N") ?? "none");
                            var modelTotal = modelGroup.Count();

                            <partial name="ChildGroupRow" model='@(new ChildGroupRowViewModel {
                                ParentGroupKey   = manufacturerKey,
                                GroupKey         = modelKey,
                                Colspan          = 7,
                                Title            = modelGroup.Key.Name,
                                Meta             = $"{mfrGroup.Key.Name} · {modelTotal} dijelova",
                                AddButtonText    = "+ Dodaj dio",
                                AddButtonOnClick = $"openCreateWithModel('{modelGroup.Key.Id}', '{modelGroup.Key.Name}', '{mfrGroup.Key.Name}', event)"
                            })' />

                            @foreach (var item in modelGroup.OrderBy(s => s.Name))
                            {
                                var rowClass  = item.StockAmount == 0 ? "sp-row-warn" : "";
                                var badgeCls  = item.StockAmount == 0 ? "sp-badge-out" : item.StockAmount <= 3 ? "sp-badge-low" : "sp-badge-ok";
                                var badgeTxt  = item.StockAmount == 0 ? "Nema" : item.StockAmount <= 3 ? "Malo" : "Dostupno";
                                var spJson    = System.Text.Json.JsonSerializer.Serialize(new {
                                    id = item.ID, name = item.Name, sku = item.SerialNumber,
                                    catalog = item.CatalogNumber, stock = item.StockAmount,
                                    price = item.Price, modelId = item.ModelID
                                });
                                var delJson = System.Text.Json.JsonSerializer.Serialize(new {
                                    id = item.ID, name = item.Name, sku = item.SerialNumber
                                });

                                var rowMenuItems = new List<ActionMenuItem>
                                {
                                    new ActionMenuItem { Text = "Izmijeni",  DataAction = "edit-sp",   DataJson = spJson  },
                                    new ActionMenuItem { Text = "Izbriši",   DataAction = "delete-sp", DataJson = delJson, Variant = "danger" }
                                };

                                <tr class="@rowClass sp-data-row group-@manufacturerKey group-model-@modelKey"
                                    data-id="@item.ID" data-name="@item.Name" data-sku="@item.SerialNumber"
                                    data-catalog="@item.CatalogNumber" data-stock="@item.StockAmount"
                                    data-price="@item.Price" data-model-id="@item.ModelID">
                                    <td style="padding-left:28px;font-weight:500;">@item.Name</td>
                                    <td><span class="sp-mono">@(item.CatalogNumber ?? "—")</span></td>
                                    <td><span class="sp-mono">@(item.SerialNumber  ?? "—")</span></td>
                                    <td class="num">
                                        <div class="sp-stock-cell">
                                            <button class="sp-stepper sp-stock-dec" data-id="@item.ID" type="button">−</button>
                                            <span class="sp-mono sp-stock-val" id="sv-@item.ID">@item.StockAmount</span>
                                            <button class="sp-stepper sp-stock-inc" data-id="@item.ID" type="button">+</button>
                                        </div>
                                    </td>
                                    <td class="num">
                                        <span class="sp-price-display sp-mono" data-id="@item.ID">@item.Price.ToString("N2")</span>
                                        <div class="sp-edit-cell">
                                            <span class="sp-mono-prefix">KM</span>
                                            <input class="sp-edit-input sp-price-input" data-id="@item.ID" value="@item.Price.ToString("F2")" />
                                        </div>
                                    </td>
                                    <td><span class="sp-badge @badgeCls sp-status-badge" id="sb-@item.ID">@badgeTxt</span></td>
                                    <td>
                                        <partial name="ActionMenu" model="rowMenuItems" />
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        @* ── MOBILE CARDS ── *@
        <div class="sp-card-list">
            @foreach (var mfrGroup in byManufacturer)
            {
                <div class="sp-card-group">
                    <div class="sp-card-group-head">
                        <div class="sp-card-group-titleblock">
                            <div class="sp-card-group-title">@mfrGroup.Key.Name</div>
                            <div class="sp-card-group-meta">@mfrGroup.Count() dijelova</div>
                        </div>
                        <div class="sp-card-group-actions">
                            <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost"
                                    onclick="openCreateWithMfr('@mfrGroup.Key.Id', '@mfrGroup.Key.Name', event)">
                                + Dodaj dio
                            </button>
                        </div>
                    </div>

                    @foreach (var modelGroup in mfrGroup
                        .GroupBy(s => new { Id = s.Model?.ID, Name = s.Model?.Name ?? "—" })
                        .OrderBy(g => g.Key.Name))
                    {
                        <div class="sp-card-section">
                            <div class="sp-card-section-head">
                                <div class="sp-card-section-titleblock">
                                    <div class="sp-card-section-title">@modelGroup.Key.Name</div>
                                    <div class="sp-card-section-meta">@modelGroup.Count() dijelova</div>
                                </div>
                                <div class="sp-card-section-actions">
                                    <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost"
                                            onclick="openCreateWithModel('@modelGroup.Key.Id', '@modelGroup.Key.Name', '@mfrGroup.Key.Name', event)">
                                        + Dodaj dio
                                    </button>
                                </div>
                            </div>
                            <div class="sp-card-items">
                                @foreach (var item in modelGroup.OrderBy(s => s.Name))
                                {
                                    var badgeCls = item.StockAmount == 0 ? "sp-badge-out" : item.StockAmount <= 3 ? "sp-badge-low" : "sp-badge-ok";
                                    var badgeTxt = item.StockAmount == 0 ? "Nema" : item.StockAmount <= 3 ? "Malo" : "Dostupno";
                                    var spJson   = System.Text.Json.JsonSerializer.Serialize(new {
                                        id = item.ID, name = item.Name, sku = item.SerialNumber,
                                        catalog = item.CatalogNumber, stock = item.StockAmount,
                                        price = item.Price, modelId = item.ModelID
                                    });
                                    var delJson = System.Text.Json.JsonSerializer.Serialize(new {
                                        id = item.ID, name = item.Name, sku = item.SerialNumber
                                    });
                                    var cardMenuItems = new List<ActionMenuItem>
                                    {
                                        new ActionMenuItem { Text = "Izmijeni", DataAction = "edit-sp",   DataJson = spJson  },
                                        new ActionMenuItem { Text = "Izbriši",  DataAction = "delete-sp", DataJson = delJson, Variant = "danger" }
                                    };

                                    <div class="sp-card-item @(item.StockAmount == 0 ? "sp-row-warn" : "")">
                                        <div class="sp-card-item-row1">
                                            <div class="sp-card-item-titleblock">
                                                <div class="sp-card-item-title">@item.Name</div>
                                                <div class="sp-card-item-subtitle sp-mono">
                                                    @(item.CatalogNumber ?? item.SerialNumber ?? "—")
                                                </div>
                                            </div>
                                            <div class="sp-card-item-right">
                                                <span class="sp-badge @badgeCls">@badgeTxt</span>
                                                <partial name="ActionMenu" model="cardMenuItems" />
                                            </div>
                                        </div>
                                        <div class="sp-card-item-row2">
                                            <div class="sp-stock-cell">
                                                <button class="sp-stepper sp-stock-dec" data-id="@item.ID" type="button">−</button>
                                                <span class="sp-mono sp-stock-val" id="svm-@item.ID">@item.StockAmount</span>
                                                <button class="sp-stepper sp-stock-inc" data-id="@item.ID" type="button">+</button>
                                            </div>
                                            <span class="sp-mono">@item.Price.ToString("N2") KM</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div style="text-align:center;padding:60px 20px;color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);margin-top:16px;">
            <p style="font-size:14px;margin:0 0 8px;">Nema rezervnih dijelova za prikaz.</p>
            <button type="button" class="sp-btn sp-btn-ghost sp-btn-sm" onclick="openCreateModal()">
                + Kreiraj prvi dio
            </button>
        </div>
    }

</div>

@* ── CREATE modal ── *@
<div class="sp-modal-scrim" id="createSpScrim"></div>
<div class="sp-modal sp-modal-md" id="createSpModal">
    <form method="post" action="@Url.Action("Create", "SpareParts")" id="createSpForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ModelID" id="createSpModelId" />
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Kreiraj rezervni dio</div>
                <div class="sp-modal-sub" id="createSpSub">Odaberite model</div>
            </div>
            <button type="button" class="sp-iconbtn" id="btnCloseCreateSp">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9"/></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div class="sp-formgrid">
                <label class="sp-field sp-col-2">
                    <span class="sp-label">Naziv <span style="color:var(--danger)">*</span></span>
                    <input class="sp-input" name="Name" id="createSpName" required placeholder="npr. Karbonske četkice" />
                </label>
                <label class="sp-field">
                    <span class="sp-label">Kataloški broj</span>
                    <input class="sp-input sp-mono" name="CatalogNumber" id="createSpCatalog" placeholder="npr. KAT-001" />
                </label>
                <label class="sp-field">
                    <span class="sp-label">Serijski broj</span>
                    <input class="sp-input sp-mono" name="SerialNumber" id="createSpSku" placeholder="npr. SN-12345" />
                </label>

                @* Free mode: choose manufacturer then model *@
                <div id="createSpFreeMode" style="display:none;grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;">
                    <label class="sp-field">
                        <span class="sp-label">Proizvođač</span>
                        <select class="sp-input" id="createSpMfrSelect"
                                onchange="spFilterModelsForCreate(this.value)">
                            <option value="">Odaberite proizvođača…</option>
                            @foreach (var m in (IEnumerable<SelectListItem>)(ViewBag.Manufacturers ?? Enumerable.Empty<SelectListItem>()))
                            {
                                <option value="@m.Value">@m.Text</option>
                            }
                        </select>
                    </label>
                    <label class="sp-field">
                        <span class="sp-label">Model <span style="color:var(--danger)">*</span></span>
                        <select class="sp-input" id="createSpModelSelect"
                                onchange="document.getElementById('createSpModelId').value=this.value; document.getElementById('createSpSub').textContent=this.options[this.selectedIndex]?.text||'';">
                            <option value="">Odaberite model…</option>
                            @foreach (var mi in modelOptions)
                            {
                                modelMfrMap.TryGetValue(mi.Value, out var mfrId2);
                                <option value="@mi.Value" data-mfr="@mfrId2">@mi.Text</option>
                            }
                        </select>
                    </label>
                </div>

                @* Locked mode: model is pre-selected *@
                <div id="createSpLockedMode" style="display:none;grid-column:span 2;display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;">
                    <label class="sp-field">
                        <span class="sp-label">Proizvođač</span>
                        <div class="sp-input" id="createSpMfrDisplay"
                             style="background:var(--mfr-tint);cursor:default;pointer-events:none;color:var(--muted);"></div>
                    </label>
                    <label class="sp-field">
                        <span class="sp-label">Model</span>
                        <div class="sp-input" id="createSpModelDisplay"
                             style="background:var(--mfr-tint);cursor:default;pointer-events:none;"></div>
                    </label>
                </div>

                <label class="sp-field">
                    <span class="sp-label">Na stanju</span>
                    <input class="sp-input sp-mono" name="StockAmount" id="createSpStock" type="number" min="0" value="0" />
                </label>
                <label class="sp-field">
                    <span class="sp-label">Cijena (KM)</span>
                    <input class="sp-input sp-mono" name="Price" id="createSpPrice" type="number" step="0.01" min="0" value="0.00" />
                </label>
            </div>
        </div>
        <div class="sp-modal-foot">
            <span class="sp-meta">Naziv i model su obavezni</span>
            <div style="display:flex;gap:8px;">
                <button type="button" class="sp-btn sp-btn-ghost" id="btnCancelCreateSp">Odustani</button>
                <button type="submit" class="sp-btn sp-btn-primary">Kreiraj</button>
            </div>
        </div>
    </form>
</div>

@await Html.PartialAsync("_EditSparePartModal")
@await Html.PartialAsync("_DeleteSparePartModal")

@section Scripts {
    <script src="~/js/index-table.js" asp-append-version="true"></script>
    <script src="~/js/spare-part-modals.js" asp-append-version="true"></script>
    <script>
    const _spToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    // ── Create modal ──────────────────────────────────────────────────────────
    function _openCreateSp() {
        document.getElementById('createSpForm').reset();
        document.getElementById('createSpModelId').value = '';
        document.getElementById('createSpStock').value   = '0';
        document.getElementById('createSpPrice').value   = '0.00';
        document.getElementById('createSpScrim').classList.add('open');
        document.getElementById('createSpModal').classList.add('open');
    }
    function openCreateModal() {
        _openCreateSp();
        document.getElementById('createSpFreeMode').style.display  = 'grid';
        document.getElementById('createSpLockedMode').style.display = 'none';
        document.getElementById('createSpMfrSelect').disabled = false;
        document.getElementById('createSpMfrSelect').value    = '';
        spFilterModelsForCreate('');
        document.getElementById('createSpSub').textContent = 'Odaberite model';
    }
    function openCreateWithMfr(mfrId, mfrName, event) {
        if (event) event.stopPropagation();
        _openCreateSp();
        document.getElementById('createSpFreeMode').style.display  = 'grid';
        document.getElementById('createSpLockedMode').style.display = 'none';
        const mfrSel = document.getElementById('createSpMfrSelect');
        mfrSel.value    = mfrId || '';
        mfrSel.disabled = true;
        spFilterModelsForCreate(mfrId || '');
        document.getElementById('createSpSub').textContent = mfrName || 'Odaberite model';
    }
    function openCreateWithModel(modelId, modelName, mfrName, event) {
        if (event) event.stopPropagation();
        _openCreateSp();
        document.getElementById('createSpFreeMode').style.display  = 'none';
        document.getElementById('createSpLockedMode').style.display = 'grid';
        document.getElementById('createSpModelId').value           = modelId;
        document.getElementById('createSpMfrDisplay').textContent  = mfrName  || '';
        document.getElementById('createSpModelDisplay').textContent = modelName || '';
        document.getElementById('createSpSub').textContent          = modelName || '';
    }
    function spFilterModelsForCreate(mfrId) {
        const sel = document.getElementById('createSpModelSelect');
        if (!sel) return;
        Array.from(sel.options).forEach(function(o) {
            if (!o.value) return;
            o.hidden = mfrId ? o.dataset.mfr !== mfrId : false;
        });
        sel.value = '';
        document.getElementById('createSpModelId').value = '';
    }
    document.getElementById('btnCloseCreateSp').onclick  = () => { document.getElementById('createSpScrim').classList.remove('open'); document.getElementById('createSpModal').classList.remove('open'); };
    document.getElementById('btnCancelCreateSp').onclick = () => { document.getElementById('createSpScrim').classList.remove('open'); document.getElementById('createSpModal').classList.remove('open'); };
    document.getElementById('createSpScrim').onclick     = () => { document.getElementById('createSpScrim').classList.remove('open'); document.getElementById('createSpModal').classList.remove('open'); };
    document.getElementById('btnOpenCreate').addEventListener('click', openCreateModal);

    // ── Stock steppers ────────────────────────────────────────────────────────
    async function updateStock(id, delta) {
        const valEl   = document.getElementById('sv-'  + id);
        const valElM  = document.getElementById('svm-' + id);
        const badgeEl = document.getElementById('sb-'  + id);
        const oldStock = parseInt(valEl?.textContent ?? valElM?.textContent ?? '0');

        const resp = await fetch('/SpareParts/UpdateStock', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _spToken },
            body: JSON.stringify({ id, delta })
        });
        if (!resp.ok) return;
        const data = await resp.json();
        const s = data.stock;

        if (valEl)  valEl.textContent  = s;
        if (valElM) valElM.textContent = s;
        if (badgeEl) {
            badgeEl.className   = 'sp-badge sp-status-badge ' + (s === 0 ? 'sp-badge-out' : s <= 3 ? 'sp-badge-low' : 'sp-badge-ok');
            badgeEl.textContent = s === 0 ? 'Nema' : s <= 3 ? 'Malo' : 'Dostupno';
        }
        const row = valEl?.closest('tr');
        if (row) row.className = row.className.replace('sp-row-warn','').trim() + (s === 0 ? ' sp-row-warn' : '');
    }
    document.querySelectorAll('.sp-stock-inc').forEach(btn => btn.addEventListener('click', () => updateStock(btn.dataset.id,  1)));
    document.querySelectorAll('.sp-stock-dec').forEach(btn => btn.addEventListener('click', () => updateStock(btn.dataset.id, -1)));

    // ── Inline price edit ─────────────────────────────────────────────────────
    document.querySelectorAll('.sp-price-display').forEach(el => {
        el.addEventListener('click', function() {
            this.closest('tr').classList.add('editing-price');
            this.closest('td').querySelector('.sp-price-input').focus();
        });
    });
    async function savePrice(input) {
        const id = input.dataset.id, price = parseFloat(input.value);
        if (isNaN(price)) { input.closest('tr').classList.remove('editing-price'); return; }
        const resp = await fetch('/SpareParts/UpdatePrice', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _spToken },
            body: JSON.stringify({ id, price })
        });
        if (resp.ok) {
            const data = await resp.json();
            input.closest('td').querySelector('.sp-price-display').textContent = parseFloat(data.price).toFixed(2);
        }
        input.closest('tr').classList.remove('editing-price');
    }
    document.querySelectorAll('.sp-price-input').forEach(inp => {
        inp.addEventListener('keydown', e => { if (e.key==='Enter') savePrice(inp); if (e.key==='Escape') inp.closest('tr').classList.remove('editing-price'); });
        inp.addEventListener('blur', () => savePrice(inp));
    });
    </script>
}
