@model IEnumerable<ServiserOnline.Models.SparePart>
@{
    ViewBag.Title = "Rezervni dijelovi";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Rezervni dijelovi</h2>
    @if (ViewBag.CreateID != Guid.Empty)
    {
        @Html.ActionLink("+ Kreiraj novi", "Create", "SpareParts",
            new { SelectedProductModel = ViewBag.CreateID },
            new { @class = "btn btn-primary btn-sm" })
    }
    else
    {
        <button class="btn btn-primary btn-sm" disabled title="Odaberite model prije kreiranja">+ Kreiraj novi</button>
    }
</div>

@using (Html.BeginForm("Index", "SpareParts", FormMethod.Get))
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <label class="col-form-label">Model:</label>
        </div>
        <div class="col-auto">
            @Html.DropDownList("SelectedProductModel", null, "Svi", new { @class = "form-select form-select-sm", id = "modelFilter" })
        </div>
        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-secondary btn-sm" />
        </div>
    </div>
}

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>Model</th>
                <th>@Html.DisplayNameFor(model => model.SerialNumber)</th>
                <th>@Html.DisplayNameFor(model => model.StockAmount)</th>
                <th>@Html.DisplayNameFor(model => model.Price)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Model?.Name</td>
                    <td>@item.SerialNumber</td>
                    <td>@item.StockAmount</td>
                    <td>@item.Price</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID, SelectedProductModel = item.Model?.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID, SelectedProductModel = item.Model?.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@item.Name</strong>
                <span class="badge bg-secondary">Na stanju: @item.StockAmount</span>
            </div>
            <div class="card-body p-2">
                <div class="row g-1 mb-2">
                    <div class="col-5 text-muted small fw-semibold">Model</div>
                    <div class="col-7 small">@item.Model?.Name</div>
                    <div class="col-5 text-muted small fw-semibold">Serijski broj</div>
                    <div class="col-7 small">@item.SerialNumber</div>
                    <div class="col-5 text-muted small fw-semibold">Cijena</div>
                    <div class="col-7 small">@item.Price</div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID, SelectedProductModel = item.Model?.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Izbriši", "Delete", new { id = item.ID, SelectedProductModel = item.Model?.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('modelFilter').addEventListener('change', function () {
            const model = this.value;
            if (model)
                window.location.href = '/SpareParts?SelectedProductModel=' + model;
            else
                window.location.href = '/SpareParts';
        });
    </script>
}
