@model ServiserOnline.Models.SparePart

@{
    ViewBag.Title = "Detalji rezervnog dijela";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Detalji rezervnog dijela</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "SpareParts",
        new { SelectedProductModel = ViewBag.CreateID },
        new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-6">
        <dl class="row mb-3">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">Model</dt>
            <dd class="col-sm-8">@Model.Model?.Name</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.SerialNumber)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.SerialNumber)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StockAmount)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.StockAmount)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Price)</dd>
        </dl>

        <div class="d-flex gap-2">
            @Html.ActionLink("Izmjeni", "Edit",
                new { id = Model.ID, SelectedProductModel = ViewBag.CreateID },
                new { @class = "btn btn-outline-primary btn-sm" })
            @Html.ActionLink("← Nazad na listu", "Index", "SpareParts",
                new { SelectedProductModel = ViewBag.CreateID },
                new { @class = "btn btn-outline-secondary btn-sm" })
        </div>
    </div>
</div>
