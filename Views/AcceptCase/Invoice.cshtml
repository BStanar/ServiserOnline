@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Fakturisanje";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Fakturisanje</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)

            <dl class="row mb-4">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CaseServisNumber)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CaseServisNumber)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateTimeCaseOpened)</dt>
                <dd class="col-sm-8">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeCaseOpened))</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateTimeServiced)</dt>
                <dd class="col-sm-8">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeServiced))</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateTimeOfReport)</dt>
                <dd class="col-sm-8">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeOfReport))</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateTimePlanned)</dt>
                <dd class="col-sm-8">@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimePlanned))</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HoursOfTravel)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.HoursOfTravel)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.HoursOfWork)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.HoursOfWork)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AttendignPerson)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.AttendignPerson)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ServiceDescription)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.ServiceDescription)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.SInterventionDescription)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.SInterventionDescription)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NotFinishedDescription)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.NotFinishedDescription)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Finished)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Finished)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PaymentInstruction)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PaymentInstruction)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PayWhen)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.PayWhen)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.AcceptingDescription)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.AcceptingDescription)</dd>
            </dl>

            <div class="d-flex gap-2">
                <input type="submit" value="Fakturisano" class="btn btn-primary" />
                @Html.ActionLink("Odustani", "Index", "Cases", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>
