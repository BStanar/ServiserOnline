@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Prihvati intervenciju";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Prihvati intervenciju</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)

            <div class="mb-3">
                @Html.LabelFor(model => model.Client.Name, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Client.Name, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateTimePlanned, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.DateTimePlanned, new { htmlAttributes = new { 
                    @class = "form-control", 
                    required = "required",
                    min = DateTime.Today.ToString("yyyy-MM-dd")
                } })
                @Html.ValidationMessageFor(model => model.DateTimePlanned, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ContractNo, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.ContractNo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateTimeCaseOpened, new { @class = "form-label fw-semibold" })
                <div>@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeCaseOpened))</div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.AcceptingDescription, new { @class = "form-label fw-semibold" })
                <div class="form-control-plaintext">@Html.DisplayFor(model => model.AcceptingDescription)</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nastavak intervencije</label>
                @Html.DropDownList("ContinuedFromCase", ViewBag.ContinuedFromCase as SelectList ?? new SelectList(Enumerable.Empty<object>()), "-- Odaberi intervenciju --", new { @class = "form-select" })
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Prihvati intervenciju" class="btn btn-primary" />
                @Html.ActionLink("Odustani", "Index", "Cases", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
