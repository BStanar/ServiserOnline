@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Kreiranje izvještaja";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Kreiranje izvještaja intervencije</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-9">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)
            @Html.HiddenFor(model => model.AutoIncrement)

            <div class="mb-3">
                @Html.LabelFor(model => model.Client.Name, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Client.Name, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ContractNo, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.ContractNo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.CaseServisNumber, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.CaseServisNumber, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
                @Html.HiddenFor(model => model.CaseServisNumber)
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nastavak intervencije</label>
                @Html.DropDownList("ContinuedFromCase", ViewBag.ContinuedFromCase as SelectList ?? new SelectList(Enumerable.Empty<object>()), "-- Odaberi intervenciju --", new { @class = "form-select" })
                </div>

            @if (Model.Devices != null && Model.Devices.Any())
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Uređaji</label>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Lokacija</th>
                                    <th>Model</th>
                                    <th>Serijski broj</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Devices)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.DeviceInLocation.Location.LocationName)</td>
                                        <td>@Html.DisplayFor(modelItem => item.DeviceInLocation.Model.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.DeviceInLocation.Device.SerialNumber)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="mb-2">
                @Html.ActionLink("+ Dodaj uređaj", "AddDevice", "Cases", new { id = Model.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
            </div>

            @if (Model.SpareParts != null && Model.SpareParts.Any())
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Rezervni dijelovi</label>
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Model</th>
                                    <th>Ime</th>
                                    <th>Kataloski br.</th>
                                    <th>Kolicina</th>
                                    <th>Napomena</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.SpareParts)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.SparePart.Model.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.SparePart.Name)</td>
                                        <td>@Html.DisplayFor(modelItem => item.SparePart.SerialNumber)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                                        <td>@Html.DisplayFor(modelItem => item.Note)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <hr />

            <div class="mb-3">
                @Html.LabelFor(model => model.DateTimeServiced, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.DateTimeServiced, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DateTimeServiced, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.HoursOfTravel, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.HoursOfTravel, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HoursOfTravel, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.HoursOfWork, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.HoursOfWork, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.HoursOfWork, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Prisutna osoba</label>
                @Html.DropDownList("Attending", ViewBag.Attending as SelectList, new { @class = "form-select" })
                <div class="mt-1">
                    @Html.ActionLink("+ Novi kontakt", "Create", "ContactPersonClients", new { SelectedClient = Model.Client.ID }, new { target = "_blank", @class = "btn btn-outline-secondary btn-sm" })
                </div>
            </div>

            <hr />

            <div class="mb-3">
                @Html.LabelFor(model => model.ServiceDescription, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(model => model.ServiceDescription, new { @class = "form-control", rows = "3" })
                @Html.ValidationMessageFor(model => model.ServiceDescription, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.SInterventionDescription, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(model => model.SInterventionDescription, new { @class = "form-control", rows = "5" })
                @Html.ValidationMessageFor(model => model.SInterventionDescription, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.NotFinishedDescription, new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(model => model.NotFinishedDescription, new { @class = "form-control", rows = "3" })
                @Html.ValidationMessageFor(model => model.NotFinishedDescription, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3 form-check">
                @Html.EditorFor(model => model.Finished, new { htmlAttributes = new { @class = "form-check-input" } })
                @Html.LabelFor(model => model.Finished, new { @class = "form-check-label" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.PaymentInstruction, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.PaymentInstruction, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.PaymentInstruction, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.PayWhen, new { @class = "form-label fw-semibold" })
                <select asp-for="PayWhen" asp-items="Html.GetEnumSelectList<ServiserOnline.Models.PayWhen>()" class="form-select"></select>
                @Html.ValidationMessageFor(model => model.PayWhen, "", new { @class = "text-danger small" })
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Snimi" class="btn btn-primary" />
                @Html.ActionLink("Odustani", "Index", "Cases", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
