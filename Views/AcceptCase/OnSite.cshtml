@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "OnSite";
}

<h2>Kreiranje izvještaja intervencije</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">

    @Html.ActionLink("Dodaj Uredjaj", "AddDevice", "Cases", new { id = Model.ID }, null)
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ID)
    @Html.HiddenFor(model => model.AutoIncrement)
    <div class="form-group">
        @Html.LabelFor(model => model.Client.Name, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.Client.Name, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
            @Html.ValidationMessageFor(model => model.Client.Name, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ContractNo, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.ContractNo, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.CaseServisNumber, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.CaseServisNumber, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.CaseServisNumber, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ContinuedFromCase, "Nastavak intervencije", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ContinuedFromCase, ViewBag.ContinuedFromCase as SelectList, "-- Odaberi intervenciju --", new { @class = "form-control" })
            @*@Html.DropDownList("ContinuedFromCase", String.Empty)*@
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.Devices, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <table class="table">
                @if (Model.Devices != null)
                {
                    <tr>
                        <th>
                            Lokacija
                        </th>
                        <th>
                            Model
                        </th>
                        <th>
                            Serijski broj
                        </th>
                    </tr>
                    foreach (var item in Model.Devices)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Location.LocationName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Model.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Device.SerialNumber)
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.SpareParts, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <table class="table">
                @if (Model.SpareParts != null)
                {
                    <tr>
                        <th>
                            Model
                        </th>
                        <th>
                            Ime
                        </th>
                        <th>
                            Broj
                        </th>
                        <th>
                            Količina
                        </th>
                        <th>
                            Nepomena
                        </th>
                    </tr>

                    foreach (var item in Model.SpareParts)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.SparePart.Model.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SparePart.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.SparePart.SerialNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Amount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Note)
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.DateTimeServiced, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DateTimeServiced, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DateTimeServiced, "", new { @class = "text-danger" })
        </div>
    </div>
    <hr />
    <div class="form-group">
        @Html.LabelFor(model => model.HoursOfTravel, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HoursOfTravel, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HoursOfTravel, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.HoursOfWork, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.HoursOfWork, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.HoursOfWork, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-2" for="ManufacturerID">Prisutna osoba</label>
        <div class="col-md-10">
            @Html.DropDownList("Attending", String.Empty)
        </div>
    </div>
    <div class="form-group">
        <label class="control-label col-md-2" for="ManufacturerID"></label>
        <div class="col-md-10">
            @Html.ActionLink("Novi kontakt", "Create", "ContactPersonClients", new { SelectedClient = Model.Client.ID }, new { target = "_blank" })
        </div>
    </div>

    <hr />
    <div class="form-group">
        @Html.LabelFor(model => model.ServiceDescription, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.ServiceDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.ServiceDescription, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.SInterventionDescription, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.SInterventionDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.SInterventionDescription, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.NotFinishedDescription, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.NotFinishedDescription, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.NotFinishedDescription, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.Finished, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                @Html.EditorFor(model => model.Finished)
                @Html.ValidationMessageFor(model => model.Finished, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.PaymentInstruction, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.PaymentInstruction, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.PaymentInstruction, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.PayWhen, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
                <select asp-for="PayWhen" asp-items="Html.GetEnumSelectList<ServiserOnline.Models.PayWhen>()" class="form-control"></select>
            @Html.ValidationMessageFor(model => model.PayWhen, "", new { @class = "text-danger" })
        </div>
    </div>



    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Snimi" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Nazad na Listu", "Index")
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
