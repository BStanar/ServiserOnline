@model ServiserOnline.Models.GroupRowViewModel

<tr class="sp-mfr-row"
    onclick="toggleGroup('@Model.GroupKey')">
    <td colspan="@Model.Colspan">
        <div class="sp-group-row-inner">
            <div class="sp-group-row-main">
                <span class="sp-mfr-arrow" id="arrow-@Model.GroupKey">
                    <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6l5 5 5-5" />
                    </svg>
                </span>

                <span class="sp-mfr-tag">@Model.Title</span>

                @if (!string.IsNullOrWhiteSpace(Model.Meta))
                {
                    <span class="sp-mfr-count">@Model.Meta</span>
                }
            </div>

            <div class="sp-group-row-actions" onclick="event.stopPropagation();">
                @if (!string.IsNullOrWhiteSpace(Model.AddButtonText))
                {
                    if (!string.IsNullOrWhiteSpace(Model.AddButtonDataAction))
                    {
                        <button type="button"
                                class="sp-btn sp-btn-xs sp-btn-ghost"
                                data-action="@Model.AddButtonDataAction"
                                data-json="@Model.AddButtonDataJson"
                                onclick="handleActionMenuItem(this, event)">
                            @Model.AddButtonText
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="sp-btn sp-btn-xs sp-btn-ghost"
                                onclick="@Model.AddButtonOnClick">
                            @Model.AddButtonText
                        </button>
                    }
                }

                @if (Model.MenuItems != null && Model.MenuItems.Any())
                {
                    <partial name="ActionMenu" model="Model.MenuItems" />
                }
            </div>
        </div>
    </td>
</tr>