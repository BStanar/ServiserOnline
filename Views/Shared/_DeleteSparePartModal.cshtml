@* Views/Shared/_DeleteSparePartModal.cshtml
   JS: spare-part-modals.js
*@

<div class="sp-modal-scrim" id="deleteSpScrim"></div>
<div class="sp-modal sp-modal-sm sp-modal-danger" id="deleteSpModal">
    <form method="post" id="deleteSpForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deleteSpId" />
        <div class="sp-modal-head">
            <div style="display:flex;gap:10px;align-items:flex-start;">
                <div class="sp-danger-icon">!</div>
                <div>
                    <div class="sp-modal-title">Izbriši rezervni dio</div>
                    <div class="sp-modal-sub">
                        <b id="deleteSpName"></b>
                        <span class="sp-mono" id="deleteSpSku" style="color:var(--muted);margin-left:4px;"></span>
                    </div>
                </div>
            </div>
            <button type="button" class="sp-iconbtn" id="btnCloseDeleteSp">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                    <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
                </svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <p class="sp-muted" style="margin:14px 0 12px;">Brisanje je trajno i ne može se poništiti.</p>
            <label class="sp-confirm">
                <input type="checkbox" id="deleteSpConfirm" />
                <span>Razumijem da je ovo trajna radnja.</span>
            </label>
        </div>
        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" id="btnCancelDeleteSp">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-danger" id="btnConfirmDeleteSp" disabled>Izbriši</button>
        </div>
    </form>
</div>
