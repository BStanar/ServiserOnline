@* Views/Shared/_EditDilModal.cshtml *@

<div class="sp-modal-scrim" id="editDilScrim"></div>
<div class="sp-modal sp-modal-md" id="editDilModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Izmjeni assignment uređaja</div>
                <div class="sp-modal-sub" id="editDilSub"></div>
            </div>
            <button type="button" class="sp-iconbtn" id="btnCloseEditDil">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                    <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
                </svg>
            </button>
        </div>
        <form method="post" action="/DeviceInLocations/Edit" id="editDilForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ID" id="editDilId" />
            <input type="hidden" name="SelectedClientID" id="editDilClientId" />
            <div class="sp-modal-body">
                <div class="sp-formgrid">
                    <label class="sp-field sp-col-2">
                        <span class="sp-label">Lokacija <span class="cl-required">*</span></span>
                        <select class="sp-input" name="LocationID" id="editDilLocation" required>
                            <option value="">Učitavanje…</option>
                        </select>
                    </label>
                    <label class="sp-field">
                        <span class="sp-label">Proizvođač <span class="cl-required">*</span></span>
                        <select class="sp-input" name="Manufacturer" id="editDilManufacturer" required>
                            <option value="">Učitavanje…</option>
                        </select>
                    </label>
                    <label class="sp-field">
                        <span class="sp-label">Model <span class="cl-required">*</span></span>
                        <select class="sp-input" name="Model" id="editDilModel" required disabled>
                            <option value="">Prvo odaberite proizvođača…</option>
                        </select>
                    </label>
                    <label class="sp-field sp-col-2">
                        <span class="sp-label">Uređaj <span class="cl-required">*</span></span>
                        <select class="sp-input" name="Device" id="editDilDevice" required disabled>
                            <option value="">Prvo odaberite model…</option>
                        </select>
                    </label>
                    <label class="sp-field">
                        <span class="sp-label">Datum instalacije</span>
                        <input class="sp-input sp-mono" type="date" name="DateOfInstalation" id="editDilInstallDate" />
                    </label>
                    <label class="sp-field">
                        <span class="sp-label">Garancija do</span>
                        <input class="sp-input sp-mono" type="date" name="DateOfGuarantieEnd" id="editDilGuaranteeDate" />
                    </label>
                    <label class="sp-field sp-col-2">
                        <span class="sp-label">Komentar</span>
                        <textarea class="sp-input" name="DeviceInLocationDescription" id="editDilDescription" rows="3"></textarea>
                    </label>
                    <div class="sp-col-2 cl-inline-error" id="editDilError" style="display:none;"></div>
                </div>
            </div>
            <div class="sp-modal-foot">
                <span class="sp-meta">Lokacija i uređaj su obavezni</span>
                <div style="display:flex;gap:8px;">
                    <button type="button" class="sp-btn sp-btn-ghost" id="btnCancelEditDil">Odustani</button>
                    <button type="submit" class="sp-btn sp-btn-primary" id="btnSaveEditDil">Sačuvaj</button>
                </div>
            </div>
        </form>
    </div>
</div>
