@model IEnumerable<ServiserOnline.Models.ProductModel>

@{
    ViewBag.Title = "Modeli uredjaja";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Modeli uredjaja</h2>
    @if (ViewBag.CreateID != Guid.Empty)
    {
        @Html.ActionLink("+ Kreiraj novi", "Create", "ProductModels",
            new { SelectedManufacturer = ViewBag.CreateID },
            new { @class = "btn btn-primary btn-sm" })
    }
    else
    {
        <button class="btn btn-primary btn-sm" disabled title="Odaberite proizvođača prije kreiranja">+ Kreiraj novi</button>
    }
</div>

@using (Html.BeginForm("Index", "ProductModels", FormMethod.Get))
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <label class="col-form-label">Proizvođač:</label>
        </div>
        <div class="col-auto">
            @Html.DropDownList("SelectedManufacturer", null, "Svi", new { @class = "form-select form-select-sm", id = "manufacturerFilter" })
        </div>
        <div class="col-auto">
            @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control form-control-sm", placeholder = "Pretraži naziv / opis..." })
        </div>
        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-secondary btn-sm" />
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.CurrentFilter as string))
        {
            <div class="col-auto">
                @Html.ActionLink("Očisti", "Index", "ProductModels",
                    new { SelectedManufacturer = ViewBag.CreateID != Guid.Empty ? (Guid?)ViewBag.CreateID : null },
                    new { @class = "btn btn-outline-secondary btn-sm" })
            </div>
        }
    </div>
}

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover table-bordered align-middle" id="modelsTable">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>Proizvođač</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                <th class="text-center">Uređaji</th>
                <th class="text-center">Rezervni dijelovi</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Manufacturer?.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <span title="@item.Description">
                                @(item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                            </span>
                        }
                    </td>
                    <td class="text-center">
                        @Html.ActionLink(item.DeviceNo.ToString(), "Index", "Devices",
                            new { SelectedProductModel = item.ID },
                            new { @class = item.DeviceNo > 0 ? "badge bg-primary text-decoration-none" : "badge bg-secondary text-decoration-none" })
                    </td>
                    <td class="text-center">
                        @Html.ActionLink((item.SpareParts?.Count ?? 0).ToString(), "Index", "SpareParts",
                            new { SelectedProductModel = item.ID },
                            new { @class = (item.SpareParts?.Count ?? 0) > 0 ? "badge bg-primary text-decoration-none" : "badge bg-secondary text-decoration-none" })
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID, SelectedManufacturer = item.Manufacturer?.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID, SelectedManufacturer = item.Manufacturer?.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@item.Name</strong>
                <span class="badge bg-secondary">@item.Manufacturer?.Name</span>
            </div>
            <div class="card-body p-2">
                <div class="d-flex gap-2 mb-2">
                    @Html.ActionLink($"Uređaji: {item.DeviceNo}", "Index", "Devices",
                        new { SelectedProductModel = item.ID },
                        new { @class = "badge bg-primary text-decoration-none" })
                    @Html.ActionLink($"Rez. dijelovi: {item.SpareParts?.Count ?? 0}", "Index", "SpareParts",
                        new { SelectedProductModel = item.ID },
                        new { @class = "badge bg-primary text-decoration-none" })
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID, SelectedManufacturer = item.Manufacturer?.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Izbriši", "Delete", new { id = item.ID, SelectedManufacturer = item.Manufacturer?.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-3">
    @Html.ActionLink("← Lista proizvođača", "Index", "Manufacturers", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

@section Scripts {
    <script>
        document.getElementById('manufacturerFilter').addEventListener('change', function () {
            const mfr = this.value;
            const search = document.querySelector('input[name="searchString"]')?.value ?? '';
            const params = [];
            if (mfr) params.push('SelectedManufacturer=' + mfr);
            if (search) params.push('searchString=' + encodeURIComponent(search));
            window.location.href = '/ProductModels' + (params.length ? '?' + params.join('&') : '');
        });
    </script>
}
