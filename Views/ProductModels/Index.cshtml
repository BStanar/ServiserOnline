@model IEnumerable<ServiserOnline.Models.ProductModel>

@{
    ViewBag.Title = "Modeli uredjaja";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Modeli uredjaja</h2>
    @if (ViewBag.CreateID != Guid.Empty)
    {
        @Html.ActionLink("+ Kreiraj novi", "Create", "ProductModels",
            new { SelectedManufacturer = ViewBag.CreateID },
            new { @class = "btn btn-primary btn-sm" })
    }
    else
    {
        <button class="btn btn-primary btn-sm" disabled title="Odaberite proizvođača prije kreiranja">+ Kreiraj novi</button>
    }
</div>

@using (Html.BeginForm("Index", "ProductModels", FormMethod.Get))
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <label class="col-form-label">Proizvođač:</label>
        </div>
        <div class="col-auto">
            @Html.DropDownList("SelectedManufacturer", null, "Svi", new { @class = "form-select form-select-sm", id = "manufacturerFilter" })
        </div>
        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-secondary btn-sm" />
        </div>
    </div>
}

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover table-bordered align-middle" id="modelsTable">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>Broj uredjaja</th>
                <th>@Html.DisplayNameFor(model => model.Description)</th>
                <th>@Html.DisplayNameFor(model => model.Manufacturer)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.DeviceNo</td>
                    <td>@item.Description</td>
                    <td>@item.Manufacturer?.Name</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @Html.ActionLink("Uređaji", "Index", "Devices", new { SelectedProductModel = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                            @Html.ActionLink("Rezervni dijelovi", "Index", "SpareParts", new { SelectedProductModel = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                            @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID, SelectedManufacturer = ViewBag.CreateID }, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID, SelectedManufacturer = ViewBag.CreateID }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@item.Name</strong>
                <span class="badge bg-secondary">@item.Manufacturer?.Name</span>
            </div>
            <div class="card-body p-2">
                <div class="row g-1 mb-2">
                    <div class="col-5 text-muted small fw-semibold">Broj uredjaja</div>
                    <div class="col-7 small">@item.DeviceNo</div>
                    <div class="col-5 text-muted small fw-semibold">Opis</div>
                    <div class="col-7 small">@item.Description</div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @Html.ActionLink("Uređaji", "Index", "Devices", new { SelectedProductModel = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    @Html.ActionLink("Rezervni dijelovi", "Index", "SpareParts", new { SelectedProductModel = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID, SelectedManufacturer = ViewBag.CreateID }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Izbriši", "Delete", new { id = item.ID, SelectedManufacturer = ViewBag.CreateID }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-3">
    @Html.ActionLink("← Lista proizvođača", "Index", "Manufacturers", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

@section Scripts {
    <script>
        document.getElementById('manufacturerFilter').addEventListener('change', function () {
            const id = this.value;
            if (id)
                window.location.href = '/ProductModels?SelectedManufacturer=' + id;
            else
                window.location.href = '/ProductModels';
        });
    </script>
}
