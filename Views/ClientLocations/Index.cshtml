@using System.Text.Json
@using ServiserOnline.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq
@model IEnumerable<ServiserOnline.Models.ClientLocation>

@{
    ViewBag.Title = "Korisničke lokacije";

    var byClient = Model
        .GroupBy(l => new { Id = l.Client?.ID, Name = l.Client?.Name ?? "—" })
        .OrderBy(g => g.Key.Name)
        .ToList();

    int totalLocations = Model.Count();
    int totalClients = byClient.Count;
    string? search = ViewBag.CurrentFilter as string;
    var selectedClientId = ViewBag.CreateID is Guid g ? g : Guid.Empty;

    var devicesByLocation =
        ViewBag.DevicesByLocation as Dictionary<Guid, List<ServiserOnline.Models.DeviceInLocation>>
        ?? new Dictionary<Guid, List<ServiserOnline.Models.DeviceInLocation>>();

    Func<Guid, List<ServiserOnline.Models.DeviceInLocation>> getDevicesForLocation = id =>
        devicesByLocation.TryGetValue(id, out var list)
            ? list
            : new List<ServiserOnline.Models.DeviceInLocation>();

    int totalDevices = devicesByLocation.Values.Sum(v => v.Count);

    var clientOptions = ((IEnumerable<SelectListItem>)(ViewBag.ClientID ?? ViewBag.SelectedClient ?? Enumerable.Empty<SelectListItem>())).ToList();
    var manufacturerOptions = ((IEnumerable<SelectListItem>)(ViewBag.Manufacturer ?? Enumerable.Empty<SelectListItem>())).ToList();

    // Build action menus once - referenced in both table and card list
    var locationMenus = new Dictionary<Guid, List<ActionMenuItem>>();
    var deviceMenus = new Dictionary<Guid, List<ActionMenuItem>>();

    foreach (var loc in Model)
    {
        var devices = getDevicesForLocation(loc.ID);

        locationMenus[loc.ID] = new List<ActionMenuItem>
        {
            new ActionMenuItem
            {
                Text = "Opis",
                DataAction = "open-details",
                DataJson = JsonSerializer.Serialize(new {
                    id           = loc.ID,
                    clientId     = loc.Client?.ID,

                    // Both naming styles are intentionally included.
                    // client-locations.js accepts either style, and this keeps the shared ActionMenu reusable.
                    locationName = loc.LocationName,
                    location     = loc.LocationName,
                    name         = loc.LocationName,
                    clientName   = loc.Client?.Name,
                    client       = loc.Client?.Name,

                    city         = loc.City,
                    address      = loc.Address,
                    postCode     = loc.PostCode,
                    tel1         = loc.Telephone1,
                    tel2         = loc.Telephone2,
                    description  = loc.Description,
                    deviceCount  = devices.Count
                })
            },
            new ActionMenuItem
            {
                Text = "Izmjeni",
                DataAction = "edit-location",
                DataJson = JsonSerializer.Serialize(new {
                    id          = loc.ID,
                    clientId    = loc.Client?.ID,
                    name        = loc.LocationName,
                    city        = loc.City,
                    address     = loc.Address,
                    postCode    = loc.PostCode,
                    tel1        = loc.Telephone1,
                    tel2        = loc.Telephone2,
                    description = loc.Description
                })
            },
            new ActionMenuItem
            {
                Text = "Izbriši",
                Variant = "danger",
                DataAction = "delete-location",
                DataJson = JsonSerializer.Serialize(new {
                    id       = loc.ID,
                    name     = loc.LocationName,
                    clientId = loc.Client?.ID
                })
            }
        };

        foreach (var d in devices)
        {
            deviceMenus[d.ID] = new List<ActionMenuItem>
            {
                new ActionMenuItem
                {
                    Text = "Historija servisa",
                    Url  = Url.Action("ServiceHistory", "Devices", new { id = d.Device?.ID })
                },
                new ActionMenuItem
                {
                    Text = "Izmjeni assignment",
                    Url  = Url.Action("Edit", "DeviceInLocations", new { id = d.ID, SelectedClient = loc.Client?.ID })
                },
                new ActionMenuItem
                {
                    Text = "Izbriši",
                    Variant = "danger",
                    DataAction = "delete-device",
                    DataJson = JsonSerializer.Serialize(new {
                        id       = d.ID,
                        serial   = d.Device?.SerialNumber,
                        clientId = loc.Client?.ID
                    })
                }
            };
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/sp-styles.css" asp-append-version="true" />

    <style>
        .client-locations-page .sp-table { table-layout: fixed; }
        .client-locations-page .sp-more-menu { z-index: 5000; }
        .client-locations-page .cl-device-serial { font-family: var(--mono); font-size: 12.5px; font-weight: 600; }
        .client-locations-page .cl-device-meta { color: var(--muted); font-size: 12px; margin-top: 2px; }
        .client-locations-page .cl-modal-wrap { width: 100%; display: flex; flex-direction: column; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); background: var(--surface); }
        .client-locations-page .cl-dl { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 10px 14px; font-size: 13px; }
        .client-locations-page .cl-dl-label { color: var(--muted); font-weight: 500; }
        .client-locations-page .cl-dl-value { color: var(--text); min-width: 0; overflow-wrap: anywhere; }
        .client-locations-page .cl-required { color: var(--danger); }
        .client-locations-page .cl-inline-error { display: none; color: var(--danger); font-size: 12.5px; }

        @@media (max-width: 900px) {
            .client-locations-page .cl-dl { grid-template-columns: 1fr; gap: 4px 0; }
            .client-locations-page .cl-dl-label { margin-top: 8px; font-size: 11.5px; }
        }
    </style>
}

<div class="sp-page-wrap client-locations-page">
    @await Html.PartialAsync("_Header", new HeaderViewModel
    {
        Title = "Korisničke lokacije",
        RowCount = totalLocations,
        MetaText = $"{totalLocations} lokacija · {totalClients} korisnika · {totalDevices} uređaja",
        CriticalText = null,

        SearchPlaceholder = "Pretraži korisnika, lokaciju ili grad...",
        SearchValue = search,
        SearchName = "searchString",

        AddButtonText = "+ Dodaj novu lokaciju",
        AddButtonId = "btnOpenCreate",
        AddButtonOnClick = "openCreateLocationFromHeader()",
        ShowAddButton = true,

        ShowDropdownFilter = true,
        DropdownName = "SelectedClient",
        DropdownLabel = "Korisnik: svi",
        DropdownItems = clientOptions,

        FormAction = "Index",
        FormController = "ClientLocations",

        HiddenFields = new Dictionary<string, string>(),

        FilterButtons = (!string.IsNullOrWhiteSpace(search) || selectedClientId != Guid.Empty)
            ? new List<FilterButton>
            {
                new FilterButton
                {
                    Text = "Očisti filter",
                    Badge = null,
                    Active = false,
                    Variant = "danger",
                    Url = Url.Action("Index", "ClientLocations")
                }
            }
            : new List<FilterButton>()
    })

    @if (!Model.Any())
    {
        <div class="sp-empty-state" style="text-align:center;padding:60px 20px;color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;opacity:.5;">
                <path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
            <p style="font-size:14px;margin:0 0 6px 0;">Nema lokacija za prikaz.</p>
            <a href="/ClientLocations" class="sp-btn sp-btn-ghost sp-btn-sm" style="margin-top:8px;">Očisti filtere</a>
        </div>
    }
    else
    {
        <div class="sp-tablewrap">
            <table class="sp-table" id="clientLocationsTable">
                <thead>
                    <tr>
                        <th style="width:30%">Lokacija / uređaj</th>
                        <th style="width:23%">Korisnik</th>
                        <th style="width:15%">Grad</th>
                        <th style="width:12%">Instalacija</th>
                        <th style="width:12%">Garancija</th>
                        <th style="width:8%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clientGroup in byClient)
                    {
                        var clientKey = "client-" + (clientGroup.Key.Id?.ToString("N") ?? "none");
                        var clientDeviceCount = clientGroup.Sum(l => getDevicesForLocation(l.ID).Count);

                        <partial name="GroupRow" model='new GroupRowViewModel
                        {
                            GroupKey = clientKey,
                            Title = clientGroup.Key.Name,
                            Meta = $"{clientGroup.Count()} lokacija · {clientDeviceCount} uređaja",
                            Colspan = 6,
                            AddButtonText = clientGroup.Key.Id.HasValue ? "+ Dodaj lokaciju" : null,
                            AddButtonDataAction = clientGroup.Key.Id.HasValue ? "create-location" : null,
                            AddButtonDataJson = clientGroup.Key.Id.HasValue
                                ? JsonSerializer.Serialize(new { clientId = clientGroup.Key.Id, clientName = clientGroup.Key.Name })
                                : null
                        }' />

                        foreach (var loc in clientGroup.OrderBy(l => l.LocationName))
                        {
                            var locationKey = "loc-" + loc.ID.ToString("N");
                            var devices = getDevicesForLocation(loc.ID)
                                .OrderBy(d => d.Model?.Name)
                                .ThenBy(d => d.Device?.SerialNumber)
                                .ToList();

                            <partial name="ChildGroupRow" model='new ChildGroupRowViewModel
                            {
                                ParentGroupKey = clientKey,
                                GroupKey = locationKey,
                                Title = loc.LocationName,
                                Meta = $"{loc.City} · {devices.Count} uređaja",
                                Colspan = 6,
                                AddButtonText = "+ Dodaj uređaj",
                                AddButtonDataAction = "add-device",
                                AddButtonDataJson = JsonSerializer.Serialize(new { locationId = loc.ID, clientId = loc.Client!.ID, locationName = loc.LocationName }),
                                MenuItems = locationMenus[loc.ID]
                            }' />

                            if (devices.Any())
                            {
                                foreach (var d in devices)
                                {
                                    <tr class="sp-data-row cl-device-row group-@clientKey group-model-@locationKey">
                                        <td>
                                            <div class="cl-device-serial">@d.Device?.SerialNumber</div>
                                            <div class="cl-device-meta">@(d.Manufacturer?.Name) @(d.Model?.Name != null ? "› " + d.Model.Name : "")</div>
                                        </td>
                                        <td>@loc.Client?.Name</td>
                                        <td>@loc.City</td>
                                        <td><span class="sp-mono">@d.DateOfInstalation.ToString("dd.MM.yyyy")</span></td>
                                        <td><span class="sp-mono">@d.DateOfGuarantieEnd.ToString("dd.MM.yyyy")</span></td>
                                        <td onclick="event.stopPropagation();">
                                            <partial name="ActionMenu" model="deviceMenus[d.ID]" />
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="sp-data-row group-@clientKey group-model-@locationKey">
                                    <td colspan="6" class="cl-device-empty">Nema uređaja na ovoj lokaciji.</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="sp-card-list">
            @foreach (var clientGroup in byClient)
            {
                var sections = new List<CardSectionViewModel>();

                foreach (var loc in clientGroup.OrderBy(l => l.LocationName))
                {
                    var devices = getDevicesForLocation(loc.ID)
                        .OrderBy(d => d.Model?.Name)
                        .ThenBy(d => d.Device?.SerialNumber)
                        .ToList();

                    sections.Add(new CardSectionViewModel
                    {
                        Title = loc.LocationName,
                        Meta = $"{loc.City} · {devices.Count} uređaja",
                        AddButtonText = "+ Dodaj uređaj",
                        AddButtonDataAction = "add-device",
                        AddButtonDataJson = JsonSerializer.Serialize(new { locationId = loc.ID, clientId = loc.Client?.ID, locationName = loc.LocationName }),
                        MenuItems = locationMenus[loc.ID],
                        EmptyText = "Nema uređaja na ovoj lokaciji.",
                        Items = devices.Select(d => new CardItemViewModel
                        {
                            Title = d.Device?.SerialNumber ?? "—",
                            Subtitle = $"{d.Manufacturer?.Name} › {d.Model?.Name}",
                            MetaLeft = $"Instalacija: {d.DateOfInstalation:dd.MM.yyyy}",
                            MetaRight = $"Garancija: {d.DateOfGuarantieEnd:dd.MM.yyyy}",
                            BadgeText = "Uređaj",
                            BadgeClass = "sp-badge-ok",
                            MenuItems = deviceMenus.TryGetValue(d.ID, out var dm) ? dm : new()
                        }).ToList()
                    });
                }

                <partial name="CardGroup" model='new CardGroupViewModel
                {
                    Title = clientGroup.Key.Name,
                    Meta = $"{clientGroup.Count()} lokacija · {clientGroup.Sum(l => getDevicesForLocation(l.ID).Count)} uređaja",
                    AddButtonText = clientGroup.Key.Id.HasValue ? "+ Dodaj lokaciju" : null,
                    AddButtonDataAction = clientGroup.Key.Id.HasValue ? "create-location" : null,
                    AddButtonDataJson = clientGroup.Key.Id.HasValue
                        ? JsonSerializer.Serialize(new { clientId = clientGroup.Key.Id, clientName = clientGroup.Key.Name })
                        : null,
                    Sections = sections
                }' />
            }
        </div>
    }

    <div style="margin-top:16px;">
        @Html.ActionLink("← Lista korisnika", "Index", "Clients", new { }, new { @class = "sp-btn sp-btn-ghost sp-btn-sm" })
    </div>
</div>

<!-- ========== Modal: Location details ========== -->
<div class="sp-modal-scrim" id="detailsScrim"></div>
<div class="sp-modal sp-modal-md" id="detailsModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Opis lokacije</div>
                <div class="sp-modal-sub" id="detailsLocationName">Pregled podataka lokacije</div>
            </div>

            <button type="button" class="sp-iconbtn" id="btnCloseDetails">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                    <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
                </svg>
            </button>
        </div>

        <div class="sp-modal-body">
            <div class="sp-formgrid">
                <label class="sp-field sp-col-2">
                    <span class="sp-label">Korisnik</span>
                    <div class="sp-field-display" id="detailsClient"></div>
                </label>

                <label class="sp-field sp-col-2">
                    <span class="sp-label">Naziv lokacije</span>
                    <div class="sp-field-display" id="detailsLocation"></div>
                </label>

                <label class="sp-field">
                    <span class="sp-label">Grad</span>
                    <div class="sp-field-display" id="detailsCity"></div>
                </label>

                <label class="sp-field">
                    <span class="sp-label">Broj uređaja</span>
                    <div class="sp-field-display sp-mono" id="detailsDeviceCount"></div>
                </label>

                <label class="sp-field sp-col-2">
                    <span class="sp-label">Adresa</span>
                    <div class="sp-field-display" id="detailsAddress"></div>
                </label>

                <label class="sp-field sp-col-2">
                    <span class="sp-label">Telefon</span>
                    <div class="sp-field-display" id="detailsPhone"></div>
                </label>

                <label class="sp-field sp-col-2">
                    <span class="sp-label">Opis</span>
                    <div class="sp-field-display cl-details-description" id="detailsDescription"></div>
                </label>
            </div>
        </div>

        <div class="sp-modal-foot">
            <span class="sp-meta">Pregled lokacije</span>

            <div style="display:flex;gap:8px;">
                <button type="button" class="sp-btn sp-btn-ghost" id="btnCloseDetails2">Zatvori</button>
            </div>
        </div>
    </div>
</div>
<!-- ========== Modal: Create location ========== -->
<div class="sp-modal-scrim" id="createLocationScrim"></div>
<div class="sp-modal sp-modal-md" id="createLocationModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Kreiraj lokaciju</div>
                <div class="sp-modal-sub" id="createLocationSub">Odaberite korisnika</div>
            </div>
            <button type="button" class="sp-iconbtn" id="btnCloseCreateLocation"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg></button>
        </div>
        <form method="post" action="@Url.Action("Create", "ClientLocations")" id="createLocationForm">
            @Html.AntiForgeryToken()
            <div class="sp-modal-body">
                <div class="sp-formgrid">
                    <label class="sp-field sp-col-2">
                        <span class="sp-label">Korisnik <span class="cl-required">*</span></span>
                        <select class="sp-input" name="ClientID" id="createClientId" required onchange="document.getElementById('createLocationSub').textContent=this.options[this.selectedIndex]?.text||'Odaberite korisnika';">
                            <option value="">Odaberite korisnika…</option>
                            @foreach (var c in clientOptions)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>
                    </label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Naziv lokacije <span class="cl-required">*</span></span><input class="sp-input" name="LocationName" id="createLocationName" required /></label>
                    <label class="sp-field"><span class="sp-label">Grad</span><input class="sp-input" name="City" id="createCity" /></label>
                    <label class="sp-field"><span class="sp-label">Poštanski broj</span><input class="sp-input" name="PostCode" id="createPostCode" /></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Adresa</span><input class="sp-input" name="Address" id="createAddress" /></label>
                    <label class="sp-field"><span class="sp-label">Telefon 1</span><input class="sp-input" name="Telephone1" id="createTelephone1" /></label>
                    <label class="sp-field"><span class="sp-label">Telefon 2</span><input class="sp-input" name="Telephone2" id="createTelephone2" /></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Opis</span><textarea class="sp-input" name="Description" id="createDescription" rows="3"></textarea></label>
                    <input type="hidden" name="searchString" value="@search" />
                </div>
            </div>
            <div class="sp-modal-foot">
                <span class="sp-meta">Korisnik i naziv lokacije su obavezni</span>
                <div style="display:flex;gap:8px;"><button type="button" class="sp-btn sp-btn-ghost" id="btnCancelCreateLocation">Odustani</button><button type="submit" class="sp-btn sp-btn-primary">Kreiraj</button></div>
            </div>
        </form>
    </div>
</div>

<!-- ========== Modal: Edit location ========== -->
<div class="sp-modal-scrim" id="editLocationScrim"></div>
<div class="sp-modal sp-modal-md" id="editLocationModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head">
            <div><div class="sp-modal-title">Izmjeni lokaciju</div><div class="sp-modal-sub" id="editLocationSub"></div></div>
            <button type="button" class="sp-iconbtn" id="btnCloseEditLocation"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg></button>
        </div>
        <form method="post" id="editLocationForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ID" id="editLocationId" />
            <div class="sp-modal-body">
                <div class="sp-formgrid">
                    <label class="sp-field sp-col-2"><span class="sp-label">Korisnik <span class="cl-required">*</span></span><select class="sp-input" name="ClientID" id="editClientId" required><option value="">Odaberite korisnika…</option>@foreach (var c in clientOptions){<option value="@c.Value">@c.Text</option>}</select></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Naziv lokacije <span class="cl-required">*</span></span><input class="sp-input" name="LocationName" id="editLocationName" required /></label>
                    <label class="sp-field"><span class="sp-label">Grad</span><input class="sp-input" name="City" id="editCity" /></label>
                    <label class="sp-field"><span class="sp-label">Poštanski broj</span><input class="sp-input" name="PostCode" id="editPostCode" /></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Adresa</span><input class="sp-input" name="Address" id="editAddress" /></label>
                    <label class="sp-field"><span class="sp-label">Telefon 1</span><input class="sp-input" name="Telephone1" id="editTelephone1" /></label>
                    <label class="sp-field"><span class="sp-label">Telefon 2</span><input class="sp-input" name="Telephone2" id="editTelephone2" /></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Opis</span><textarea class="sp-input" name="Description" id="editDescription" rows="3"></textarea></label>
                    <input type="hidden" name="searchString" value="@search" />
                </div>
            </div>
            <div class="sp-modal-foot"><button type="button" class="sp-btn sp-btn-ghost" id="btnCancelEditLocation">Odustani</button><button type="submit" class="sp-btn sp-btn-primary">Sačuvaj</button></div>
        </form>
    </div>
</div>

<!-- ========== Modal: Add device to location ========== -->
<div class="sp-modal-scrim" id="addDeviceScrim"></div>
<div class="sp-modal sp-modal-md" id="addDeviceModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head">
            <div><div class="sp-modal-title">Dodaj uređaj na lokaciju</div><div class="sp-modal-sub" id="addDeviceSub"></div></div>
            <button type="button" class="sp-iconbtn" id="btnCloseAddDevice"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg></button>
        </div>
        <form method="post" action="@Url.Action("Create", "DeviceInLocations")" id="addDeviceForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="LocationID" id="addDeviceLocationId" />
            <input type="hidden" name="SelectedClientID" id="addDeviceClientId" />
            <div class="sp-modal-body">
                <div class="sp-formgrid">
                    <label class="sp-field"><span class="sp-label">Proizvođač <span class="cl-required">*</span></span><select class="sp-input" name="Manufacturer" id="addManufacturer" required><option value="">Odaberite proizvođača…</option>@foreach (var m in manufacturerOptions){<option value="@m.Value">@m.Text</option>}</select></label>
                    <label class="sp-field"><span class="sp-label">Model <span class="cl-required">*</span></span><select class="sp-input" name="Model" id="addModel" required disabled><option value="">Prvo odaberite proizvođača…</option></select></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Uređaj <span class="cl-required">*</span></span><div style="display:flex;gap:8px;align-items:center;min-width:0;"><select class="sp-input" name="Device" id="addDevice" required disabled style="flex:1;min-width:0;"><option value="">Prvo odaberite model…</option></select><button type="button" class="sp-btn sp-btn-xs sp-btn-ghost" id="btnAddNewDeviceFromLocation" style="white-space:nowrap;" disabled>+ Novi uređaj</button></div></label>
                    <label class="sp-field"><span class="sp-label">Datum instalacije</span><input class="sp-input sp-mono" type="date" name="DateOfInstalation" id="addInstallDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></label>
                    <label class="sp-field"><span class="sp-label">Garancija do</span><input class="sp-input sp-mono" type="date" name="DateOfGuarantieEnd" id="addGuaranteeDate" value="@DateTime.Now.AddYears(2).ToString("yyyy-MM-dd")" /></label>
                    <label class="sp-field sp-col-2"><span class="sp-label">Komentar</span><textarea class="sp-input" name="DeviceInLocationDescription" id="addDeviceDescription" rows="3"></textarea></label>
                </div>
            </div>
            <div class="sp-modal-foot"><span class="sp-meta">Proizvođač, model i uređaj su obavezni</span><div style="display:flex;gap:8px;"><button type="button" class="sp-btn sp-btn-ghost" id="btnCancelAddDevice">Odustani</button><button type="submit" class="sp-btn sp-btn-primary">Dodaj uređaj</button></div></div>
        </form>
    </div>
</div>

<!-- ========== Modal: Create inline device ========== -->
<div class="sp-modal-scrim" id="createInlineDeviceScrim"></div>
<div class="sp-modal sp-modal-sm" id="createInlineDeviceModal">
    <div class="cl-modal-wrap">
        <div class="sp-modal-head"><div><div class="sp-modal-title">Novi uređaj</div><div class="sp-modal-sub" id="createInlineDeviceSub">Odaberite model</div></div><button type="button" class="sp-iconbtn" id="btnCloseCreateInlineDevice"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg></button></div>
        <form method="post" id="createInlineDeviceForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ModelID" id="createInlineDeviceModelId" />
            <div class="sp-modal-body"><div class="sp-formgrid"><label class="sp-field sp-col-2"><span class="sp-label">Model</span><div class="sp-field-display" id="createInlineDeviceModelDisplay"></div></label><label class="sp-field sp-col-2"><span class="sp-label">Serijski broj <span class="cl-required">*</span></span><input class="sp-input sp-mono" name="SerialNumber" id="createInlineDeviceSerial" required /></label><div class="sp-col-2 cl-inline-error" id="createInlineDeviceError"></div></div></div>
            <div class="sp-modal-foot"><span class="sp-meta">Uređaj će biti dodat u listu dostupnih uređaja</span><div style="display:flex;gap:8px;"><button type="button" class="sp-btn sp-btn-ghost" id="btnCancelCreateInlineDevice">Odustani</button><button type="submit" class="sp-btn sp-btn-primary" id="btnSaveCreateInlineDevice">Kreiraj uređaj</button></div></div>
        </form>
    </div>
</div>

<!-- ========== Modal: Delete location ========== -->
<div class="sp-modal-scrim" id="deleteLocationScrim"></div>
<div class="sp-modal sp-modal-sm" id="deleteLocationModal">
    <div class="cl-modal-wrap"><form method="post" id="deleteLocationForm">@Html.AntiForgeryToken()<input type="hidden" name="id" id="deleteLocationId" /><input type="hidden" name="SelectedClient" id="deleteLocationClientId" /><input type="hidden" name="searchString" value="@search" /><div class="sp-modal-body" style="padding:22px 24px 12px;"><div class="sp-danger-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" /></svg></div><div class="sp-modal-title" style="margin-top:14px;">Izbriši lokaciju?</div><div class="sp-modal-sub" style="margin-top:6px;line-height:1.5;">Lokacija <b id="deleteLocationName"></b> bit će trajno uklonjena.</div><label class="sp-confirm"><input type="checkbox" id="deleteLocationConfirmCheck" /><span>Razumijem da je ovo trajna radnja.</span></label></div><div class="sp-modal-foot"><button type="button" class="sp-btn sp-btn-ghost" id="btnCancelDeleteLocation">Odustani</button><button type="submit" class="sp-btn sp-btn-danger" id="btnConfirmDeleteLocation" disabled>Izbriši</button></div></form></div>
</div>

<!-- ========== Modal: Delete device assignment ========== -->
<div class="sp-modal-scrim" id="deleteDeviceScrim"></div>
<div class="sp-modal sp-modal-sm" id="deleteDeviceModal">
    <div class="cl-modal-wrap"><form method="post" id="deleteDeviceForm">@Html.AntiForgeryToken()<input type="hidden" name="id" id="deleteDeviceId" /><input type="hidden" name="SelectedClient" id="deleteDeviceClientId" /><div class="sp-modal-body" style="padding:22px 24px 12px;"><div class="sp-danger-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" /></svg></div><div class="sp-modal-title" style="margin-top:14px;">Ukloni uređaj sa lokacije?</div><div class="sp-modal-sub" style="margin-top:6px;line-height:1.5;">Zapis za uređaj <span class="sp-mono" id="deleteDeviceSerial"></span> bit će uklonjen.</div><label class="sp-confirm"><input type="checkbox" id="deleteDeviceConfirmCheck" /><span>Razumijem da je ovo trajna radnja.</span></label></div><div class="sp-modal-foot"><button type="button" class="sp-btn sp-btn-ghost" id="btnCancelDeleteDevice">Odustani</button><button type="submit" class="sp-btn sp-btn-danger" id="btnConfirmDeleteDevice" disabled>Izbriši</button></div></form></div>
</div>

@section Scripts {
    <script>window.CL = { selectedClientId: '@selectedClientId' };</script>
    <script src="~/js/index-table.js" asp-append-version="true"></script>
    <script src="~/js/client-locations.js" asp-append-version="true"></script>
}
