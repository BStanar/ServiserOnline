@model IEnumerable<ServiserOnline.Models.ClientLocation>

@{
    ViewBag.Title = "Korisničke lokacije";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Korisničke lokacije</h2>
    @if (ViewBag.CreateID != Guid.Empty)
    {
        @Html.ActionLink("+ Kreiraj novu", "Create", "ClientLocations", new { SelectedClient = ViewBag.CreateID }, new { @class = "btn btn-primary btn-sm" })
    }
    else
    {
        <button class="btn btn-primary btn-sm" disabled title="Odaberite korisnika prije kreiranja">+ Kreiraj novu</button>
    }
</div>

@using (Html.BeginForm("Index", "ClientLocations", FormMethod.Get))
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <label class="col-form-label">Korisnik:</label>
        </div>
        <div class="col-auto">
            @Html.DropDownList("SelectedClient", null, "Svi", new { @class = "form-select form-select-sm" })
        </div>
        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-secondary btn-sm" />
        </div>
    </div>
}

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Korisnik</th>
                <th>Lokacija</th>
                <th>@Html.DisplayNameFor(model => model.City)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Client?.Name</td>
                    <td>@item.LocationName</td>
                    <td>@item.City</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @Html.ActionLink("Uređaji", "Index", "DeviceInLocations", new { SelectedLocation = item.ID, SelectedClient = item.Client.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                            @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@item.LocationName</strong>
                <span class="badge bg-secondary">@item.Client?.Name</span>
            </div>
            <div class="card-body p-2">
                <div class="row g-1 mb-2">
                    <div class="col-4 text-muted small fw-semibold">Grad</div>
                    <div class="col-8 small">@item.City</div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @Html.ActionLink("Uređaji", "Index", "DeviceInLocations", new { SelectedLocation = item.ID, SelectedClient = item.Client.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Izbriši", "Delete", new { id = item.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-3">
    @Html.ActionLink("← Lista korisnika", "Index", "Clients", new { }, new { @class = "btn btn-outline-secondary btn-sm" })
</div>
