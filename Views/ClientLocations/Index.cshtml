@model IEnumerable<ServiserOnline.Models.ClientLocation>

@{
    ViewBag.Title = "Korisničke lokacije";

    var byClient = Model
        .GroupBy(l => new { Id = l.Client?.ID, Name = l.Client?.Name ?? "—" })
        .OrderBy(g => g.Key.Name);

    int totalLocations = Model.Count();
    int totalClients = byClient.Count();
    string? search = ViewBag.CurrentFilter as string;
    var selectedClientId = ViewBag.CreateID is Guid g ? g : Guid.Empty;

    var devicesByLocation =
        ViewBag.DevicesByLocation as Dictionary<Guid, List<ServiserOnline.Models.DeviceInLocation>>
        ?? new Dictionary<Guid, List<ServiserOnline.Models.DeviceInLocation>>();

    Func<Guid, List<ServiserOnline.Models.DeviceInLocation>> getDevicesForLocation = id =>
        devicesByLocation.TryGetValue(id, out var list)
            ? list
            : new List<ServiserOnline.Models.DeviceInLocation>();

    int totalDevices = devicesByLocation.Values.Sum(v => v.Count);

    var clientOptions = (IEnumerable<SelectListItem>)(ViewBag.ClientID ?? ViewBag.SelectedClient ?? Enumerable.Empty<SelectListItem>());
    var manufacturerOptions = (IEnumerable<SelectListItem>)(ViewBag.Manufacturer ?? Enumerable.Empty<SelectListItem>());
}

@section Styles {
    <link rel="stylesheet" href="~/css/sp-styles.css" asp-append-version="true" />

    <style>
        .cl-wide-page {
            width: min(1760px, calc(100vw - 96px));
            margin-left: 50%;
            transform: translateX(-50%);
        }

            .cl-wide-page .sp-tablewrap {
                width: 100%;
                overflow: visible;
            }

            .cl-wide-page .sp-table {
                table-layout: fixed;
            }

            .cl-wide-page .sp-more-menu {
                z-index: 5000;
            }

        .cl-location-row {
            cursor: pointer;
        }

        .cl-device-row td:first-child {
            padding-left: 68px !important;
        }

        .cl-location-title {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

        .cl-location-name {
            font-weight: 600;
            color: var(--text);
        }

        .cl-location-city {
            color: var(--muted);
            font-size: 12px;
        }

        .cl-device-empty {
            color: var(--muted);
            font-size: 12.5px;
            padding-left: 68px !important;
        }

        .cl-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
            justify-content: flex-end;
            align-items: center;
        }

        .cl-device-serial {
            font-family: var(--mono);
            font-size: 12.5px;
            font-weight: 500;
        }

        .cl-device-meta {
            color: var(--muted);
            font-size: 12px;
        }

        .cl-modal-wrap {
            width: 100%;
            display: flex;
            flex-direction: column;
            border-radius: var(--radius-lg);
            overflow: hidden;
            border: 1px solid var(--border);
            background: var(--surface);
        }

        .cl-dl {
            display: grid;
            grid-template-columns: 140px minmax(0, 1fr);
            gap: 10px 14px;
            font-size: 13px;
        }

        .cl-dl-label {
            color: var(--muted);
            font-weight: 500;
        }

        .cl-dl-value {
            color: var(--text);
            min-width: 0;
            overflow-wrap: anywhere;
        }

        .cl-required {
            color: var(--danger);
        }

        .cl-mobile-devices {
            margin-top: 8px;
            border-top: 1px solid var(--line);
            padding-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .cl-mobile-device {
            background: var(--bg);
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 8px 10px;
        }

        .cl-mobile-device-title {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            align-items: flex-start;
        }

        .cl-mobile-device-model {
            font-weight: 600;
            font-size: 12.5px;
        }

        .cl-mobile-device-serial {
            font-family: var(--mono);
            font-size: 11.5px;
            color: var(--muted);
            overflow-wrap: anywhere;
        }

        .cl-inline-error {
            display: none;
            color: var(--danger);
            font-size: 12.5px;
        }

        @@media (max-width: 900px) {
            .cl-wide-page {
                width: auto;
                margin-left: 0;
                transform: none;
            }

            .cl-actions {
                justify-content: flex-start;
                margin-top: 8px;
            }

            .cl-dl {
                grid-template-columns: 1fr;
                gap: 4px 0;
            }

            .cl-dl-label {
                margin-top: 8px;
                font-size: 11.5px;
            }
        }
    </style>
}

<div class="sp-page-wrap cl-wide-page">
    <div class="sp-pagehead">
        <div>
            <h1 class="sp-h1">Korisničke lokacije</h1>
            <div class="sp-sub">
                <span>@totalLocations lokacija &middot; @totalClients korisnika &middot; @totalDevices uređaja</span>
            </div>
        </div>

        <div class="sp-actions">
            @using (Html.BeginForm("Index", "ClientLocations", FormMethod.Get, new { @class = "d-flex gap-2 align-items-center" }))
            {
                <div class="sp-search">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <circle cx="7" cy="7" r="4.5" />
                        <path d="M14 14l-3.2-3.2" />
                    </svg>
                    <input name="searchString" placeholder="Pretraži korisnika, lokaciju ili grad…" value="@search" />
                    @if (selectedClientId != Guid.Empty)
                    {
                        @Html.Hidden("SelectedClient", selectedClientId)
                    }
                </div>
            }

            <span class="sp-divider-v"></span>

            @if (selectedClientId != Guid.Empty)
            {
                <button type="button" class="sp-btn sp-btn-primary" onclick="openCreateLocation('@selectedClientId', '')">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <path d="M8 3v10M3 8h10" />
                    </svg>
                    Kreiraj novu
                </button>
            }
        </div>
    </div>

    <div class="sp-toolbar">
        <div class="sp-chips">
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                @using (Html.BeginForm("Index", "ClientLocations", FormMethod.Get))
                {
                    @Html.Hidden("searchString", search)
                    <span class="sp-chip" style="padding:0;">
                        @Html.DropDownList("SelectedClient", null, "Korisnik: svi",
                            new { @class = "sp-chip", style = "border:none;background:transparent;cursor:pointer;", onchange = "this.form.submit()" })
                    </span>
                }

                @if (!string.IsNullOrEmpty(search) || selectedClientId != Guid.Empty)
                {
                    <a href="/ClientLocations" class="sp-chip" style="color:var(--danger);">
                        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                            <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
                        </svg>
                        Očisti filter
                    </a>
                }
            </div>
        </div>

        <div class="sp-meta">@totalLocations redova</div>
    </div>

    @if (!Model.Any())
    {
        <div class="sp-empty-state" style="text-align:center;padding:60px 20px;color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:10px;opacity:.5;">
                <path d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1 1 18 0z" />
                <circle cx="12" cy="10" r="3" />
            </svg>
            <p style="font-size:14px;margin:0 0 6px 0;">Nema lokacija za prikaz.</p>
            @if (!string.IsNullOrEmpty(search) || selectedClientId != Guid.Empty)
            {
                <a href="/ClientLocations" class="sp-btn sp-btn-ghost sp-btn-sm" style="margin-top:8px;">Očisti filtere</a>
            }
        </div>
    }
    else
    {
        <div class="sp-tablewrap">
            <table class="sp-table" id="clientLocationsTable">
                <thead>
                    <tr>
                        <th style="width:30%">Lokacija / uređaj</th>
                        <th style="width:23%">Korisnik</th>
                        <th style="width:15%">Grad</th>
                        <th style="width:12%">Instalacija</th>
                        <th style="width:12%">Garancija</th>
                        <th style="width:8%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var clientGroup in byClient)
                    {
                        var clientKey = "client-" + (clientGroup.Key.Id?.ToString("N") ?? "none");
                        <tr class="sp-mfr-row" data-group="@clientKey" onclick="toggleGroup('@clientKey')">
                            <td colspan="6">
                                <div style="display:flex;align-items:center;width:100%;">
                                    <span class="sp-mfr-arrow" id="arrow-@clientKey">
                                        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 6l5 5 5-5" />
                                        </svg>
                                    </span>
                                    <span class="sp-mfr-tag">@clientGroup.Key.Name</span>
                                    <span class="sp-mfr-count">@clientGroup.Count() lokacija · @clientGroup.Sum(l => getDevicesForLocation(l.ID).Count) uređaja</span>

                                    @if (clientGroup.Key.Id.HasValue)
                                    {
                                        <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost sp-model-add"
                                                onclick="event.stopPropagation(); openCreateLocation('@clientGroup.Key.Id', '@clientGroup.Key.Name');">
                                            + Dodaj lokaciju
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>

                        foreach (var loc in clientGroup.OrderBy(l => l.LocationName))
                        {
                            var locationKey = "loc-" + loc.ID.ToString("N");
                            var devices = getDevicesForLocation(loc.ID)
                                .OrderBy(d => d.Model?.Name)
                                .ThenBy(d => d.Device?.SerialNumber)
                                .ToList();

                            <tr class="sp-model-row cl-location-row group-@clientKey" onclick="toggleModel('@locationKey')"
                                data-id="@loc.ID"
                                data-client-id="@loc.Client?.ID"
                                data-client="@loc.Client?.Name"
                                data-location="@loc.LocationName"
                                data-city="@loc.City"
                                data-address="@loc.Address"
                                data-postcode="@loc.PostCode"
                                data-tel1="@loc.Telephone1"
                                data-tel2="@loc.Telephone2"
                                data-description="@loc.Description"
                                data-device-count="@devices.Count">
                                <td colspan="6">
                                    <div style="display:flex;align-items:center;width:100%;">
                                        <span class="sp-model-arrow" id="arrow-@locationKey">
                                            <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 6l5 5 5-5" />
                                            </svg>
                                        </span>
                                        <span class="sp-model-name">@loc.LocationName</span>
                                        <span class="sp-model-meta">@loc.City · @devices.Count uređaja</span>

                                        <div class="sp-model-add" style="display:flex;gap:6px;align-items:center;" onclick="event.stopPropagation();">
                                            <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost"
                                                    onclick="openAddDeviceModal('@loc.ID', '@loc.Client?.ID', '@loc.LocationName');">
                                                + Dodaj uređaj
                                            </button>

                                            <div class="sp-more-wrap sp-row-actions" style="opacity:1;">
                                                <button type="button" class="sp-iconbtn sp-more-trigger" aria-label="Akcije">
                                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                        <circle cx="3.5" cy="8" r=".9" fill="currentColor" />
                                                        <circle cx="8" cy="8" r=".9" fill="currentColor" />
                                                        <circle cx="12.5" cy="8" r=".9" fill="currentColor" />
                                                    </svg>
                                                </button>

                                                <div class="sp-more-menu">
                                                    <div class="sp-more-item cl-description-trigger"
                                                         data-id="@loc.ID"
                                                         data-client-id="@loc.Client?.ID"
                                                         data-client="@loc.Client?.Name"
                                                         data-location="@loc.LocationName"
                                                         data-city="@loc.City"
                                                         data-address="@loc.Address"
                                                         data-postcode="@loc.PostCode"
                                                         data-tel1="@loc.Telephone1"
                                                         data-tel2="@loc.Telephone2"
                                                         data-description="@loc.Description"
                                                         data-device-count="@devices.Count">
                                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                            <path d="M4 3.5h8M4 6.5h8M4 9.5h5M3 13h10" />
                                                        </svg>
                                                        Opis
                                                    </div>

                                                    <div class="sp-more-item cl-edit-location-trigger"
                                                         data-id="@loc.ID"
                                                         data-client-id="@loc.Client?.ID"
                                                         data-name="@loc.LocationName"
                                                         data-city="@loc.City"
                                                         data-address="@loc.Address"
                                                         data-postcode="@loc.PostCode"
                                                         data-tel1="@loc.Telephone1"
                                                         data-tel2="@loc.Telephone2"
                                                         data-description="@loc.Description">
                                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                            <path d="M11 2.5l2.5 2.5L5 13.5H2.5V11z" />
                                                        </svg>
                                                        Izmjeni
                                                    </div>

                                                    <div class="sp-more-item danger cl-delete-location-trigger"
                                                         data-id="@loc.ID"
                                                         data-client-id="@loc.Client?.ID"
                                                         data-name="@loc.LocationName">
                                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                            <path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" />
                                                        </svg>
                                                        Izbriši
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            if (devices.Any())
                            {
                                foreach (var d in devices)
                                {
                                    <tr class="sp-data-row cl-device-row group-@clientKey group-model-@locationKey"
                                        data-id="@d.ID"
                                        data-location="@loc.LocationName"
                                        data-client="@loc.Client?.Name"
                                        data-city="@loc.City"
                                        data-model="@d.Model?.Name"
                                        data-manufacturer="@d.Manufacturer?.Name"
                                        data-serial="@d.Device?.SerialNumber"
                                        data-install="@d.DateOfInstalation.ToString("dd.MM.yyyy")"
                                        data-guarantee="@d.DateOfGuarantieEnd.ToString("dd.MM.yyyy")">
                                        <td>
                                            <div class="cl-location-title">
                                                <span class="cl-device-serial">@d.Device?.SerialNumber</span>
                                            </div>
                                            <div class="cl-device-meta">@(d.Manufacturer?.Name) @(d.Model?.Name != null ? "› " + d.Model.Name : "")</div>
                                        </td>
                                        <td>@loc.Client?.Name</td>
                                        <td>@loc.City</td>
                                        <td><span class="sp-mono">@d.DateOfInstalation.ToString("dd.MM.yyyy")</span></td>
                                        <td><span class="sp-mono">@d.DateOfGuarantieEnd.ToString("dd.MM.yyyy")</span></td>
                                        <td onclick="event.stopPropagation();">
                                            <div class="sp-more-wrap sp-row-actions">
                                                <button type="button" class="sp-iconbtn sp-more-trigger" aria-label="Akcije">
                                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                        <circle cx="3.5" cy="8" r=".9" fill="currentColor" />
                                                        <circle cx="8" cy="8" r=".9" fill="currentColor" />
                                                        <circle cx="12.5" cy="8" r=".9" fill="currentColor" />
                                                    </svg>
                                                </button>
                                                <div class="sp-more-menu">
                                                    <a class="sp-more-item" href="@Url.Action("Edit", "DeviceInLocations", new { id = d.ID, SelectedClient = loc.Client?.ID })">
                                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                            <path d="M11 2.5l2.5 2.5L5 13.5H2.5V11z" />
                                                        </svg>
                                                        Izmjeni
                                                    </a>
                                                    <div class="sp-more-item danger cl-delete-device-trigger"
                                                         data-id="@d.ID"
                                                         data-serial="@d.Device?.SerialNumber"
                                                         data-client-id="@loc.Client?.ID">
                                                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                            <path d="M3 5h10M6 5V3.5h4V5M5 5l.7 8.5h4.6L11 5" />
                                                        </svg>
                                                        Izbriši
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="sp-data-row group-@clientKey group-model-@locationKey">
                                    <td colspan="6" class="cl-device-empty">Nema uređaja na ovoj lokaciji.</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="sp-mobile-cards">
            @foreach (var clientGroup in byClient)
            {
                <div class="sp-mc-mfr">
                    <div class="sp-mc-mfr-head">
                        <div>
                            <div class="sp-mc-mfr-name">@clientGroup.Key.Name</div>
                            <div class="sp-mc-mfr-meta">
                                <span>@clientGroup.Count() lokacija</span>
                                <span>@clientGroup.Sum(l => getDevicesForLocation(l.ID).Count) uređaja</span>
                            </div>
                        </div>
                        @if (clientGroup.Key.Id.HasValue)
                        {
                            <button type="button" class="sp-mc-mfr-add" onclick="openCreateLocation('@clientGroup.Key.Id', '@clientGroup.Key.Name')">+ Lokacija</button>
                        }
                    </div>

                    @foreach (var loc in clientGroup.OrderBy(l => l.LocationName))
                    {
                        var devices = getDevicesForLocation(loc.ID).OrderBy(d => d.Model?.Name).ThenBy(d => d.Device?.SerialNumber).ToList();
                        <div class="sp-mc-model">
                            <div class="sp-mc-model-head">
                                <div class="dv-model-title">
                                    <span class="sp-mc-model-name">@loc.LocationName</span>
                                    <span class="sp-mc-model-meta">@loc.City · @devices.Count uređaja</span>
                                </div>
                                <button type="button" class="sp-mc-model-add" onclick="openAddDeviceModal('@loc.ID', '@loc.Client?.ID', '@loc.LocationName')">+ Uređaj</button>
                            </div>

                            <div class="sp-mc-item">
                                <div class="sp-mc-item-row1">
                                    <div class="sp-mc-item-title">@loc.LocationName</div>
                                    <span class="sp-badge @(devices.Any() ? "sp-badge-ok" : "sp-badge-out")">@devices.Count uređaja</span>
                                </div>

                                <div class="sp-mc-item-row2">
                                    <span class="sp-mc-item-muted">@loc.Client?.Name</span>
                                    @if (!string.IsNullOrEmpty(loc.City))
                                    {
                                        <span class="sp-mc-item-muted">@loc.City</span>
                                    }
                                </div>

                                <div class="cl-mobile-devices">
                                    @if (devices.Any())
                                    {
                                        foreach (var d in devices)
                                        {
                                            <div class="cl-mobile-device">
                                                <div class="cl-mobile-device-title">
                                                    <span class="cl-mobile-device-model">@d.Model?.Name</span>
                                                    <span class="cl-mobile-device-serial">@d.Device?.SerialNumber</span>
                                                </div>
                                                <div class="cl-device-meta">
                                                    Inst. @d.DateOfInstalation.ToString("dd.MM.yyyy") · Gar. @d.DateOfGuarantieEnd.ToString("dd.MM.yyyy")
                                                </div>
                                                <div style="display:flex;justify-content:flex-end;margin-top:6px;" onclick="event.stopPropagation();">
                                                    <div class="sp-more-wrap">
                                                        <button type="button" class="sp-iconbtn sp-more-trigger" aria-label="Akcije">
                                                            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                                <circle cx="3.5" cy="8" r=".9" fill="currentColor" />
                                                                <circle cx="8" cy="8" r=".9" fill="currentColor" />
                                                                <circle cx="12.5" cy="8" r=".9" fill="currentColor" />
                                                            </svg>
                                                        </button>
                                                        <div class="sp-more-menu">
                                                            <a class="sp-more-item" href="@Url.Action("Edit", "DeviceInLocations", new { id = d.ID, SelectedClient = loc.Client?.ID })">Izmjeni</a>
                                                            <div class="sp-more-item danger cl-delete-device-trigger" data-id="@d.ID" data-serial="@d.Device?.SerialNumber" data-client-id="@loc.Client?.ID">Izbriši</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="cl-device-meta">Nema uređaja na ovoj lokaciji.</div>
                                    }
                                </div>

                                <div class="sp-mc-item-row3" onclick="event.stopPropagation();">
                                    <div class="cl-actions" style="width:100%;justify-content:space-between;align-items:center;">
                                        <button type="button" class="sp-btn sp-btn-ghost sp-btn-sm" onclick="openAddDeviceModal('@loc.ID', '@loc.Client?.ID', '@loc.LocationName')">+ Dodaj uređaj</button>

                                        <div class="sp-more-wrap">
                                            <button type="button" class="sp-iconbtn sp-more-trigger" aria-label="Akcije">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                                                    <circle cx="3.5" cy="8" r=".9" fill="currentColor" />
                                                    <circle cx="8" cy="8" r=".9" fill="currentColor" />
                                                    <circle cx="12.5" cy="8" r=".9" fill="currentColor" />
                                                </svg>
                                            </button>
                                            <div class="sp-more-menu">
                                                <div class="sp-more-item cl-description-trigger"
                                                     data-id="@loc.ID"
                                                     data-client-id="@loc.Client?.ID"
                                                     data-client="@loc.Client?.Name"
                                                     data-location="@loc.LocationName"
                                                     data-city="@loc.City"
                                                     data-address="@loc.Address"
                                                     data-postcode="@loc.PostCode"
                                                     data-tel1="@loc.Telephone1"
                                                     data-tel2="@loc.Telephone2"
                                                     data-description="@loc.Description"
                                                     data-device-count="@devices.Count">
                                                    Opis
                                                </div>
                                                <div class="sp-more-item cl-edit-location-trigger"
                                                     data-id="@loc.ID"
                                                     data-client-id="@loc.Client?.ID"
                                                     data-name="@loc.LocationName"
                                                     data-city="@loc.City"
                                                     data-address="@loc.Address"
                                                     data-postcode="@loc.PostCode"
                                                     data-tel1="@loc.Telephone1"
                                                     data-tel2="@loc.Telephone2"
                                                     data-description="@loc.Description">
                                                    Izmjeni
                                                </div>
                                                <div class="sp-more-item danger cl-delete-location-trigger"
                                                     data-id="@loc.ID"
                                                     data-client-id="@loc.Client?.ID"
                                                     data-name="@loc.LocationName">
                                                    Izbriši
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <div style="margin-top:16px;">
        @Html.ActionLink("← Lista korisnika", "Index", "Clients", new { }, new { @class = "sp-btn sp-btn-ghost sp-btn-sm" })
    </div>
