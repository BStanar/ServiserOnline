@model ServiserOnline.Models.ClientLocation

@{
    ViewBag.Title = "Izmjeni lokaciju";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Izmjeni lokaciju</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "ClientLocations",
        new { SelectedClient = Model.ClientID },
        new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)

            <div class="mb-3">
                <label class="form-label fw-semibold">Korisnik</label>
                @Html.HiddenFor(model => model.ClientID)
                @Html.DropDownList("ClientID", null, new { @class = "form-select", disabled = "disabled" })
                @Html.ValidationMessageFor(model => model.ClientID, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Address, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Address, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Address, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.LocationName, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.LocationName, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.LocationName, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.City, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.City, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.PostCode, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.PostCode, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.PostCode, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Telephone1, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Telephone1, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Telephone1, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Telephone2, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Telephone2, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Telephone2, "", new { @class = "text-danger small" })
            </div>
            <div class="mb-3">
                @Html.LabelFor(model => model.Description, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Description, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger small" })
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Sačuvaj" class="btn btn-primary" />
                @Html.ActionLink("Odustani", "Index", "ClientLocations",
                    new { SelectedClient = Model.ClientID },
                    new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
