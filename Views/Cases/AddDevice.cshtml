@model ServiserOnline.Models.Case

@{
    Layout = null;
}

<div class="sp-modal-panel sp-case-modal-panel">
    <div class="sp-modal-head">
        <div>
            <div class="sp-modal-title">Dodavanje uređaja</div>
            <div class="sp-modal-sub">
                @(Model.Client?.Name ?? "-")
                @if (Model.DateTimeCaseOpened.HasValue)
                {
                    <span> · @Model.DateTimeCaseOpened.Value.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>

        <button type="button" class="sp-iconbtn" aria-label="Zatvori" onclick="closeCaseAjaxModal()">×</button>
    </div>

    <div class="sp-modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "sp-alert-error" })
        }

        @using (Html.BeginForm("AddDevice", "Cases", FormMethod.Post, new { data_case_modal_form = "device", @class = "sp-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ID)

            <div class="sp-field">
                <label class="sp-label" for="LocationID">Lokacija</label>
                @Html.DropDownList("LocationID", null, "-- Odaberi lokaciju --", new { @class = "sp-input", id = "LocationID" })
            </div>

            <div class="sp-field">
                <label class="sp-label" for="Device">Uređaj</label>
                <select id="Device" name="Device" class="sp-input sp-truncate-select">
                    <option value="">-- Odaberi lokaciju prvo --</option>
                </select>
                <div class="sp-help-text">Prikazuju se samo uređaji koji još nisu dodani u ovaj radni nalog.</div>
            </div>

            <div class="sp-modal-foot sp-modal-foot-inline">
                <button type="submit" name="action:AddDevice" class="sp-btn sp-btn-primary sp-btn-sm">+ Dodaj uređaj</button>
            </div>
        }

        <div class="sp-modal-section-title">Dodati uređaji</div>

        @if (Model.Devices?.Any() == true)
        {
            <div class="sp-mini-table-wrap">
                <table class="sp-mini-table sp-fixed-mini-table">
                    <thead>
                        <tr>
                            <th>Proizvođač / Model</th>
                            <th style="width: 140px;">Serijski br.</th>
                            <th style="width: 86px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Devices)
                        {
                            var manufacturer = item.DeviceInLocation?.Manufacturer?.Name
                                ?? item.DeviceInLocation?.Model?.Manufacturer?.Name
                                ?? "-";

                            <tr>
                                <td class="sp-ellipsis-cell">
                                    <span class="sp-muted">@manufacturer</span>
                                    <span> / @(item.DeviceInLocation?.Model?.Name ?? "-")</span>
                                </td>
                                <td><strong>@(item.DeviceInLocation?.Device?.SerialNumber ?? "-")</strong></td>
                                <td class="sp-mini-actions">
                                    <a class="sp-btn sp-btn-xs sp-btn-danger"
                                           data-case-modal-link="device"
                                           href="@Url.Action("RemoveDevice", "Cases", new { ID = item.DeviceInLocationID, caseID = Model.ID })">
                                        Ukloni
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="sp-empty-mini">Nema dodatih uređaja.</div>
        }
    </div>
</div>
