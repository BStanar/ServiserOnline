@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Dodavanje uređaja";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Dodavanje uređaja intervenciji</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)

            <div class="mb-3">
                @Html.LabelFor(model => model.Client.Name, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Client.Name, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateTimeCaseOpened, new { @class = "form-label fw-semibold" })
                <div>@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeCaseOpened))</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Lokacija</label>
                @Html.DropDownList("LocationID", null, new { @class = "form-select" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Uređaj</label>
                @Html.DropDownList("Device", new SelectList(" "), "", new { @class = "form-select" })
            </div>

            <div class="d-flex gap-2 mb-4">
                <input type="submit" name="action:AddDevice" value="Dodaj uređaj" class="btn btn-primary" />
                <input type="submit" name="action:AddDeviceReportAsync" value="Dodaj uređaj → Izvještaj" class="btn btn-outline-primary" />
            </div>
        }

        @if (Model.Devices != null && Model.Devices.Count > 0)
        {
            <h5 class="mb-2">Dodati uređaji</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Model</th>
                            <th>Serijski broj</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Devices)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Model.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.Device.SerialNumber)</td>
                                <td>
                                    @Html.ActionLink("Izbriši", "RemoveDevice", new { ID = item.ID, caseID = Model.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Nema dodatih uređaja.</p>
        }

        <div class="mt-3 d-flex gap-2">
            @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
            @Html.ActionLink("Nazad na izvještaj", "OnSite", "AcceptCase", new { CaseID = Model.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('LocationID').addEventListener('change', function () {
            fetch('/Cases/GetDevicesList?SelectedLocation=' + this.value)
                .then(r => r.json())
                .then(data => {
                    const sel = document.getElementById('Device');
                    sel.innerHTML = '';
                    data.forEach(row => {
                        const opt = document.createElement('option');
                        opt.value = row.id;
                        opt.textContent = row.serialNumber;
                        sel.appendChild(opt);
                    });
                });
        });
    </script>
}
