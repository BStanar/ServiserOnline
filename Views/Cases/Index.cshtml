
@model X.PagedList.IPagedList<ServiserOnline.Models.Case>

@{
    ViewBag.Title = "Index";
}

<h2>Intervencije</h2>
<p>
    <button onclick="window.location.href='@Url.Action("Create")'" style="font-size:11pt;font-family:Calibri,sans-serif;padding:4px 12px;cursor:pointer;">
        Nova intervencija
    </button>
</p>
<table class="table">
    <tr>
        <th>
            @* @Html.DisplayNameFor(model => model.status)*@
        </th>
        <th>
            Servisni broj
        </th>
        <th>
            Korisnik
        </th>
        <th>
            Datum kreiranja
        </th>
        <th>
            Planirani datum
        </th>
        <th>
            Datum završetka
        </th>
        <th>
            Vrsta usluge
        </th>
        <th>
            Serviser
        </th>
        <th>
            Nedovršeno
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
    <tr>
            <td style="background-color: @item.CaseStatus.ToString().ToLower(); width: 20px;"></td>
        <td>
            @Html.DisplayFor(modelItem => item.CaseServisNumber)
        </td>
        <td>
            @Html.ActionLink(item.Client.Name, "Edit", "Clients", new { id = item.Client.ID }, new { target = "_blank" })
        </td>
        <td>
            @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.DateTimeCaseOpened))
        </td>
        <td>
            @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.DateTimePlanned))
        </td>
        <td>
            @Convert.ToString(string.Format("{0:dd/MM/yyyy}", item.DateTimeServiced))
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.InterventionType.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ServicePerson)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.NotFinishedDescription)
        </td>
        <td>
