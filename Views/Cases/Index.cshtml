@model X.PagedList.IPagedList<ServiserOnline.Models.Case>
@using X.PagedList.Mvc.Core
@using ServiserOnline.Models

@{
    ViewBag.Title = "Intervencije";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Intervencije</h2>
    @Html.ActionLink("+ Nova intervencija", "Create", null, new { @class = "btn btn-primary btn-sm" })
</div>

@using (Html.BeginForm("Index", "Cases", FormMethod.Get))
{
    <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
    <div class="row g-2 mb-2">
        <div class="col-auto">
            @Html.TextBox("searchString", ViewBag.CurrentFilter as string, new { @class = "form-control form-control-sm", placeholder = "Pretraži po korisniku ili br. izvještaja..." })
        </div>
        <div class="col-auto">
            <input type="submit" value="Pretraži" class="btn btn-secondary btn-sm" />
        </div>
    </div>
}

<div class="d-flex flex-wrap gap-1 mb-3">
    @Html.ActionLink("Aktivni", "Index", null, new { @class = "btn btn-sm " + (string.IsNullOrEmpty(ViewBag.CurrentStatus as string) ? "btn-dark" : "btn-outline-dark") })
    @Html.ActionLink("Primljeni", "Index", new { status = "yellow" }, new { @class = "btn btn-sm " + (ViewBag.CurrentStatus == "yellow" ? "btn-warning" : "btn-outline-warning") })
    @Html.ActionLink("Prihvaćeni", "Index", new { status = "orange" }, new { @class = "btn btn-sm " + (ViewBag.CurrentStatus == "orange" ? "btn-warning text-dark" : "btn-outline-warning text-dark"), style = "background-color:" + (ViewBag.CurrentStatus == "orange" ? "orange" : "transparent") + ";border-color:orange;" })
    @Html.ActionLink("Neuspješno završeni", "Index", new { status = "lightgreen" }, new { @class = "btn btn-sm " + (ViewBag.CurrentStatus == "lightgreen" ? "btn-success" : "btn-outline-success") })
    @Html.ActionLink("Uspješno završeni", "Index", new { status = "green" }, new { @class = "btn btn-sm " + (ViewBag.CurrentStatus == "green" ? "btn-success" : "btn-outline-success") })
    @Html.ActionLink("Fakturisani", "Index", new { status = "lightblue" }, new { @class = "btn btn-sm " + (ViewBag.CurrentStatus == "lightblue" ? "btn-info" : "btn-outline-info") })
</div>

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width:8px;"></th>
                <th>Br. izvještaja</th>
                <th>Korisnik</th>
                <th>Datum prijema</th>
                <th>Planirani datum</th>
                <th>Datum završetka</th>
                <th>Vrsta usluge</th>
                <th>Serviser</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="background-color:@item.CaseStatus.ToString().ToLower(); padding:0; width:8px;"></td>
                    <td>@item.CaseServisNumber</td>
                    <td>@Html.ActionLink(item.Client?.Name ?? "", "Edit", "Clients", new { id = item.Client?.ID }, new { target = "_blank", @class = "text-decoration-none" })</td>
                    <td class="text-nowrap">@(item.DateTimeCaseOpened.HasValue ? item.DateTimeCaseOpened.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td class="text-nowrap">@(item.DateTimePlanned.HasValue ? item.DateTimePlanned.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td class="text-nowrap">@(item.DateTimeServiced.HasValue ? item.DateTimeServiced.Value.ToString("dd/MM/yyyy") : "")</td>
                    <td>@item.InterventionType?.Name</td>
                    <td>@item.ServicePerson</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @if (item.CaseStatus == CaseStatus.Yellow)
                            {
                                @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                                @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                                @Html.ActionLink("Prihvati", "Index", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-warning btn-sm" })
                            }
                            @if (item.CaseStatus == CaseStatus.Orange)
                            {
                                @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                                @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                                @Html.ActionLink("Izvještaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-primary btn-sm" })
                            }
                            @if (item.CaseStatus == CaseStatus.LightGreen)
                            {
                                @Html.ActionLink("Izvještaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-primary btn-sm" })
                                @Html.ActionLink("Štampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                            @if (item.CaseStatus == CaseStatus.Green)
                            {
                                @Html.ActionLink("Štampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                                @Html.ActionLink("Fakturisano", "Invoice", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-info btn-sm" })
                            }
                            @if (item.CaseStatus == CaseStatus.LightBlue)
                            {
                                @Html.ActionLink("Štampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                            }
                            @Html.ActionLink("Detalji", "Details", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3" style="border-left: 4px solid @item.CaseStatus.ToString().ToLower();">
            <div class="card-header d-flex justify-content-between align-items-start">
                <div>
                    <strong>@item.Client?.Name</strong>
                    @if (!string.IsNullOrEmpty(item.CaseServisNumber))
                    {
                        <div class="text-muted small">@item.CaseServisNumber</div>
                    }
                </div>
                <span class="badge" style="background-color:@item.CaseStatus.ToString().ToLower(); color:#333;">
                    @item.CaseStatus.ToString()
                </span>
            </div>
            <div class="card-body p-2">
                <div class="row g-1 mb-2 small">
                    @if (item.DateTimePlanned.HasValue)
                    {
                        <div class="col-5 text-muted fw-semibold">Planirani datum</div>
                        <div class="col-7">@item.DateTimePlanned.Value.ToString("dd/MM/yyyy")</div>
                    }
                    @if (!string.IsNullOrEmpty(item.InterventionType?.Name))
                    {
                        <div class="col-5 text-muted fw-semibold">Vrsta usluge</div>
                        <div class="col-7">@item.InterventionType.Name</div>
                    }
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @if (item.CaseStatus == CaseStatus.Yellow)
                    {
                        @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Prihvati", "Index", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-warning btn-sm" })
                    }
                    @if (item.CaseStatus == CaseStatus.Orange)
                    {
                        @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Izvještaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-primary btn-sm" })
                    }
                    @if (item.CaseStatus == CaseStatus.LightGreen)
                    {
                        @Html.ActionLink("Izvještaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Štampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    }
                    @if (item.CaseStatus == CaseStatus.Green)
                    {
                        @Html.ActionLink("Štampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                        @Html.ActionLink("Fakturisano", "Invoice", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-info btn-sm" })
                    }
                    @if (item.CaseStatus == CaseStatus.LightBlue)
                    {
                        @Html.ActionLink("Štampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    }
                    @Html.ActionLink("Detalji", "Details", new { id = item.ID }, new { @class = "btn btn-outline-secondary btn-sm" })
                    @Html.ActionLink("Izbriši", "Delete", new { id = item.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <small class="text-muted">Strana @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) od @Model.PageCount (@Model.TotalItemCount ukupno)</small>
    <nav>
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, status = ViewBag.CurrentStatus, currentFilter = ViewBag.CurrentFilter }),
            new PagedListRenderOptions
            {
                UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                ActiveLiElementClass = "active",
                DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
                DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 10
            })
    </nav>
</div>
