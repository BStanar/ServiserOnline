@model X.PagedList.IPagedList<ServiserOnline.Models.Case>
@using X.PagedList.Mvc.Core
@using ServiserOnline.Models

@{
    ViewBag.Title = "Intervencije";
}

<style>
    .cases-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }

    .cases-header h2 {
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin: 0;
    }

    /* Nova intervencija button */
    a.nova-btn {
        display: inline-block !important;
        background-color: #0d6efd !important;
        color: #fff !important;
        border: 1px solid #0d6efd !important;
        padding: 0.25rem 0.75rem !important;
        font-size: 0.875rem !important;
        font-weight: 400 !important;
        border-radius: 0.375rem !important;
        text-decoration: none !important;
        line-height: 1.5 !important;
        cursor: pointer;
        transition: background-color 0.15s;
    }
    a.nova-btn:hover {
        background-color: #0b5ed7 !important;
        border-color: #0a58ca !important;
        color: #fff !important;
        text-decoration: none !important;
    }

    /* Svi aktivni + status filter buttons */
    a.svi-btn, a.svi-btn-outline {
        display: inline-block !important;
        padding: 0.25rem 0.75rem !important;
        font-size: 0.875rem !important;
        font-weight: 400 !important;
        border-radius: 0.375rem !important;
        text-decoration: none !important;
        line-height: 1.5 !important;
        border: 1px solid transparent !important;
        cursor: pointer;
        transition: all 0.15s;
    }
    a.svi-btn          { background:#212529 !important; color:#fff !important; border-color:#212529 !important; }
    a.svi-btn:hover    { background:#424649 !important; color:#fff !important; text-decoration:none !important; }
    a.svi-btn-outline  { background:transparent !important; color:#212529 !important; border-color:#212529 !important; }
    a.svi-btn-outline:hover { background:#212529 !important; color:#fff !important; text-decoration:none !important; }

    /* Status filter tabs */
    .status-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }

    /* Table */
    .cases-table {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        font-size: 0.85rem;
    }

    .cases-table thead tr {
        background: #1a1a2e;
    }

    .cases-table thead th {
        color: #9ba3bf;
        font-weight: 600;
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.65rem 0.75rem;
        border: none;
        white-space: nowrap;
    }

    .cases-table thead th:first-child { border-radius: 8px 0 0 0; }
    .cases-table thead th:last-child  { border-radius: 0 8px 0 0; }

    .cases-table tbody tr {
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.1s;
    }

    .cases-table tbody tr:hover { background: #f8f9fd; }

    .cases-table tbody td {
        padding: 0.6rem 0.75rem;
        vertical-align: middle;
        border: none;
    }

    /* Status stripe */
    .status-stripe {
        width: 5px;
        padding: 0 !important;
    }

    /* Case number */
    .case-number {
        font-weight: 700;
        font-size: 0.8rem;
        color: #1a1a2e;
        letter-spacing: 0.02em;
    }

    .case-number-empty {
        color: #bbb;
        font-style: italic;
        font-size: 0.78rem;
    }

    /* Client link */
    .client-link {
        font-weight: 600;
        color: #1a1a2e;
        text-decoration: none;
    }
    .client-link:hover { color: #0288d1; text-decoration: none; }

    /* Date cells */
    .date-cell {
        color: #555;
        font-size: 0.82rem;
        white-space: nowrap;
    }

    .service-person {
        font-size: 0.82rem;
        color: #444;
    }

    /* Action buttons */
    .action-group {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
    }

    .act-btn {
        font-size: 0.73rem;
        font-weight: 600;
        padding: 0.22rem 0.6rem;
        border-radius: 5px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
        transition: filter 0.12s, transform 0.1s;
        letter-spacing: 0.01em;
    }

    .act-btn:hover { filter: brightness(0.88); transform: translateY(-1px); text-decoration: none; }

    .act-accept    { background: #f5c842; color: #333; }
    .act-report    { background: #1565c0; color: #fff; }
    .act-print     { background: #455a64; color: #fff; }
    .act-invoice   { background: #0288d1; color: #fff; }
    .act-devices   { background: #e8eaf6; color: #3949ab; border: 1px solid #9fa8da; }
    .act-parts     { background: #fce4ec; color: #c2185b; border: 1px solid #f48fb1; }
    .act-details   { background: #f5f5f5; color: #444; border: 1px solid #ddd; }
    .act-delete    { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }

    /* Status badge for mobile */
    .status-pill {
        display: inline-block;
        padding: 0.15rem 0.6rem;
        border-radius: 12px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    /* Mobile card */
    .case-card {
        border: none;
        border-radius: 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.10);
        margin-bottom: 0.75rem;
        overflow: hidden;
    }

    .case-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 0.6rem 0.85rem;
        border-bottom: 1px solid #f0f0f0;
    }

    .case-card-body {
        padding: 0.6rem 0.85rem;
    }

    /* Search bar */
    .search-row {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        align-items: center;
    }

    .search-row .form-control {
        max-width: 340px;
        font-size: 0.85rem;
        border-radius: 6px;
        border-color: #dde1ee;
    }

    /* Pagination */
    .pagination .page-link {
        font-size: 0.8rem;
        padding: 0.3rem 0.6rem;
        color: #1a1a2e;
        border-color: #dde1ee;
    }

    .pagination .page-item.active .page-link {
        background: #1a1a2e;
        border-color: #1a1a2e;
    }
</style>

<div class="cases-header">
    <h2>Intervencije</h2>
    <a href="@Url.Action("Create")"
       style="display:inline-block;background:#0d6efd;color:#fff;padding:6px 14px;font-size:0.875rem;font-weight:500;border-radius:6px;text-decoration:none;border:1px solid #0d6efd;">
        + Nova intervencija
    </a>
</div>

@using (Html.BeginForm("Index", "Cases", FormMethod.Get))
{
    <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
    <div class="search-row">
        @Html.TextBox("searchString", ViewBag.CurrentFilter as string,
            new { @class = "form-control form-control-sm", placeholder = "Pretrazi po korisniku ili br. izvjestaja..." })
        <input type="submit" value="Pretrazi" class="btn btn-secondary btn-sm" style="font-size:0.82rem;" />
    </div>
}

@{
    string cur = ViewBag.CurrentStatus as string ?? "";
}

<div class="status-tabs">
    @{
        string sviActiveStyle = "display:inline-block;padding:5px 12px;font-size:0.85rem;font-weight:500;border-radius:6px;text-decoration:none;border:1px solid #212529;" +
                                (cur == "" ? "background:#212529;color:#fff;" : "background:transparent;color:#212529;");
    }
    <a href="@Url.Action("Index")" style="@sviActiveStyle">Svi aktivni</a>
    @Html.ActionLink("Primljeni", "Index", new { status = "yellow" },
        new { @class = "btn btn-sm " + (cur == "yellow" ? "btn-warning" : "btn-outline-warning") })
    @Html.ActionLink("Prihvaceni", "Index", new { status = "orange" },
        new { @class = "btn btn-sm " + (cur == "orange" ? "btn-warning" : "btn-outline-warning"), style = "border-color:orange;" + (cur == "orange" ? "background:orange;" : "") })
    @Html.ActionLink("Neuspjesno zavrseni", "Index", new { status = "lightgreen" },
        new { @class = "btn btn-sm " + (cur == "lightgreen" ? "btn-success" : "btn-outline-success") })
    @Html.ActionLink("Uspjesno zavrseni", "Index", new { status = "green" },
        new { @class = "btn btn-sm " + (cur == "green" ? "btn-success" : "btn-outline-success") })
    @Html.ActionLink("Fakturisani", "Index", new { status = "lightblue" },
        new { @class = "btn btn-sm " + (cur == "lightblue" ? "btn-info" : "btn-outline-info") })
</div>

@{
    string StatusBg(CaseStatus s) => s switch
    {
        CaseStatus.Yellow     => "#f5c842",
        CaseStatus.Orange     => "#f58c1a",
        CaseStatus.LightGreen => "#5cb85c",
        CaseStatus.Green      => "#2e7d32",
        CaseStatus.LightBlue  => "#0288d1",
        CaseStatus.Black      => "#333",
        _                     => "#aaa"
    };

    string StatusLabel(CaseStatus s) => s switch
    {
        CaseStatus.Yellow     => "Primljen",
        CaseStatus.Orange     => "Prihvacen",
        CaseStatus.LightGreen => "Neuspj. zavrsen",
        CaseStatus.Green      => "Uspj. zavrsen",
        CaseStatus.LightBlue  => "Fakturisan",
        CaseStatus.Black      => "Odbijen",
        _                     => s.ToString()
    };

    string StatusText(CaseStatus s) => s is CaseStatus.Yellow ? "#333" : "#fff";
}

<!-- Desktop table -->
<div class="d-none d-xl-block" style="overflow-x:hidden;">
    <table class="cases-table">
        <thead>
            <tr>
                <th class="status-stripe"></th>
                <th>Br. izvjestaja</th>
                <th>Korisnik</th>
                <th>Datum prijema</th>
                <th>Planirani datum</th>
                <th>Datum zavrsetka</th>
                <th>Vrsta usluge</th>
                <th>Serviser</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="status-stripe" style="background:@StatusBg(item.CaseStatus);"></td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.CaseServisNumber))
                        {
                            <span class="case-number">@item.CaseServisNumber</span>
                        }
                        else
                        {
                            <span class="case-number-empty">-</span>
                        }
                    </td>
                    <td>
                        @Html.ActionLink(item.Client?.Name ?? "-", "Edit", "Clients",
                            new { id = item.Client?.ID },
                            new { target = "_blank", @class = "client-link" })
                    </td>
                    <td class="date-cell">@(item.DateTimeCaseOpened.HasValue ? item.DateTimeCaseOpened.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td class="date-cell">@(item.DateTimePlanned.HasValue ? item.DateTimePlanned.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td class="date-cell">@(item.DateTimeServiced.HasValue ? item.DateTimeServiced.Value.ToString("dd/MM/yyyy") : "-")</td>
                    <td style="font-size:0.82rem;">@item.InterventionType?.Name</td>
                    <td class="service-person">@item.ServicePerson</td>
                    <td>
                        <div class="action-group">
                            @if (item.CaseStatus == CaseStatus.Yellow)
                            {
                                @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "act-btn act-devices" })
                                @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "act-btn act-parts" })
                                @Html.ActionLink("Prihvati", "Index", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-accept" })
                            }
                            @if (item.CaseStatus == CaseStatus.Orange)
                            {
                                @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "act-btn act-devices" })
                                @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "act-btn act-parts" })
                                @Html.ActionLink("Izvjestaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-report" })
                            }
                            @if (item.CaseStatus == CaseStatus.LightGreen)
                            {
                                @Html.ActionLink("Izvjestaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-report" })
                                @Html.ActionLink("Stampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-print" })
                            }
                            @if (item.CaseStatus == CaseStatus.Green)
                            {
                                @Html.ActionLink("Stampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-print" })
                                @Html.ActionLink("Fakturisano", "Invoice", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-invoice" })
                            }
                            @if (item.CaseStatus == CaseStatus.LightBlue)
                            {
                                @Html.ActionLink("Stampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-print" })
                            }
                            @Html.ActionLink("Detalji", "Details", new { id = item.ID }, new { @class = "act-btn act-details" })
                            @Html.ActionLink("Izbrisi", "Delete", new { id = item.ID }, new { @class = "act-btn act-delete" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile cards -->
<div class="d-xl-none">
    @foreach (var item in Model)
    {
        <div class="case-card" style="border-left: 5px solid @StatusBg(item.CaseStatus);">
            <div class="case-card-header">
                <div>
                    <div style="font-weight:700; font-size:0.9rem;">@(item.Client?.Name ?? "-")</div>
                    @if (!string.IsNullOrEmpty(item.CaseServisNumber))
                    {
                        <div style="font-size:0.75rem; color:#888; font-weight:600; letter-spacing:0.03em;">@item.CaseServisNumber</div>
                    }
                </div>
                <span class="status-pill" style="background:@StatusBg(item.CaseStatus); color:@StatusText(item.CaseStatus);">
                    @StatusLabel(item.CaseStatus)
                </span>
            </div>
            <div class="case-card-body">
                <div class="row g-1 mb-2" style="font-size:0.8rem;">
                    @if (item.DateTimePlanned.HasValue)
                    {
                        <div class="col-5" style="color:#888; font-weight:600;">Planirani datum</div>
                        <div class="col-7">@item.DateTimePlanned.Value.ToString("dd/MM/yyyy")</div>
                    }
                    @if (!string.IsNullOrEmpty(item.InterventionType?.Name))
                    {
                        <div class="col-5" style="color:#888; font-weight:600;">Vrsta usluge</div>
                        <div class="col-7">@item.InterventionType.Name</div>
                    }
                    @if (!string.IsNullOrEmpty(item.ServicePerson))
                    {
                        <div class="col-5" style="color:#888; font-weight:600;">Serviser</div>
                        <div class="col-7">@item.ServicePerson</div>
                    }
                </div>
                <div class="action-group">
                    @if (item.CaseStatus == CaseStatus.Yellow)
                    {
                        @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "act-btn act-devices" })
                        @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "act-btn act-parts" })
                        @Html.ActionLink("Prihvati", "Index", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-accept" })
                    }
                    @if (item.CaseStatus == CaseStatus.Orange)
                    {
                        @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }, new { @class = "act-btn act-devices" })
                        @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }, new { @class = "act-btn act-parts" })
                        @Html.ActionLink("Izvjestaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-report" })
                    }
                    @if (item.CaseStatus == CaseStatus.LightGreen)
                    {
                        @Html.ActionLink("Izvjestaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-report" })
                        @Html.ActionLink("Stampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-print" })
                    }
                    @if (item.CaseStatus == CaseStatus.Green)
                    {
                        @Html.ActionLink("Stampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-print" })
                        @Html.ActionLink("Fakturisano", "Invoice", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-invoice" })
                    }
                    @if (item.CaseStatus == CaseStatus.LightBlue)
                    {
                        @Html.ActionLink("Stampa", "Print", "AcceptCase", new { CaseID = item.ID }, new { @class = "act-btn act-print" })
                    }
                    @Html.ActionLink("Detalji", "Details", new { id = item.ID }, new { @class = "act-btn act-details" })
                    @Html.ActionLink("Izbrisi", "Delete", new { id = item.ID }, new { @class = "act-btn act-delete" })
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <small class="text-muted">Strana @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) od @Model.PageCount (@Model.TotalItemCount ukupno)</small>
    <nav>
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, status = ViewBag.CurrentStatus, currentFilter = ViewBag.CurrentFilter }),
            new PagedListRenderOptions
            {
                UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" },
                ActiveLiElementClass = "active",
                DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
                DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
                DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                DisplayLinkToNextPage = PagedListDisplayMode.Always,
                MaximumPageNumbersToDisplay = 10
            })
    </nav>
</div>
