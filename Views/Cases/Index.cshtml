@model X.PagedList.IPagedList<ServiserOnline.Models.Case>
@using X.PagedList.Mvc.Core
@using ServiserOnline.Models

@{
    ViewBag.Title = "Intervencije";

    string cur = ViewBag.CurrentStatus as string ?? "";

    string StatusColor(CaseStatus s) => s switch
    {
        CaseStatus.Yellow => "#f5c842", // non assigned
        CaseStatus.Orange => "#f58c1a", // assigned
        CaseStatus.LightGreen => "#2e7d32", // not finished successfully -> green
        CaseStatus.Green => "#2e7d32", // finished successfully -> green
        CaseStatus.LightBlue => "#0288d1", // paid
        CaseStatus.Black => "#444",
        _ => "#b8bec8"
    };

    string StatusLabel(CaseStatus s) => s switch
    {
        CaseStatus.Yellow => "Primljen",
        CaseStatus.Orange => "Prihvaćen",
        CaseStatus.LightGreen => "Neuspj. završen",
        CaseStatus.Green => "Uspj. završen",
        CaseStatus.LightBlue => "Fakturisan",
        CaseStatus.Black => "Odbijen",
        _ => s.ToString()
    };

    string StatusBadgeClass(CaseStatus s) => s switch
    {
        CaseStatus.Yellow => "sp-badge-warn",
        CaseStatus.Orange => "sp-badge-warn",
        CaseStatus.LightGreen => "sp-badge-ok",
        CaseStatus.Green => "sp-badge-ok",
        CaseStatus.LightBlue => "sp-badge-info",
        CaseStatus.Black => "sp-badge-neutral",
        _ => "sp-badge-neutral"
    };

    string StatusRowClass(CaseStatus s) => s switch
    {
        CaseStatus.Yellow => "case-status-yellow",
        CaseStatus.Orange => "case-status-orange",
        CaseStatus.LightGreen => "case-status-lightgreen",
        CaseStatus.Green => "case-status-green",
        CaseStatus.LightBlue => "case-status-lightblue",
        CaseStatus.Black => "case-status-black",
        _ => "case-status-neutral"
    };

    string ActionButtonClass(ActionMenuItem item)
    {
        var variant = item?.Variant ?? "";
        return variant == "danger"
            ? "sp-btn sp-btn-xs sp-btn-danger"
            : "sp-btn sp-btn-xs sp-btn-ghost";
    }

    List<ActionMenuItem> BuildCaseMenu(Case item)
    {
        var menu = new List<ActionMenuItem>();

        if (item.CaseStatus == CaseStatus.Yellow || item.CaseStatus == CaseStatus.Orange)
        {
            menu.Add(new ActionMenuItem { Text = "Uređaji", OnClick = $"openCaseAjaxModal('Uređaji', '{Url.Action("AddDevice", "Cases", new { id = item.ID })}', 'device', '{item.ID}')" });
            menu.Add(new ActionMenuItem { Text = "Dijelovi", OnClick = $"openCaseAjaxModal('Rezervni dijelovi', '{Url.Action("AddSpare", "Cases", new { id = item.ID })}', 'spare', '{item.ID}')" });
        }

        if (item.CaseStatus == CaseStatus.Yellow)
            menu.Add(new ActionMenuItem { Text = "Prihvati", Url = Url.Action("Index", "AcceptCase", new { CaseID = item.ID }) });

        if (item.CaseStatus == CaseStatus.Orange || item.CaseStatus == CaseStatus.LightGreen)
            menu.Add(new ActionMenuItem { Text = "Izvještaj", Url = Url.Action("OnSite", "AcceptCase", new { CaseID = item.ID }) });

        if (item.CaseStatus is CaseStatus.LightGreen or CaseStatus.Green or CaseStatus.LightBlue)
            menu.Add(new ActionMenuItem { Text = "Štampa", OnClick = $"printCaseReport('{item.ID}')" });

        if (item.CaseStatus == CaseStatus.Green)
            menu.Add(new ActionMenuItem { Text = "Rezervni dijelovi", Url = Url.Action("Details", "Cases", new { id = item.ID }) + "#details-spares-entry" });

        menu.Add(new ActionMenuItem { Text = "Detalji", Url = Url.Action("Details", "Cases", new { id = item.ID }) });
        menu.Add(new ActionMenuItem { Text = "Izbriši", OnClick = $"openCaseDeleteModal('{item.ID}', {System.Text.Json.JsonSerializer.Serialize(item.CaseServisNumber ?? "-")}, {System.Text.Json.JsonSerializer.Serialize(item.Client?.Name ?? "-")})", Variant = "danger" });

        return menu;
    }

    var headerModel = new HeaderViewModel
    {
        Title = "Intervencije",
        MetaText = $"{Model.TotalItemCount} ukupno",
        ShowSearch = true,
        SearchName = "searchString",
        SearchValue = ViewBag.CurrentFilter as string,
        SearchPlaceholder = "Pretraži po korisniku ili br. izvještaja...",
        FormAction = "Index",
        FormController = "Cases",
        HiddenFields = new Dictionary<string, string> { ["status"] = cur },
        ShowAddButton = true,
        AddButtonText = "+ Nova intervencija",
        AddButtonOnClick = $"window.location='{Url.Action("Create", "Cases")}'",
        RowCount = Model.TotalItemCount,
        ShowDropdownFilter = false,
        FilterButtons = new List<FilterButton>
        {
            new() { Text = "Svi aktivni",          Url = Url.Action("Index", "Cases"),                                  Active = cur == ""            },
            new() { Text = "Primljeni",            Url = Url.Action("Index", "Cases", new { status = "yellow" }),      Active = cur == "yellow",     Variant = "yellow" },
            new() { Text = "Prihvaćeni",           Url = Url.Action("Index", "Cases", new { status = "orange" }),      Active = cur == "orange",     Variant = "orange" },
            new() { Text = "Neuspješno završeni",  Url = Url.Action("Index", "Cases", new { status = "lightgreen" }),  Active = cur == "lightgreen", Variant = "green"  },
            new() { Text = "Uspješno završeni",    Url = Url.Action("Index", "Cases", new { status = "green" }),       Active = cur == "green",      Variant = "green"  },
            new() { Text = "Fakturisani",          Url = Url.Action("Index", "Cases", new { status = "lightblue" }),   Active = cur == "lightblue",  Variant = "blue"   },
        }
    };
}

<div class="sp-page-wrap">
    <partial name="_Header" model="headerModel" />

    <div class="sp-modal-scrim" id="caseAjaxScrim" onclick="closeCaseAjaxModal()"></div>
    <div class="sp-modal sp-modal-lg" id="caseAjaxModal">
        <div id="caseAjaxModalBody">
            <div class="sp-modal-loading">Učitavanje...</div>
        </div>
    </div>

    <div class="sp-modal-scrim" id="caseDeleteScrim" onclick="closeCaseDeleteModal()"></div>
    <div class="sp-modal sp-modal-sm sp-case-delete-modal" id="caseDeleteModal" role="dialog" aria-modal="true" aria-labelledby="caseDeleteTitle">
        <form method="post" id="caseDeleteForm">
            @Html.AntiForgeryToken()
            <div class="sp-modal-head">
                <div>
                    <div class="sp-modal-title" id="caseDeleteTitle">Izbriši intervenciju</div>
                    <div class="sp-modal-sub" id="caseDeleteSub">Potvrda brisanja</div>
                </div>
                <button type="button" class="sp-iconbtn" onclick="closeCaseDeleteModal()" aria-label="Zatvori">×</button>
            </div>
            <div class="sp-modal-body">
                <div class="sp-delete-warning">
                    <div class="sp-danger-icon">!</div>
                    <div>
                        <div class="sp-delete-warning-title">Ova akcija uklanja nalog iz aktivne liste.</div>
                        <div class="sp-delete-warning-text">Radni nalog neće biti prikazan na indeks stranici. Potvrdi samo ako stvarno želiš ukloniti ovaj nalog.</div>
                    </div>
                </div>

                <div class="sp-delete-summary">
                    <div>
                        <span class="sp-delete-label">Br. izvještaja</span>
                        <strong id="caseDeleteNumber">-</strong>
                    </div>
                    <div>
                        <span class="sp-delete-label">Korisnik</span>
                        <strong id="caseDeleteClient">-</strong>
                    </div>
                </div>
            </div>
            <div class="sp-modal-foot">
                <button type="button" class="sp-btn sp-btn-ghost" onclick="closeCaseDeleteModal()">Odustani</button>
                <button type="submit" class="sp-btn sp-btn-danger">Izbriši</button>
            </div>
        </form>
    </div>

    <div class="sp-tablewrap d-none d-xl-block">
        <table class="sp-table sp-cases-table sp-cases-two-row-table" id="cases-table">
            <thead>
                <tr>
                    <th class="sp-case-status-col"></th>
                    <th style="width: 130px;">Br. izvještaja</th>
                    <th>Korisnik</th>
                    <th style="width: 115px;">Datum prijema</th>
                    <th style="width: 115px;">Planirani datum</th>
                    <th style="width: 115px;">Datum završetka</th>
                    <th style="width: 220px;">Vrsta usluge</th>
                    <th style="width: 150px;">Serviser</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var rowClass = StatusRowClass(item.CaseStatus);

                    <tr class="sp-case-main-row @rowClass sp-case-clickable-row"
                        data-case-id="@item.ID"
                        data-case-detail-url="@Url.Action("Details", "Cases", new { id = item.ID })"
                        tabindex="0"
                        role="button">
                        <td class="sp-case-state-strip" rowspan="2" style="--case-color:@StatusColor(item.CaseStatus);"></td>

                        <td class="sp-case-cell-number">
                            @if (!string.IsNullOrEmpty(item.CaseServisNumber))
                            {
                                <span class="sp-row-title">@item.CaseServisNumber</span>
                            }
                            else
                            {
                                <span class="sp-muted">-</span>
                            }
                        </td>

                        <td class="sp-case-cell-client">
                            @Html.ActionLink(
                                item.Client?.Name ?? "-",
                                "Edit",
                                "Clients",
                                new { id = item.Client?.ID },
                                new { target = "_blank", @class = "sp-link" }
                            )
                        </td>

                        <td>
                            @(item.DateTimeCaseOpened.HasValue ? item.DateTimeCaseOpened.Value.ToString("dd/MM/yy") : "-")
                        </td>

                        <td>
                            @(item.DateTimePlanned.HasValue ? item.DateTimePlanned.Value.ToString("dd/MM/yy") : "-")
                        </td>

                        <td>
                            @(item.DateTimeServiced.HasValue ? item.DateTimeServiced.Value.ToString("dd/MM/yy") : "-")
                        </td>

                        <td>
                            @(!string.IsNullOrWhiteSpace(item.InterventionType?.Name) ? item.InterventionType.Name : "-")
                        </td>

                        <td>
                            @(!string.IsNullOrWhiteSpace(item.ServicePerson) ? item.ServicePerson : "-")
                        </td>
                    </tr>

                    <tr class="sp-case-footer-row @rowClass sp-case-clickable-row"
                        data-case-id="@item.ID"
                        data-case-detail-url="@Url.Action("Details", "Cases", new { id = item.ID })"
                        tabindex="0"
                        role="button">
                        <td colspan="7" class="sp-case-footer-cell">
                            <div class="sp-case-footer">
                                <div class="sp-case-footer-left">
                                    <span class="sp-badge @StatusBadgeClass(item.CaseStatus)">
                                        @StatusLabel(item.CaseStatus)
                                    </span>
                                </div>

                                <div class="sp-case-footer-right">
                                    @if (item.CaseStatus == CaseStatus.Yellow || item.CaseStatus == CaseStatus.Orange)
                                    {
                                        <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost" onclick="openDeviceModal('@item.ID')">
                                            Uređaji
                                        </button>

                                        <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost" onclick="openSpareModal('@item.ID')">
                                            Dijelovi
                                        </button>
                                    }

                                    @if (item.CaseStatus == CaseStatus.Yellow)
                                    {
                                        @Html.ActionLink(
                                            "Prihvati",
                                            "Index",
                                            "AcceptCase",
                                            new { CaseID = item.ID },
                                            new { @class = "sp-btn sp-btn-xs sp-btn-primary" }
                                        )
                                    }

                                    @if (item.CaseStatus == CaseStatus.Orange || item.CaseStatus == CaseStatus.LightGreen)
                                    {
                                        @Html.ActionLink(
                                            "Izvještaj",
                                            "OnSite",
                                            "AcceptCase",
                                            new { CaseID = item.ID },
                                            new { @class = "sp-btn sp-btn-xs sp-btn-primary" }
                                        )
                                    }

                                    @if (item.CaseStatus is CaseStatus.LightGreen or CaseStatus.Green or CaseStatus.LightBlue)
                                    {
                                        <button type="button"
                                                class="sp-btn sp-btn-xs sp-btn-ghost"
                                                onclick="printCaseReport('@item.ID')">
                                            Štampa
                                        </button>
                                    }

                                    @if (item.CaseStatus == CaseStatus.Green || item.CaseStatus == CaseStatus.LightGreen)
                                    {
                                        <a class="sp-btn sp-btn-xs sp-btn-ghost" href="@(Url.Action("Details", "Cases", new { id = item.ID }) + "#details-spares-entry")">
                                            Rezervni dijelovi
                                        </a>
                                    }

                                    @Html.ActionLink(
                                        "Detalji",
                                        "Details",
                                        new { id = item.ID },
                                        new { @class = "sp-btn sp-btn-xs sp-btn-ghost" }
                                    )

                                    <button type="button"
                                            class="sp-btn sp-btn-xs sp-btn-danger"
                                            onclick="openCaseDeleteModal('@item.ID', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.CaseServisNumber ?? "-")), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Client?.Name ?? "-")))">
                                        Izbriši
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-xl-none sp-mobile-list">
        @foreach (var item in Model)
        {
            var mobileMenu = BuildCaseMenu(item);

            var cardModel = new CardItemViewModel
            {
                Title = item.Client?.Name ?? "-",
                Subtitle = string.IsNullOrWhiteSpace(item.CaseServisNumber) ? "Bez broja izvještaja" : item.CaseServisNumber,
                BadgeText = StatusLabel(item.CaseStatus),
                BadgeClass = StatusBadgeClass(item.CaseStatus),
                MetaLeft = item.DateTimePlanned.HasValue ? "Planirani: " + item.DateTimePlanned.Value.ToString("dd/MM/yyyy") : "Prijem: " + (item.DateTimeCaseOpened.HasValue ? item.DateTimeCaseOpened.Value.ToString("dd/MM/yyyy") : "-"),
                MetaRight = string.IsNullOrWhiteSpace(item.ServicePerson) ? item.InterventionType?.Name : item.ServicePerson,
                MenuItems = mobileMenu
            };

            <div class="sp-case-card @StatusRowClass(item.CaseStatus) sp-case-clickable-card"
                 data-case-id="@item.ID"
                 data-case-detail-url="@Url.Action("Details", "Cases", new { id = item.ID })"
                 tabindex="0"
                 role="button">
                <partial name="CardItem" model="cardModel" />
            </div>
        }
    </div>

    <div class="sp-paginator">
        <small class="sp-muted">Strana @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) od @Model.PageCount (@Model.TotalItemCount ukupno)</small>
        <nav>
            @Html.PagedListPager(Model, page => Url.Action("Index", "Cases", new { page, status = ViewBag.CurrentStatus, currentFilter = ViewBag.CurrentFilter }),
                new PagedListRenderOptions
                {
                    UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" },
                    ActiveLiElementClass = "active",
                    DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
                    DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
                    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                    DisplayLinkToNextPage = PagedListDisplayMode.Always,
                    MaximumPageNumbersToDisplay = 10
                })
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        let activeCaseModalKind = null;
        let activeCaseModalCaseId = null;

        function truncateCaseOption(text, maxLength) {
            const value = text || '';
            if (value.length <= maxLength) return value;
            return value.substring(0, maxLength - 1) + '…';
        }

        function openCaseModalShell() {
            document.getElementById('caseAjaxScrim').classList.add('open');
            document.getElementById('caseAjaxModal').classList.add('open');
            document.body.classList.add('sp-modal-open');
        }

        function openCaseDeleteModal(caseId, caseNumber, clientName) {
            if (typeof closeAllMenus === 'function') closeAllMenus();

            const form = document.getElementById('caseDeleteForm');
            form.action = `/Cases/Delete/${encodeURIComponent(caseId)}`;

            document.getElementById('caseDeleteNumber').textContent = caseNumber || '-';
            document.getElementById('caseDeleteClient').textContent = clientName || '-';
            document.getElementById('caseDeleteSub').textContent = `${clientName || '-'} · ${caseNumber || '-'}`;

            document.getElementById('caseDeleteScrim').classList.add('open');
            document.getElementById('caseDeleteModal').classList.add('open');
            document.body.classList.add('sp-modal-open');
        }

        function closeCaseDeleteModal() {
            document.getElementById('caseDeleteScrim').classList.remove('open');
            document.getElementById('caseDeleteModal').classList.remove('open');
            document.body.classList.remove('sp-modal-open');
        }

        function closeCaseAjaxModal() {
            document.getElementById('caseAjaxScrim').classList.remove('open');
            document.getElementById('caseAjaxModal').classList.remove('open');
            document.body.classList.remove('sp-modal-open');
            document.getElementById('caseAjaxModalBody').innerHTML = '<div class="sp-modal-loading">Učitavanje...</div>';
            activeCaseModalKind = null;
            activeCaseModalCaseId = null;
        }

        function openDeviceModal(caseId) {
            openCaseAjaxModal('Uređaji', `/Cases/AddDevice?id=${encodeURIComponent(caseId)}`, 'device', caseId);
        }

        function openSpareModal(caseId) {
            openCaseAjaxModal('Rezervni dijelovi', `/Cases/AddSpare?id=${encodeURIComponent(caseId)}`, 'spare', caseId);
        }

        function setCaseAjaxBody(html) {
            const body = document.getElementById('caseAjaxModalBody');
            body.innerHTML = html;
            initCaseModalContent();
        }

        function openCaseAjaxModal(title, url, kind, caseId) {
            if (typeof closeAllMenus === 'function') closeAllMenus();
            activeCaseModalKind = kind;
            activeCaseModalCaseId = caseId;

            const body = document.getElementById('caseAjaxModalBody');
            body.innerHTML = '<div class="sp-modal-loading">Učitavanje...</div>';
            openCaseModalShell();

            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => setCaseAjaxBody(html))
                .catch(() => {
                    body.innerHTML = '<div class="sp-modal-panel"><div class="sp-modal-body"><div class="sp-alert-error">Greška pri učitavanju.</div></div></div>';
                });
        }

        function reloadCaseAjaxModal() {
            if (!activeCaseModalKind || !activeCaseModalCaseId) return;
            const action = activeCaseModalKind === 'spare' ? 'AddSpare' : 'AddDevice';
            openCaseAjaxModal('', `/Cases/${action}?id=${encodeURIComponent(activeCaseModalCaseId)}`, activeCaseModalKind, activeCaseModalCaseId);
        }

        function initCaseModalContent() {
            const modelSelect = document.getElementById('Models');
            if (modelSelect && modelSelect.value) {
                loadCaseSpares(modelSelect.value);
            }

            const spareSelect = document.getElementById('Spares');
            if (spareSelect) {
                updateAmountMaxFromSelectedSpare();
            }
        }

        function loadCaseDevices(locationId) {
            const sel = document.getElementById('Device');
            if (!sel) return;

            if (!locationId) {
                sel.innerHTML = '<option value="">-- Odaberi lokaciju prvo --</option>';
                return;
            }

            sel.innerHTML = '<option value="">Učitavanje...</option>';

            const url = `/Cases/GetDevicesList?SelectedLocation=${encodeURIComponent(locationId)}&caseId=${encodeURIComponent(activeCaseModalCaseId || '')}`;
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    sel.innerHTML = '<option value="">-- Odaberi uređaj --</option>';

                    if (!data || data.length === 0) {
                        sel.innerHTML = '<option value="">Nema dostupnih uređaja za ovu lokaciju</option>';
                        return;
                    }

                    data.forEach(row => {
                        const opt = document.createElement('option');
                        opt.value = row.id;
                        const deviceText = `${row.manufacturerName || ''} / ${row.modelName || ''} / ${row.serialNumber || ''}`;
                        opt.textContent = truncateCaseOption(deviceText, 90);
                        opt.title = deviceText;
                        sel.appendChild(opt);
                    });
                })
                .catch(() => { sel.innerHTML = '<option value="">Greška pri učitavanju</option>'; });
        }

        function loadCaseSpares(modelId) {
            const sel = document.getElementById('Spares');
            if (!sel) return;

            if (!modelId) {
                sel.innerHTML = '<option value="">-- Odaberi model prvo --</option>';
                updateAmountMaxFromSelectedSpare();
                return;
            }

            sel.innerHTML = '<option value="">Učitavanje...</option>';

            const url = `/Cases/GetSparesList?SelectedModel=${encodeURIComponent(modelId)}&caseId=${encodeURIComponent(activeCaseModalCaseId || '')}`;
            fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    sel.innerHTML = '<option value="">-- Odaberi rezervni dio --</option>';

                    if (!data || data.length === 0) {
                        sel.innerHTML = '<option value="">Nema dostupnih dijelova za ovaj model</option>';
                        updateAmountMaxFromSelectedSpare();
                        return;
                    }

                    data.forEach(row => {
                        const opt = document.createElement('option');
                        opt.value = row.id;
                        opt.dataset.stock = row.stockAmount;
                        const catalog = row.catalogNumber ? ` / ${row.catalogNumber}` : '';
                        const fullText = `${row.modelName || ''} · ${row.name || ''}${catalog} / Stanje: ${row.stockAmount}`;
                        const shortText = `${row.name || ''}${catalog} / Stanje: ${row.stockAmount}`;
                        opt.textContent = truncateCaseOption(shortText, 95);
                        opt.title = fullText;
                        sel.appendChild(opt);
                    });

                    updateAmountMaxFromSelectedSpare();
                })
                .catch(() => {
                    sel.innerHTML = '<option value="">Greška pri učitavanju</option>';
                    updateAmountMaxFromSelectedSpare();
                });
        }

        function updateAmountMaxFromSelectedSpare() {
            const spareSelect = document.getElementById('Spares');
            const amount = document.getElementById('Amount');
            if (!spareSelect || !amount) return;

            const opt = spareSelect.options[spareSelect.selectedIndex];
            const stock = opt && opt.dataset ? parseFloat(opt.dataset.stock || '') : NaN;

            if (!Number.isFinite(stock) || stock <= 0) {
                amount.removeAttribute('max');
                return;
            }

            amount.max = String(Math.floor(stock));
            if (parseFloat(amount.value || '0') > stock) {
                amount.value = String(Math.floor(stock));
            }
        }

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { closeCaseAjaxModal(); closeCaseDeleteModal(); }
        });

        document.getElementById('caseAjaxModalBody').addEventListener('change', function (e) {
            if (e.target.id === 'LocationID') {
                loadCaseDevices(e.target.value);
            }

            if (e.target.id === 'Models') {
                loadCaseSpares(e.target.value);
            }

            if (e.target.id === 'Spares') {
                updateAmountMaxFromSelectedSpare();
            }
        });

        document.getElementById('caseAjaxModalBody').addEventListener('input', function (e) {
            if (e.target.id !== 'Amount') return;

            const max = parseFloat(e.target.max || '');
            const val = parseFloat(e.target.value || '');
            if (Number.isFinite(max) && Number.isFinite(val) && val > max) {
                e.target.value = String(Math.floor(max));
            }
        });

        document.getElementById('caseAjaxModalBody').addEventListener('submit', function (e) {
            const form = e.target;
            if (!form.matches('[data-case-modal-form]')) return;

            e.preventDefault();

            const submitter = e.submitter;
            const formData = new FormData(form);
            if (submitter && submitter.name) formData.append(submitter.name, submitter.value || 'true');

            fetch(form.action, {
                method: form.method || 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(async r => {
                    if (r.redirected && r.url.includes('/AcceptCase/')) {
                        window.location.href = r.url;
                        return null;
                    }
                    return await r.text();
                })
                .then(html => {
                    if (html !== null) setCaseAjaxBody(html);
                })
                .catch(() => {
                    document.getElementById('caseAjaxModalBody').insertAdjacentHTML('afterbegin', '<div class="sp-alert-error">Greška pri snimanju.</div>');
                });
        });

        document.getElementById('caseAjaxModalBody').addEventListener('click', function (e) {
            const link = e.target.closest('[data-case-modal-link]');
            if (!link) return;

            e.preventDefault();

            fetch(link.href, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.text())
                .then(html => setCaseAjaxBody(html))
                .catch(() => {
                    document.getElementById('caseAjaxModalBody').insertAdjacentHTML('afterbegin', '<div class="sp-alert-error">Greška pri uklanjanju.</div>');
                });
        });



        function printCaseReport(caseId) {
            if (!caseId) return;
            window.open('/AcceptCase/Print?CaseID=' + encodeURIComponent(caseId) + '&autoPdf=true', '_blank', 'noopener');
        }

        function isInteractiveCaseTarget(target) {
            return !!target.closest('a, button, input, select, textarea, label, form, .sp-action-menu, .sp-action-menu-wrap, .sp-menu, .sp-menu-item, [data-case-modal-link], [data-no-row-open]');
        }

        function setCasePairHover(caseId, isHovered) {
            if (!caseId) return;
            document.querySelectorAll(`[data-case-id="${caseId}"]`).forEach(row => {
                row.classList.toggle('sp-case-pair-hover', isHovered);
            });
        }

        document.querySelectorAll('#cases-table .sp-case-clickable-row').forEach(row => {
            row.addEventListener('mouseenter', function () {
                setCasePairHover(this.dataset.caseId, true);
            });

            row.addEventListener('mouseleave', function () {
                setCasePairHover(this.dataset.caseId, false);
            });
        });

        document.addEventListener('click', function (e) {
            const target = e.target;
            if (isInteractiveCaseTarget(target)) return;

            const clickable = target.closest('.sp-case-clickable-row, .sp-case-clickable-card');
            if (!clickable) return;

            const url = clickable.dataset.caseDetailUrl;
            if (url) window.location.href = url;
        });

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;

            const clickable = e.target.closest('.sp-case-clickable-row, .sp-case-clickable-card');
            if (!clickable) return;
            if (isInteractiveCaseTarget(e.target)) return;

            e.preventDefault();
            const url = clickable.dataset.caseDetailUrl;
            if (url) window.location.href = url;
        });

    </script>
}
