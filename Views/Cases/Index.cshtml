        {*@
            @*<table>
        <tr>
            <td>*@
            @Html.ActionLink("Uredjaji", "AddDevice", new { id = item.ID }) |
            @*</td>
        <td>*@
            @Html.ActionLink("Dijelovi", "AddSpare", new { id = item.ID }) |
            @*</td>
        <td>*@

            @*</td>
        <td>*@
            @Html.ActionLink("Prihvati", "Index", "AcceptCase", new { CaseID = item.ID }, null) |
            @*</td>
        <td>*@
            @Html.ActionLink("Izvještaj", "OnSite", "AcceptCase", new { CaseID = item.ID }, null) |
            @*</td>
        <td>*@
            @if ((item.CaseStatus == ServiserOnline.Models.CaseStatus.Green) || (item.CaseStatus == ServiserOnline.Models.CaseStatus.LightGreen) || (item.CaseStatus == ServiserOnline.Models.CaseStatus.LightBlue))
            {
                @Html.ActionLink("Štampa |", "Print", "AcceptCase", new { CaseID = item.ID }, null);
            }
            @*</td>
        <td>*@
            @if (item.CaseStatus == ServiserOnline.Models.CaseStatus.Green)
            {
                @Html.ActionLink("Fakturisano |", "Invoice", "AcceptCase", new { CaseID = item.ID }, null);
}

            @Html.ActionLink("Detalji", "Details", new { id = item.ID }) |
            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID })
            @*</td>
            </tr>
        </table>*@
