@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Create";
}

<h2>Nova intervencija</h2>
<script>
    $(document).ready(function () {
        $("#Client").change(function () {
            $.get("/Cases/GetLocationsList", { SelectedClient: $("#Client").val() }, function (data) {
                $("#Location").empty();
                $.each(data, function (index, row) {
                    $("#Location").append("<option value='" + row.ID + "'>" + row.LocationName + "</option>")
                });
            });
        })
    });
    $(document).ready(function () {
        $("#Location").change(function () {
            $.get("/Cases/GetDevicesList", { SelectedLocation: $("#Location").val() }, function (data) {
                $("#Device").empty();
                $.each(data, function (index, row) {
                    $("#Device").append("<option value='" + row.ID + "'>" + row.Device.SerialNumber + "</option>")
                });
            });
        })
    });
</script>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ID)
    <div class="form-group">
        @Html.LabelFor(model => model.ContactType, "Tip kontakta", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ContactType, ViewBag.ContactType as SelectList, "-- Odaberi tip kontakta --", new { @class = "form-control" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.InterventionType, "Vrsta usluge", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.InterventionType, ViewBag.InterventionType as SelectList, "-- Odaberi vrstu usluge --", new { @class = "form-control" })
        </div>
    </div>
    <br />
    <div class="form-group">
        @Html.LabelFor(model => model.DateTimeCaseOpened, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.DateTimeCaseOpened, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.DateTimeCaseOpened, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(model => model.ContractNo, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.ContractNo, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger" })
        </div>
    </div>
    <br />

    <div class="form-group">
        @Html.LabelFor(model => model.Client, "Korisnik", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.Client, ViewBag.Client as SelectList, "-- Odaberi korisnika --", new { @class = "form-control" })
        </div>
    </div>
    <br />
    <div class="form-group">
        @Html.LabelFor(model => model.AcceptingDescription, "Opis", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.AcceptingDescription)
        </div>
    </div>
    <br />
    <div class="form-group">
        @Html.LabelFor(model => model.ContinuedFromCase, "Nastavak intervencije", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ContinuedFromCase, ViewBag.ContinuedFromCase as SelectList, "-- Odaberi intervenciju --", new { @class = "form-control" })
        </div>
    </div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Kreiraj" class="btn btn-default" />
        </div>
    </div>
</div>
    }

    <div>
        @Html.ActionLink("Back to List", "Index")
    </div>

    @section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    }
