@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Nova intervencija";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Nova intervencija</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)

            <div class="mb-3">
                <label class="form-label fw-semibold">Tip kontakta</label>
                @Html.DropDownListFor(model => model.ContactType, ViewBag.ContactType as SelectList, "-- Odaberi tip kontakta --", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Vrsta usluge</label>
                @Html.DropDownListFor(model => model.InterventionType, ViewBag.InterventionType as SelectList, "-- Odaberi vrstu usluge --", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateTimeCaseOpened, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.DateTimeCaseOpened, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.DateTimeCaseOpened, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.ContractNo, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.ContractNo, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.ContractNo, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Korisnik</label>
                @Html.DropDownListFor(model => model.Client, ViewBag.Client as SelectList, "-- Odaberi korisnika --", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.AcceptingDescription, "Opis na prijemu", new { @class = "form-label fw-semibold" })
                @Html.TextAreaFor(model => model.AcceptingDescription, new { @class = "form-control", rows = "3" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Nastavak intervencije</label>
                @Html.DropDownListFor(model => model.ContinuedFromCase, ViewBag.ContinuedFromCase as SelectList, "-- Odaberi intervenciju --", new { @class = "form-select" })
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Kreiraj" class="btn btn-primary" />
                @Html.ActionLink("Odustani", "Index", "Cases", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
