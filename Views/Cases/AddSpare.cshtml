@model ServiserOnline.Models.Case

@{
    Layout = null;
}

<div class="sp-modal-panel sp-case-modal-panel">
    <div class="sp-modal-head">
        <div>
            <div class="sp-modal-title">Rezervni dijelovi</div>
            <div class="sp-modal-sub">
                @(Model.Client?.Name ?? "-")
                @if (Model.DateTimeCaseOpened.HasValue)
                {
                    <span> · @Model.DateTimeCaseOpened.Value.ToString("dd/MM/yyyy")</span>
                }
            </div>
        </div>

        <button type="button" class="sp-iconbtn" aria-label="Zatvori" onclick="closeCaseAjaxModal()">×</button>
    </div>

    <div class="sp-modal-body">
        @if (!ViewData.ModelState.IsValid)
        {
            @Html.ValidationSummary(false, "", new { @class = "sp-alert-error" })
        }

        @if (Model.Devices?.Any() != true)
        {
            <div class="sp-alert-info">Prvo dodaj uređaj u radni nalog. Rezervni dijelovi se prikazuju prema modelima dodanih uređaja.</div>
        }
        else
        {
            @using (Html.BeginForm("AddSpare", "Cases", FormMethod.Post, new { data_case_modal_form = "spare", @class = "sp-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.ID)

                <div class="sp-field">
                    <label class="sp-label" for="Models">Model uređaja</label>
                    @Html.DropDownList("Models", null, new { @class = "sp-input", id = "Models" })
                    <div class="sp-help-text">Lista sadrži samo modele uređaja koji su dodani u ovaj radni nalog.</div>
                </div>

                <div class="sp-field">
                    <label class="sp-label" for="Spares">Rezervni dio</label>
                    <select id="Spares" name="Spares" class="sp-input sp-truncate-select">
                        <option value="">-- Odaberi model prvo --</option>
                    </select>
                    <div class="sp-help-text">Prikazuju se dijelovi za izabrani model i opći rezervni dijelovi istog proizvođača.</div>
                </div>

                <div class="sp-form-grid-2">
                    <div class="sp-field">
                        <label class="sp-label" for="Amount">Količina</label>
                        <input id="Amount" type="number" name="Amount" class="sp-input" min="1" step="1" value="1" />
                    </div>

                    <div class="sp-field">
                        <label class="sp-label" for="Note">Napomena</label>
                        <input id="Note" type="text" name="Note" class="sp-input" />
                    </div>
                </div>

                <div class="sp-modal-foot sp-modal-foot-inline">
                    <button type="submit" class="sp-btn sp-btn-primary sp-btn-sm">+ Dodaj dio</button>
                </div>
            }
        }

        <div class="sp-modal-section-title">Dodati dijelovi</div>

        @if (Model.SpareParts?.Any() == true)
        {
            <div class="sp-mini-table-wrap">
                <table class="sp-mini-table sp-fixed-mini-table">
                    <thead>
                        <tr>
                            <th>Naziv</th>
                            <th style="width: 90px;" class="sp-text-right">Kol.</th>
                            <th style="width: 86px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SpareParts)
                        {
                            <tr>
                                <td class="sp-ellipsis-cell">
                                    <span class="sp-muted sp-mini-sub">@(item.SparePart?.Model?.Name ?? "-")</span>
                                    <strong>@(item.SparePart?.Name ?? "-")</strong>
                                </td>
                                <td class="sp-text-right"><strong>@item.Amount</strong></td>
                                <td class="sp-mini-actions">
                                    <a class="sp-btn sp-btn-xs sp-btn-danger"
                                           data-case-modal-link="spare"
                                           href="@Url.Action("RemoveSpare", "Cases", new { ID = item.ID, caseID = Model.ID })">
                                        Ukloni
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="sp-empty-mini">Nema dodatih dijelova.</div>
        }
    </div>
</div>
