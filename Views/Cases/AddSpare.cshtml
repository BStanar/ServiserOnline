@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "Dodavanje rezervnih dijelova";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Dodavanje rezervnih dijelova</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
            @Html.HiddenFor(model => model.ID)

            <div class="mb-3">
                @Html.LabelFor(model => model.Client.Name, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.Client.Name, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.DateTimeCaseOpened, new { @class = "form-label fw-semibold" })
                <div>@Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeCaseOpened))</div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Model uređaja</label>
                @Html.DropDownList("Models", null, new { @class = "form-select" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Rezervni dio</label>
                @Html.DropDownList("Spares", new SelectList(" "), "", new { @class = "form-select" })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Količina</label>
                @Html.Editor("Amount", new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Napomena</label>
                @Html.Editor("Note", new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="mb-4">
                <input type="submit" formaction="AddSpare" formmethod="post" value="Dodaj dio" class="btn btn-primary" />
            </div>
        }

        @if (Model.SpareParts != null && Model.SpareParts.Count > 0)
        {
            <h5 class="mb-2">Dodati dijelovi</h5>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Model</th>
                            <th>Ime</th>
                            <th>Kataloski br.</th>
                            <th>Kolicina</th>
                            <th>Napomena</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SpareParts)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.SparePart.Model.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.SparePart.Name)</td>
                                <td>@Html.DisplayFor(modelItem => item.SparePart.SerialNumber)</td>
                                <td>@Html.DisplayFor(modelItem => item.Amount)</td>
                                <td>@Html.DisplayFor(modelItem => item.Note)</td>
                                <td>
                                    @Html.ActionLink("Izbriši", "RemoveSpare", new { ID = item.ID, caseID = Model.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">Nema dodatih dijelova.</p>
        }

        <div class="mt-3">
            @Html.ActionLink("← Nazad na listu", "Index", "Cases", null, new { @class = "btn btn-outline-secondary btn-sm" })
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.getElementById('Models').addEventListener('change', function () {
            fetch('/Cases/GetSparesList?SelectedModel=' + this.value)
                .then(r => r.json())
                .then(data => {
                    const sel = document.getElementById('Spares');
                    sel.innerHTML = '';
                    data.forEach(row => {
                        const opt = document.createElement('option');
                        opt.value = row.id;
                        opt.textContent = row.name + ' - ' + row.serialNumber + ' - Stanje: ' + row.stockAmount;
                        sel.appendChild(opt);
                    });
                });
        });
    </script>
}
