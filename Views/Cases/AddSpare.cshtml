@model ServiserOnline.Models.Case

@{
    ViewBag.Title = "AddSpare";
}
<script>
    $(document).ready(function () {
        $("#Models").change(function () {
            $.get("/Cases/GetSparesList", { SelectedModel: $("#Models").val() }, function (data) {
                $("#Spares").empty();
                $.each(data, function (index, row) {
                    $("#Spares").append("<option value='" + row.ID + "'>" + row.Name + " - " + row.SerialNumber + " - Stanje: " + row.StockAmount +"</option>")
                });
            });
        })
    });

</script>
<h2>Dodavanje rezervnih dijelova intervenciji</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <br />
    <div class="form-horizontal">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(Model => Model.ID)
        <br />

        <div class="form-group">
            @Html.LabelFor(model => model.Client.Name, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Client.Name, new { htmlAttributes = new { @class = "form-control", disabled = "disabled", @readonly = "readonly" } })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.DateTimeCaseOpened, htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Convert.ToString(string.Format("{0:dd/MM/yyyy}", Model.DateTimeCaseOpened))
            </div>
        </div>

        <div class="form-group">
            <div class="control-label col-md-2">
                Uredjaji
            </div>
            <div class="col-md-10">
                @Html.DropDownList("Models", null, htmlAttributes: new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="control-label col-md-2">
                Rezervni dio
            </div>
            <div class="col-md-10">
                @Html.DropDownList("Spares", new SelectList(" "), "", new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group">
            <div class="control-label col-md-2">
                Količina
            </div>

            <div class="col-md-10">
                @Html.Editor("Amount", new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <div class="form-group">
            <div class="control-label col-md-2">
                Napomena
            </div>

            <div class="col-md-10">
                @Html.Editor("Note", new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </div>
        <div class="form-group">
            <div class="control-label col-md-2">

            </div>
            <div class="col-md-10">
                @using (Html.BeginForm())
                {
                    <p>

                        <br />
                        <input type="submit" formaction="AddSpare" formmethod="post" value="Dodaj Dio" />
                    </p>
                }
            </div>
        </div>

        <div class="form-group">
            <div class="control-label col-md-2">
                Dodati dijelovi
            </div>
            <div class="col-md-10">
                <table class="table">
                    @if ((Model.SpareParts == null) || (Model.SpareParts.Count == 0))
                    {
                        <tr>
                            <td>
                                Nema dodatih dijelova
                            </td>
                        </tr>

                    }
                    else
                    {
                        <tr>
                            <th>
                                Model
                            </th>
                            <th>
                                Ime
                            </th>
                            <th>
                                Broj
                            </th>
                            <th>
                                Količina
                            </th>
                            <th>
                                Napomena
                            </th> 
                            <th></th>
                        </tr>
                       
                        foreach (var item in Model.SpareParts)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SparePart.Model.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SparePart.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.SparePart.SerialNumber)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Amount)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Note)
                                </td>
                                <td>
                                    @Html.ActionLink("Izbriši", "RemoveSpare", new { ID = item.ID, caseID = Model.ID })
                                </td>
                            </tr>
                        }
                    }

                </table>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Nazad na listu", "Index", "Cases")
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
