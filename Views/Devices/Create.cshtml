@model ServiserOnline.Models.Device

@{
    ViewBag.Title = "Kreiraj uređaj";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Kreiraj uređaj</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Devices",
        new { SelectedProductModel = ViewBag.CreateID },
        new { @class = "btn btn-outline-secondary btn-sm back-link" })
</div>

<div class="row">
    <div class="col-md-6">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                <label class="form-label fw-semibold">Model</label>
                @Html.DropDownList("ModelID", null, "-- Odaberi model --", new { @class = "form-select" })
                @Html.ValidationMessageFor(model => model.ModelID, "", new { @class = "text-danger small" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.SerialNumber, new { @class = "form-label fw-semibold" })
                @Html.EditorFor(model => model.SerialNumber, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.SerialNumber, "", new { @class = "text-danger small" })
            </div>

            <div class="d-flex gap-2">
                <input type="submit" value="Kreiraj" class="btn btn-primary" id="submitBtn" />
                @Html.ActionLink("Odustani", "Index", "Devices",
                    new { SelectedProductModel = ViewBag.CreateID },
                    new { @class = "btn btn-outline-secondary back-link" })
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modelSelect = document.querySelector('select[name="ModelID"]');
            const submitBtn = document.getElementById('submitBtn');

            function updateBackLinks() {
                const id = modelSelect.value;
                const url = id ? '/Devices?SelectedProductModel=' + id : '/Devices';
                document.querySelectorAll('.back-link').forEach(a => a.href = url);
                submitBtn.disabled = !id;
            }

            modelSelect.addEventListener('change', function () {
                if (!this.value)
                    window.location.href = '/Devices/Create';
                else
                    window.location.href = '/Devices/Create?SelectedProductModel=' + this.value;
            });

            updateBackLinks();
        });
    </script>
}
