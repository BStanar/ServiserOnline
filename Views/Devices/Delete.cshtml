@model ServiserOnline.Models.Device

@{
    ViewBag.Title = "Brisanje uređaja";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Brisanje uređaja</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Devices",
        new { SelectedProductModel = ViewBag.CreateID },
        new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-6">
        <div class="alert alert-danger">Sigurni ste da brišete?</div>

        <dl class="row mb-3">
            <dt class="col-sm-4">Model</dt>
            <dd class="col-sm-8">@Model.Model?.Name</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.SerialNumber)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.SerialNumber)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <input type="submit" value="Izbriši" class="btn btn-danger" />
                @Html.ActionLink("Odustani", "Index", "Devices",
                    new { SelectedProductModel = ViewBag.CreateID },
                    new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>
