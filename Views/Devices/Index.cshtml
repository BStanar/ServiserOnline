@model IEnumerable<ServiserOnline.Models.Device>
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq
@using ServiserOnline.Models

@{
    ViewBag.Title = "Uređaji";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var devices = Model?.ToList() ?? new List<Device>();

    string? search           = ViewBag.CurrentFilter as string;
    string  activeTab        = ViewBag.ActiveTab     as string ?? "all";

    Guid selectedModelId     = ViewBag.CreateID is Guid g ? g : Guid.Empty;
    Guid? selectedModelRoute = selectedModelId == Guid.Empty ? (Guid?)null : selectedModelId;

    var modelOptions = ((IEnumerable<SelectListItem>)(ViewBag.ModelID ?? Enumerable.Empty<SelectListItem>())).ToList();

    var groupedModelOptions = modelOptions
        .GroupBy(o => o.Group?.Name ?? "Bez proizvođača")
        .OrderBy(g => g.Key)
        .ToList();

    var serviceCounts   = ViewBag.ServiceCounts as Dictionary<Guid, int> ?? new Dictionary<Guid, int>();
    int totalAll        = ViewBag.AllCount        is int ac  ? ac  : devices.Count;
    int noLocationCount = ViewBag.NoLocationCount is int nlc ? nlc
        : devices.Count(d => d.DeviceInLocations == null || !d.DeviceInLocations.Any());

    int rowsShown  = devices.Count;
    int mfrCount   = devices.Select(d => d.Model?.Manufacturer?.ID ?? Guid.Empty).Distinct().Count();
    int modelCount = devices.Select(d => d.Model?.ID              ?? Guid.Empty).Distinct().Count();

    var byManufacturer = devices
        .GroupBy(d => new { Id = d.Model?.Manufacturer?.ID, Name = d.Model?.Manufacturer?.Name ?? "—" })
        .OrderBy(g => g.Key.Name)
        .ToList();

    Func<Device, DeviceInLocation?> currentInstallation =
        device => device.DeviceInLocations?
            .OrderByDescending(x => x.DateOfInstalation)
            .FirstOrDefault();

    var headerVm = new HeaderViewModel
    {
        Title             = "Uređaji",
        MetaText          = $"{totalAll} uređaja · {mfrCount} proizvođača · {modelCount} modela",
        CriticalText      = noLocationCount > 0 ? $"{noLocationCount} bez lokacije" : null,
        ShowSearch        = true,
        FormAction        = "Index",
        FormController    = "Devices",
        SearchName        = "searchString",
        SearchValue       = search,
        SearchPlaceholder = "Pretraži serijski broj, model ili proizvođača...",
        HiddenFields      = new Dictionary<string, string>
        {
            ["ActiveTab"] = activeTab
        }.Concat(selectedModelRoute.HasValue
            ? new[] { new KeyValuePair<string, string>("SelectedProductModel", selectedModelRoute.ToString()!) }
            : Array.Empty<KeyValuePair<string, string>>())
         .ToDictionary(kv => kv.Key, kv => kv.Value),
        ShowAddButton     = true,
        AddButtonText     = "+ Dodaj uređaj",
        AddButtonId       = "btnOpenCreate",
        AddButtonOnClick  = "openCreateModal()",
        ShowDropdownFilter = true,
        DropdownName      = "SelectedProductModel",
        DropdownLabel     = "Model: svi",
        DropdownItems     = modelOptions,
        FilterButtons = new List<FilterButton>
        {
            new FilterButton
            {
                Text   = "Svi",
                Url    = Url.Action("Index", "Devices", new { ActiveTab = "all",   SelectedProductModel = selectedModelRoute, searchString = search })!,
                Active = activeTab == "all"
            },
            new FilterButton
            {
                Text   = "Nema lokacije",
                Badge  = noLocationCount > 0 ? noLocationCount.ToString() : null,
                Url    = Url.Action("Index", "Devices", new { ActiveTab = "noloc", SelectedProductModel = selectedModelRoute, searchString = search })!,
                Active = activeTab == "noloc"
            }
        },
        RowCount = rowsShown
    };

    // Model picker view-model (shared between create and edit modals)
    var pickerCreateVm = new ModelPickerViewModel
    {
        PickerId       = "createPicker",
        TargetInputId  = "createModelId",
        TargetDisplayId = "createModelDisplay",
        ShowClearButton = true,
        Options        = modelOptions
    };
    var pickerEditVm = new ModelPickerViewModel
    {
        PickerId       = "editPicker",
        TargetInputId  = "editModelId",
        TargetDisplayId = "editModelDisplay",
        ShowClearButton = true,
        Options        = modelOptions
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/card-style.css" asp-append-version="true" />
    <style>
        .devices-page .sp-table { min-width: 1100px; }
        .devices-page .sp-tablewrap { overflow-x: auto; }
        .devices-page .sp-data-row { cursor: pointer; }
        .devices-page .sp-data-row:hover td { background: var(--hover); }

        .dv-serial { font-family: var(--mono); font-weight: 600; color: var(--text); overflow-wrap: anywhere; }
        .dv-id     { display: block; margin-top: 3px; font-size: 11.5px; color: var(--muted); }
        .dv-no-loc { color: var(--danger); font-size: 12.5px; font-weight: 500; }
        .dv-service-link { justify-content: center; min-width: 34px; text-decoration: none; }
        .dv-empty  { padding: 22px; text-align: center; color: var(--muted); }

        /* Fix: prevent mobile CSS from leaving sp-tablewrap hidden after resize */
        @@media (min-width: 901px) {
            .sp-tablewrap { display: block !important; }
            .sp-card-list { display: none !important; }
        }

        /* Model picker selected display */
        .dv-model-selected {
            font-size: 12.5px;
            color: var(--muted);
            min-height: 18px;
            margin-top: 4px;
        }
        .dv-model-selected.has-value { color: var(--text); font-weight: 500; }
    </style>
}

<div class="sp-page-wrap devices-page">

    <partial name="_Header" model="headerVm" />

    @if (!string.IsNullOrWhiteSpace(search) || selectedModelRoute.HasValue || activeTab != "all")
    {
        <div style="padding:6px 0 2px;">
            <a href="/Devices" class="sp-chip" style="color:var(--danger);">
                <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                    <path d="M3.5 3.5l9 9M12.5 3.5l-9 9" />
                </svg>
                Očisti filter
            </a>
        </div>
    }

    @if (TempData["DeviceError"] != null)
    {
        <div class="sp-callout" style="margin:10px 0;">@TempData["DeviceError"]</div>
    }

    @* ── DESKTOP TABLE ── *@
    @if (devices.Any())
    {
        <div class="sp-tablewrap">
            <table class="sp-table" id="devicesTable">
                <thead>
                    <tr>
                        <th style="width:22%">Serijski broj</th>
                        <th style="width:28%">Klijent</th>
                        <th style="width:24%">Lokacija</th>
                        <th style="width:12%">Datum inst.</th>
                        <th style="width:8%" class="num">Servisi</th>
                        <th style="width:36px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mfrGroup in byManufacturer)
                    {
                        var manufacturerKey = "mfr-" + (mfrGroup.Key.Id?.ToString("N") ?? "none");
                        var mfrTotal        = mfrGroup.Count();

                        <partial name="GroupRow" model='@(new GroupRowViewModel {
                            GroupKey         = manufacturerKey,
                            Colspan          = 6,
                            Title            = mfrGroup.Key.Name,
                            Meta             = $"{mfrTotal} uređaja",
                            AddButtonText    = "+ Dodaj uređaj",
                            AddButtonOnClick = $"openCreateWithMfr('{mfrGroup.Key.Id}', event)"
                        })' />

                        @foreach (var modelGroup in mfrGroup
                            .GroupBy(d => new { Id = d.Model?.ID, Name = d.Model?.Name ?? "—" })
                            .OrderBy(g => g.Key.Name))
                        {
                            var modelKey   = "model-" + (modelGroup.Key.Id?.ToString("N") ?? "none");
                            var modelTotal = modelGroup.Count();

                            <partial name="ChildGroupRow" model='@(new ChildGroupRowViewModel {
                                ParentGroupKey   = manufacturerKey,
                                GroupKey         = modelKey,
                                Colspan          = 6,
                                Title            = modelGroup.Key.Name,
                                Meta             = $"{mfrGroup.Key.Name} · {modelTotal} uređaja",
                                AddButtonText    = "+ Dodaj uređaj",
                                AddButtonOnClick = $"openCreateWithModel('{modelGroup.Key.Id}')"
                            })' />

                            @foreach (var item in modelGroup.OrderBy(d => d.SerialNumber))
                            {
                                var inst        = currentInstallation(item);
                                var hasLoc      = inst != null;
                                var clientName  = inst?.Location?.Client?.Name ?? "—";
                                var locName     = inst?.Location?.LocationName ?? "Nema lokacije";
                                var city        = inst?.Location?.City;
                                var locText     = !string.IsNullOrWhiteSpace(city) ? locName + " · " + city : locName;
                                var dateText    = hasLoc ? inst!.DateOfInstalation.ToString("dd.MM.yyyy") : "—";
                                var svcCount    = serviceCounts.TryGetValue(item.ID, out var sc) ? sc : 0;
                                var mdlName     = item.Model?.Name ?? "";
                                var mfrName     = item.Model?.Manufacturer?.Name ?? "";
                                var rowClass    = hasLoc ? "" : "sp-row-warn";

                                var menuItems = new List<ActionMenuItem>
                                {
                                    new ActionMenuItem
                                    {
                                        Text = "Detalji uređaja",
                                        Url  = Url.Action("Details", "Devices", new { id = item.ID })
                                    },
                                    new ActionMenuItem
                                    {
                                        Text       = "Izmijeni",
                                        DataAction = "edit-device",
                                        DataJson   = System.Text.Json.JsonSerializer.Serialize(new {
                                            id = item.ID, serial = item.SerialNumber,
                                            modelId = item.ModelID, modelName = mdlName,
                                            manufacturerName = mfrName
                                        })
                                    },
                                    new ActionMenuItem
                                    {
                                        Text       = "Izbriši",
                                        Variant    = "danger",
                                        DataAction = "delete-device",
                                        DataJson   = System.Text.Json.JsonSerializer.Serialize(new {
                                            id = item.ID, serial = item.SerialNumber,
                                            modelName = mdlName, manufacturerName = mfrName,
                                            serviceCount = svcCount, hasLocation = hasLoc
                                        })
                                    }
                                };

                                <tr class="@rowClass sp-data-row group-@manufacturerKey group-model-@modelKey"
                                    data-id="@item.ID"
                                    onclick="rowNavigate('@Url.Action("Details", "Devices", new { id = item.ID })', event)">
                                    <td>
                                        <div class="dv-serial">@item.SerialNumber</div>
                                        <span class="dv-id">ID: @item.ID</span>
                                    </td>
                                    <td>
                                        @if (hasLoc) { <span>@clientName</span> }
                                        else         { <span class="dv-no-loc">Nema lokacije</span> }
                                    </td>
                                    <td>
                                        @if (hasLoc) { <span>@locText</span> }
                                        else         { <span class="dv-no-loc">Nema lokacije</span> }
                                    </td>
                                    <td><span class="sp-mono">@dateText</span></td>
                                    <td class="num">
                                        <a class="sp-badge sp-badge-ok dv-service-link"
                                           asp-controller="Devices"
                                           asp-action="Details"
                                           asp-route-id="@item.ID"
                                           title="Otvori detalje uređaja"
                                           onclick="event.stopPropagation();">
                                            @svcCount
                                        </a>
                                    </td>
                                    <td onclick="event.stopPropagation();">
                                        <partial name="ActionMenu" model="menuItems" />
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="sp-tablewrap">
            <div class="dv-empty">Nema uređaja za prikaz.</div>
        </div>
    }

    @* ── MOBILE CARDS ── *@
    <div class="sp-card-list">
        @foreach (var mfrGroup in byManufacturer)
        {
            <div class="sp-card-group">
                <div class="sp-card-group-head">
                    <div class="sp-card-group-titleblock">
                        <div class="sp-card-group-title">@mfrGroup.Key.Name</div>
                        <div class="sp-card-group-meta">@mfrGroup.Count() uređaja</div>
                    </div>
                    <div class="sp-card-group-actions">
                        <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost"
                                onclick="openCreateWithMfr('@mfrGroup.Key.Id', event)">
                            + Dodaj uređaj
                        </button>
                    </div>
                </div>

                @foreach (var modelGroup in mfrGroup
                    .GroupBy(d => new { Id = d.Model?.ID, Name = d.Model?.Name ?? "—" })
                    .OrderBy(g => g.Key.Name))
                {
                    <div class="sp-card-section">
                        <div class="sp-card-section-head">
                            <div class="sp-card-section-titleblock">
                                <div class="sp-card-section-title">@modelGroup.Key.Name</div>
                                <div class="sp-card-section-meta">@modelGroup.Count() uređaja</div>
                            </div>
                            <div class="sp-card-section-actions">
                                <button type="button" class="sp-btn sp-btn-xs sp-btn-ghost"
                                        onclick="openCreateWithModel('@modelGroup.Key.Id')">
                                    + Dodaj uređaj
                                </button>
                            </div>
                        </div>
                        <div class="sp-card-items">
                            @foreach (var item in modelGroup.OrderBy(d => d.SerialNumber))
                            {
                                var inst     = currentInstallation(item);
                                var hasLoc   = inst != null;
                                var svcCount = serviceCounts.TryGetValue(item.ID, out var sc2) ? sc2 : 0;
                                var mdlName  = item.Model?.Name ?? "";
                                var mfrName  = item.Model?.Manufacturer?.Name ?? "";
                                var detailsUrl = Url.Action("Details", "Devices", new { id = item.ID });

                                var mobileMenuItems = new List<ActionMenuItem>
                                {
                                    new ActionMenuItem
                                    {
                                        Text       = "Izmijeni",
                                        DataAction = "edit-device",
                                        DataJson   = System.Text.Json.JsonSerializer.Serialize(new {
                                            id = item.ID, serial = item.SerialNumber,
                                            modelId = item.ModelID, modelName = mdlName,
                                            manufacturerName = mfrName
                                        })
                                    },
                                    new ActionMenuItem
                                    {
                                        Text       = "Izbriši",
                                        Variant    = "danger",
                                        DataAction = "delete-device",
                                        DataJson   = System.Text.Json.JsonSerializer.Serialize(new {
                                            id = item.ID, serial = item.SerialNumber,
                                            modelName = mdlName, manufacturerName = mfrName,
                                            serviceCount = svcCount, hasLocation = hasLoc
                                        })
                                    }
                                };

                                <div class="sp-card-item @(hasLoc ? "" : "sp-row-warn")"
                                     style="cursor:pointer;"
                                     onclick="rowNavigate('@detailsUrl', event)">
                                    <div class="sp-card-item-row1">
                                        <div class="sp-card-item-titleblock">
                                            <div class="sp-card-item-title sp-mono">@item.SerialNumber</div>
                                            <div class="sp-card-item-subtitle">
                                                @if (hasLoc)
                                                {
                                                    @(inst!.Location?.Client?.Name ?? "")
                                                    <span style="color:var(--muted)"> — @(inst.Location?.LocationName ?? "")</span>
                                                }
                                                else
                                                {
                                                    <span style="color:var(--danger)">Nema lokacije</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="sp-card-item-right" onclick="event.stopPropagation();">
                                            <span class="sp-badge sp-badge-ok">@svcCount servisa</span>
                                            <partial name="ActionMenu" model="mobileMenuItems" />
                                        </div>
                                    </div>
                                    @if (hasLoc)
                                    {
                                        <div class="sp-card-item-row2">
                                            <span class="sp-mono">@inst!.DateOfInstalation.ToString("dd.MM.yyyy")</span>
                                            <span style="color:var(--muted)">ID: @item.ID</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

@* ── CREATE modal ─────────────────────────────────────────────────────────── *@
<div class="sp-modal-scrim" id="createDeviceScrim"></div>
<div class="sp-modal sp-modal-md" id="createDeviceModal">
    <form asp-controller="Devices" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ModelID" id="createModelId" required />
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Novi uređaj</div>
                <div class="sp-modal-sub" id="createModalSub">Odaberi model i unesi serijski broj.</div>
            </div>
            <button type="button" class="sp-iconbtn" onclick="closeModal('createDeviceScrim','createDeviceModal')">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div class="sp-formgrid">

                <div class="sp-field sp-col-2" id="createModeA">
                    <span class="sp-label">Model <span style="color:var(--danger)">*</span></span>
                    <div class="dv-model-selected" id="createModelDisplay">Nije odabran</div>
                    <partial name="_ModelPicker" model="@pickerCreateVm" />
                    <div class="sp-help">Lista je grupisana po proizvođačima. Opći rezervni dijelovi nisu prikazani.</div>
                </div>

                <div class="sp-field sp-col-2" id="createModeB" style="display:none;">
                    <label class="sp-label" for="createMfrModelSelect">
                        Model <span style="color:var(--danger)">*</span>
                    </label>
                    <select class="sp-input" id="createMfrModelSelect"
                            onchange="document.getElementById('createModelId').value=this.value;">
                        <option value="">Odaberite model…</option>
                        @foreach (var group in groupedModelOptions)
                        {
                            <optgroup label="@group.Key" data-mfr-name="@group.Key.ToLower()">
                                @foreach (var opt in group)
                                {
                                    <option value="@opt.Value">@opt.Text</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div class="sp-field sp-col-2" id="createModeC" style="display:none;">
                    <span class="sp-label">Model</span>
                    <div class="sp-input" id="createModelLocked"
                         style="background:var(--mfr-tint);cursor:default;pointer-events:none;"></div>
                </div>

                <div class="sp-field sp-col-2" style="margin-top:8px;">
                    <label class="sp-label" for="createSerialNumber">Serijski broj <span style="color:var(--danger)">*</span></label>
                    <input type="text" name="SerialNumber" id="createSerialNumber" class="sp-input" maxlength="150" required />
                </div>
            </div>
        </div>
        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" onclick="closeModal('createDeviceScrim','createDeviceModal')">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-primary">Sačuvaj</button>
        </div>
    </form>
</div>

@* ── EDIT modal ───────────────────────────────────────────────────────────── *@
<div class="sp-modal-scrim" id="editDeviceScrim"></div>
<div class="sp-modal sp-modal-md" id="editDeviceModal">
    <form asp-controller="Devices" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ID" id="editDeviceId" />
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Izmijeni uređaj</div>
                <div class="sp-modal-sub" id="editDeviceSubtitle"></div>
            </div>
            <button type="button" class="sp-iconbtn" onclick="closeModal('editDeviceScrim','editDeviceModal')">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <div class="sp-formgrid">
                <div class="sp-field sp-col-2">
                    <span class="sp-label">Model <span style="color:var(--danger)">*</span></span>
                    <input type="hidden" name="ModelID" id="editModelId" required />
                    <div class="dv-model-selected" id="editModelDisplay">Nije odabran</div>
                    <partial name="_ModelPicker" model="@pickerEditVm" />
                </div>
                <div class="sp-field sp-col-2" style="margin-top:8px;">
                    <label class="sp-label" for="editSerialNumber">Serijski broj <span style="color:var(--danger)">*</span></label>
                    <input type="text" name="SerialNumber" id="editSerialNumber" class="sp-input" maxlength="150" required />
                </div>
            </div>
        </div>
        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" onclick="closeModal('editDeviceScrim','editDeviceModal')">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-primary">Sačuvaj izmjene</button>
        </div>
    </form>
</div>

@* ── DELETE modal ─────────────────────────────────────────────────────────── *@
<div class="sp-modal-scrim" id="deleteDeviceScrim"></div>
<div class="sp-modal sp-modal-sm sp-modal-danger" id="deleteDeviceModal">
    <form asp-controller="Devices" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deleteDeviceId" />
        <div class="sp-modal-head">
            <div style="display:flex;gap:10px;align-items:flex-start;">
                <div class="sp-danger-icon">!</div>
                <div>
                    <div class="sp-modal-title">Izbriši uređaj</div>
                    <div class="sp-modal-sub">Brisanje je blokirano ako uređaj ima lokaciju ili servisnu historiju.</div>
                </div>
            </div>
            <button type="button" class="sp-iconbtn" onclick="closeModal('deleteDeviceScrim','deleteDeviceModal')">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
            </button>
        </div>
        <div class="sp-modal-body">
            <p class="sp-muted" id="deleteDeviceText" style="margin-top:14px;"></p>
            <label class="sp-confirm">
                <input type="checkbox" id="deleteDeviceConfirm" />
                <span>Potvrđujem brisanje uređaja.</span>
            </label>
        </div>
        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" onclick="closeModal('deleteDeviceScrim','deleteDeviceModal')">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-danger" id="deleteDeviceSubmit" disabled>Izbriši</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/index-table.js" asp-append-version="true"></script>
    <script>
        // ── Modal helpers ─────────────────────────────────────────────────────
        function openModal(scrimId, modalId) {
            document.getElementById(scrimId).classList.add('open');
            document.getElementById(modalId).classList.add('open');
        }
        function closeModal(scrimId, modalId) {
            document.getElementById(scrimId).classList.remove('open');
            document.getElementById(modalId).classList.remove('open');
        }

        // ── Row click -> Details page ─────────────────────────────────────────
        function rowNavigate(url, event) {
            if (event && event.target.closest('a, button, .sp-more-wrap')) return;
            window.location.href = url;
        }

        // ── Create helpers ────────────────────────────────────────────────────
        function _setCreateMode(mode) {
            document.getElementById('createModeA').style.display = mode === 'A' ? '' : 'none';
            document.getElementById('createModeB').style.display = mode === 'B' ? '' : 'none';
            document.getElementById('createModeC').style.display = mode === 'C' ? '' : 'none';
        }
        function _resetCreate() {
            document.getElementById('createSerialNumber').value = '';
            document.getElementById('createModelId').value = '';
        }

        // Header button - full picker, no pre-filter
        function openCreateModal() {
            _resetCreate();
            _setCreateMode('A');
            document.getElementById('createModelDisplay').textContent = 'Nije odabran';
            document.getElementById('createModelDisplay').classList.remove('has-value');
            spModelPickerFilter('createPicker', '');
            document.querySelectorAll('#createPickerList .sp-modelpicker-item').forEach(el => el.classList.remove('selected'));
            document.getElementById('createModalSub').textContent = 'Odaberi model i unesi serijski broj.';
            openModal('createDeviceScrim', 'createDeviceModal');
        }

        // Manufacturer row button - simple dropdown filtered to that manufacturer
        function openCreateWithMfr(mfrId, event) {
            if (event) event.stopPropagation();
            _resetCreate();
            _setCreateMode('B');
            // Show only optgroups matching this manufacturer
            const sel = document.getElementById('createMfrModelSelect');
            const mfrNameLower = (window._mfrIdToName && window._mfrIdToName[mfrId.toLowerCase()] || '').toLowerCase();
            Array.from(sel.querySelectorAll('optgroup')).forEach(function(og) {
                og.hidden = mfrNameLower ? (og.dataset.mfrName || '') !== mfrNameLower : false;
            });
            sel.value = '';
            // Find mfr name for subtitle
            const mfrName = window._mfrIdToName && window._mfrIdToName[mfrId.toLowerCase()] || '';
            document.getElementById('createModalSub').textContent = mfrName ? mfrName + ' — odaberi model' : 'Odaberi model';
            openModal('createDeviceScrim', 'createDeviceModal');
        }

        // Model row button - model is locked, just show its name
        function openCreateWithModel(modelId) {
            _resetCreate();
            document.getElementById('createModelId').value = modelId;
            _setCreateMode('C');
            // Find label from picker items
            const item = document.querySelector('#createPickerList [data-value="' + modelId + '"]');
            const mfr   = item ? item.dataset.mfr   || '' : '';
            const label = item ? (item.dataset.label || item.textContent.trim()) : modelId;
            document.getElementById('createModelLocked').textContent = mfr ? mfr + ' › ' + label : label;
            document.getElementById('createModalSub').textContent = label;
            openModal('createDeviceScrim', 'createDeviceModal');
        }

        // Mfr Guid -> name map for subtitle
        window._mfrIdToName = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                byManufacturer
                    .Where(g => g.Key.Id.HasValue)
                    .ToDictionary(
                        g => g.Key.Id!.Value.ToString().ToLower(),
                        g => g.Key.Name
                    )
            )
        );

        // ── Edit ──────────────────────────────────────────────────────────────
        function openEditDevice(p) {
            document.getElementById('editDeviceId').value      = p.id        || '';
            document.getElementById('editSerialNumber').value  = p.serial    || '';
            document.getElementById('editModelId').value       = p.modelId   || '';
            document.getElementById('editDeviceSubtitle').textContent =
                (p.manufacturerName || '') + ' · ' + (p.modelName || '');

            const displayEl = document.getElementById('editModelDisplay');
            displayEl.textContent = p.modelId
                ? (p.manufacturerName || '') + ' › ' + (p.modelName || '')
                : 'Nije odabran';
            displayEl.classList.toggle('has-value', !!p.modelId);

            spModelPickerFilter('editPicker', '');
            if (p.modelId) spModelPickerSetValue('editPicker', p.modelId);

            openModal('editDeviceScrim', 'editDeviceModal');
        }

        // ── Delete ────────────────────────────────────────────────────────────
        function openDeleteDevice(p) {
            document.getElementById('deleteDeviceId').value       = p.id || '';
            document.getElementById('deleteDeviceConfirm').checked = false;
            document.getElementById('deleteDeviceSubmit').disabled = true;

            let text = 'Brišeš uređaj ' + p.serial
                + ' (' + p.manufacturerName + ' · ' + p.modelName + ').';
            if (p.hasLocation)      text += ' Uređaj trenutno ima lokaciju.';
            if (p.serviceCount > 0) text += ' Uređaj ima ' + p.serviceCount + ' servisnih naloga.';

            document.getElementById('deleteDeviceText').textContent = text;
            openModal('deleteDeviceScrim', 'deleteDeviceModal');
        }

        document.getElementById('deleteDeviceConfirm').addEventListener('change', function () {
            document.getElementById('deleteDeviceSubmit').disabled = !this.checked;
        });

        // ── Device details modal ──────────────────────────────────────────────
        async function openDeviceDetails(id, event) {
            // Don't open if the click was on an action button/link
            if (event && event.target.closest('a, button, .sp-more-wrap')) return;
            if (event && event.target.closest('[onclick]') && event.currentTarget !== event.target) return;

            document.getElementById('ddSerial').textContent    = '...';
            document.getElementById('ddModelLine').textContent = '';
            document.getElementById('ddHistoryLink').href      = '#';
            document.getElementById('ddBody').innerHTML =
                '<div style="padding:24px;text-align:center;color:var(--muted);font-size:13px;">Učitavanje...</div>';

            openModal('deviceDetailsScrim', 'deviceDetailsModal');

            try {
                const resp = await fetch('/Devices/GetDetailsJson/' + id);
                if (!resp.ok) throw new Error('not found');
                const d = await resp.json();

                document.getElementById('ddSerial').textContent    = d.serial;
                document.getElementById('ddModelLine').textContent = (d.manufacturer || '') + ' › ' + (d.model || '');
                document.getElementById('ddHistoryLink').href       = d.serviceHistory || '#';

                let html = '';

                // Installation block
                if (d.installation) {
                    const i = d.installation;
                    html += '<div style="margin-bottom:16px;">';
                    html += '<div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:8px;">Instalacija</div>';
                    html += '<div class="dv-detail-grid">';
                    html += '<span class="dv-detail-label">Klijent</span><span>' + esc(i.clientName || '—') + '</span>';
                    html += '<span class="dv-detail-label">Lokacija</span><span>' + esc(i.locationName || '—')
                        + (i.city ? ' · ' + esc(i.city) : '') + '</span>';
                    html += '<span class="dv-detail-label">Datum inst.</span><span class="sp-mono">' + esc(i.installDate) + '</span>';
                    html += '<span class="dv-detail-label">Garancija do</span><span class="sp-mono">' + esc(i.guaranteeDate) + '</span>';
                    if (i.description) {
                        html += '<span class="dv-detail-label">Komentar</span><span>' + esc(i.description) + '</span>';
                    }
                    html += '</div></div>';
                } else {
                    html += '<div style="color:var(--danger);font-size:13px;margin-bottom:16px;">Nema aktivne instalacije.</div>';
                }

                // Recent service cases
                if (d.recentCases && d.recentCases.length > 0) {
                    html += '<div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:8px;">Posljednji servisni slučajevi</div>';
                    html += '<table class="sp-table" style="min-width:0;font-size:12.5px;"><thead><tr>';
                    html += '<th>Broj</th><th>Datum</th><th>Vrsta</th><th>Status</th><th></th>';
                    html += '</tr></thead><tbody>';
                    d.recentCases.forEach(function(c) {
                        html += '<tr>';
                        html += '<td class="sp-mono">' + esc(c.number || '—') + '</td>';
                        html += '<td class="sp-mono">' + esc(c.date   || '—') + '</td>';
                        html += '<td>' + esc(c.intervention || '—') + '</td>';
                        html += '<td>' + esc(c.status || '') + '</td>';
                        html += '<td><a href="' + esc(c.detailsUrl) + '" class="sp-btn sp-btn-ghost sp-btn-sm">Detalji</a></td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                } else {
                    html += '<div style="font-size:13px;color:var(--muted);">Nema servisnih intervencija.</div>';
                }

                document.getElementById('ddBody').innerHTML = html;
            } catch (err) {
                document.getElementById('ddBody').innerHTML =
                    '<div style="padding:16px;color:var(--danger);font-size:13px;">Greška pri učitavanju podataka.</div>';
            }
        }

        function esc(str) {
            return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        // ── Action routing (ActionMenu partial dispatches sp:action-menu) ─────
        document.addEventListener('sp:action-menu', function (e) {
            const { action, payload } = e.detail;
            if      (action === 'edit-device')   openEditDevice(payload);
            else if (action === 'delete-device') openDeleteDevice(payload);
        });

        // ── Scrim clicks & Escape ─────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('btnOpenCreate')?.addEventListener('click', openCreateModal);

            [
                ['createDeviceScrim',   'createDeviceModal'],
                ['editDeviceScrim',     'editDeviceModal'],
                ['deleteDeviceScrim',   'deleteDeviceModal']
            ].forEach(([scrim, modal]) => {
                document.getElementById(scrim)?.addEventListener('click', () => closeModal(scrim, modal));
            });

            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Escape') return;
                ['createDeviceScrim,createDeviceModal',
                 'editDeviceScrim,editDeviceModal',
                 'deleteDeviceScrim,deleteDeviceModal']
                .forEach(pair => {
                    const [s, m] = pair.split(',');
                    closeModal(s, m);
                });
            });
        });
    </script>
}
