@model IEnumerable<ServiserOnline.Models.Device>
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    ViewBag.Title = "Uređaji";

    var devices = Model?.ToList() ?? new List<ServiserOnline.Models.Device>();

    string? search = ViewBag.CurrentFilter as string;
    string activeTab = ViewBag.ActiveTab as string ?? "all";

    Guid selectedModelId = ViewBag.CreateID is Guid g ? g : Guid.Empty;
    Guid? selectedModelRoute = selectedModelId == Guid.Empty ? (Guid?)null : selectedModelId;

    var rawModelOptions =
        ((IEnumerable<SelectListItem>)(ViewBag.ModelID
            ?? ViewBag.SelectedProductModel
            ?? Enumerable.Empty<SelectListItem>()))
        .ToList();

    Func<string, bool> isGeneralSpareText = text =>
    {
        text = (text ?? string.Empty).ToLowerInvariant();
        return text.Contains("opci rezervni dijelovi")
            || text.Contains("opći rezervni dijelovi")
            || text.Contains("opsti rezervni dijelovi")
            || text.Contains("opšti rezervni dijelovi")
            || text.Contains("general spare parts");
    };

    var modelOptions = rawModelOptions
        .Where(o => !isGeneralSpareText((o.Text ?? "") + " " + (o.Group?.Name ?? "")))
        .ToList();

    var groupedModelOptions = modelOptions
        .GroupBy(o => o.Group?.Name ?? "Bez proizvođača")
        .OrderBy(g => g.Key)
        .ToList();

    var serviceCounts =
        ViewBag.ServiceCounts as Dictionary<Guid, int>
        ?? new Dictionary<Guid, int>();

    int totalAll = ViewBag.AllCount is int ac ? ac : devices.Count;
    int noLocationCount = ViewBag.NoLocationCount is int nlc
        ? nlc
        : devices.Count(d => d.DeviceInLocations == null || !d.DeviceInLocations.Any());

    int rowsShown = devices.Count;
    int mfrCount = devices
        .Select(d => d.Model?.Manufacturer?.ID ?? Guid.Empty)
        .Distinct()
        .Count();
    int modelCount = devices
        .Select(d => d.Model?.ID ?? Guid.Empty)
        .Distinct()
        .Count();

    var byManufacturer = devices
        .GroupBy(d => new
        {
            Id = d.Model?.Manufacturer?.ID,
            Name = d.Model?.Manufacturer?.Name ?? "—"
        })
        .OrderBy(g => g.Key.Name)
        .ToList();

    Func<ServiserOnline.Models.Device, ServiserOnline.Models.DeviceInLocation?> currentInstallation = device =>
        device.DeviceInLocations?
            .OrderByDescending(x => x.DateOfInstalation)
            .FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="~/css/sp-styles.css" asp-append-version="true" />

    <style>
        .devices-page .sp-table {
            min-width: 1160px;
        }

        .devices-page .sp-tablewrap {
            overflow-x: auto;
            overflow-y: auto;
        }

        .devices-page .sp-row-actions {
            opacity: 1;
        }

        .devices-page .sp-more-menu {
            z-index: 5000;
        }

        .dv-filter-form {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

            .dv-filter-form .sp-search {
                min-width: 340px;
                width: 340px;
            }

        .dv-model-filter {
            width: 245px;
            min-width: 245px;
            height: 32px;
        }

        .dv-serial {
            font-family: var(--mono);
            font-weight: 600;
            color: var(--text);
            overflow-wrap: anywhere;
        }

        .dv-id {
            display: block;
            margin-top: 3px;
            font-size: 11.5px;
            color: var(--muted);
        }

        .dv-muted-line {
            display: block;
            margin-top: 3px;
            font-size: 12.5px;
            color: var(--muted);
            overflow-wrap: anywhere;
        }

        .dv-no-loc {
            color: var(--danger);
            font-size: 12.5px;
            font-weight: 500;
        }

        .dv-service-link {
            justify-content: center;
            min-width: 34px;
            text-decoration: none;
        }

        .dv-empty {
            padding: 22px;
            text-align: center;
            color: var(--muted);
        }

        @@media (max-width: 900px) {
            .dv-filter-form {
                width: 100%;
                align-items: stretch;
            }

                .dv-filter-form .sp-search,
                .dv-filter-form .dv-model-filter,
                .dv-filter-form .sp-btn {
                    width: 100%;
                    min-width: 0;
                }
        }
    </style>
}

<div class="sp-page-wrap devices-page">
    <div class="sp-pagehead">
        <div>
            <h1 class="sp-h1">Uređaji</h1>
            <div class="sp-sub">
                <span>@totalAll uređaja &middot; @mfrCount proizvođača &middot; @modelCount modela</span>
                @if (noLocationCount > 0)
                {
                    <span class="sp-sub-warn">@noLocationCount bez lokacije</span>
                }
            </div>
        </div>

        <div class="sp-actions">
            <form method="get" asp-controller="Devices" asp-action="Index" class="dv-filter-form">
                <input type="hidden" name="ActiveTab" value="@activeTab" />
                @if (selectedModelRoute.HasValue)
                {
                    <input type="hidden" name="SelectedProductModel" value="@selectedModelRoute" />
                }

                <div class="sp-search">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="7" cy="7" r="4.5" /><path d="M14 14l-3.2-3.2" /></svg>
                    <input type="search"
                           name="searchString"
                           value="@search"
                           placeholder="Pretraži serijski broj, model ili proizvođača..." />
                </div>

            </form>

            <span class="sp-divider-v"></span>

            <button type="button" class="sp-btn sp-btn-primary" id="btnOpenCreate">
                <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
                Dodaj uređaj
            </button>
        </div>
    </div>

    @if (TempData["DeviceError"] != null)
    {
        <div class="sp-callout" style="margin-bottom:10px;">
            @TempData["DeviceError"]
        </div>
    }

    <div class="sp-toolbar">
        <div class="sp-chips">
            <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                <form method="get" asp-controller="Devices" asp-action="Index">
                    <input type="hidden" name="searchString" value="@search" />
                    <input type="hidden" name="ActiveTab" value="@activeTab" />
                    <span class="sp-chip" style="padding:0;">
                        <select name="SelectedProductModel"
                                class="sp-chip dv-model-filter"
                                style="border:none;background:transparent;cursor:pointer;"
                                onchange="this.form.submit()">
                            <option value="">Model: svi</option>
                            @foreach (var group in groupedModelOptions)
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var option in group)
                                    {
                                        if (option.Selected || option.Value == selectedModelId.ToString())
                                        {
                                            <option value="@option.Value" selected>@option.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    }
                                </optgroup>
                            }
                        </select>
                    </span>
                </form>

                <a class="sp-tab-btn @(activeTab == "all" ? "active" : "")"
                       href="@Url.Action("Index", "Devices", new { ActiveTab = "all", SelectedProductModel = selectedModelRoute, searchString = search })">
                    Svi
                </a>

                <a class="sp-tab-btn @(activeTab == "noloc" ? "active" : "")"
                       href="@Url.Action("Index", "Devices", new { ActiveTab = "noloc", SelectedProductModel = selectedModelRoute, searchString = search })">
                    Nema lokacije
                    @if (noLocationCount > 0)
                    {
                        <span class="sp-tab-badge-c">@noLocationCount</span>
                    }
                </a>

                @if (!string.IsNullOrWhiteSpace(search) || selectedModelRoute.HasValue || activeTab != "all")
                {
                    <a href="/Devices" class="sp-chip" style="color:var(--danger);">
                        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
                        Očisti filter
                    </a>
                }
            </div>
        </div>

        <div class="sp-meta">@rowsShown redova</div>
    </div>

    @if (devices.Any())
    {
        <div class="sp-tablewrap">
            <table class="sp-table" id="devicesTable">
                <thead>
                    <tr>
                        <th style="width:22%">Serijski broj</th>
                        <th style="width:28%">Klijent</th>
                        <th style="width:26%">Lokacija</th>
                        <th style="width:12%">Datum inst.</th>
                        <th style="width:8%" class="num">Servisi</th>
                        <th style="width:36px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mfrGroup in byManufacturer)
                    {
                        var manufacturerKey = "mfr-" + (mfrGroup.Key.Id?.ToString("N") ?? "none");
                        var mfrTotal = mfrGroup.Count();

                        <tr class="sp-mfr-row" data-group="@manufacturerKey" onclick="toggleGroup('@manufacturerKey')">
                            <td colspan="6">
                                <div style="display:flex;align-items:center;width:100%;">
                                    <span class="sp-mfr-arrow" id="arrow-@manufacturerKey">
                                        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l5 5 5-5" /></svg>
                                    </span>
                                    <span class="sp-mfr-tag">@mfrGroup.Key.Name</span>
                                    <span class="sp-mfr-count">@mfrTotal uređaja</span>
                                    <button type="button"
                                            class="sp-btn sp-btn-xs sp-btn-ghost sp-model-add"
                                            onclick="event.stopPropagation(); openCreateModal();">
                                        + Dodaj uređaj
                                    </button>
                                </div>
                            </td>
                        </tr>

                        foreach (var modelGroup in mfrGroup
                            .GroupBy(d => new { Id = d.Model?.ID, Name = d.Model?.Name ?? "—" })
                            .OrderBy(g => g.Key.Name))
                        {
                            var modelKey = "model-" + (modelGroup.Key.Id?.ToString("N") ?? "none");
                            var modelTotal = modelGroup.Count();

                            <tr class="sp-model-row group-@manufacturerKey" data-model-id="@modelGroup.Key.Id" onclick="toggleModel('@modelKey')">
                                <td colspan="6">
                                    <div style="display:flex;align-items:center;width:100%;">
                                        <span class="sp-model-arrow" id="arrow-@modelKey">
                                            <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6l5 5 5-5" /></svg>
                                        </span>
                                        <span class="sp-model-name">@modelGroup.Key.Name</span>
                                        <span class="sp-model-meta">@mfrGroup.Key.Name &middot; @modelTotal uređaja</span>
                                        <button type="button"
                                                class="sp-btn sp-btn-xs sp-btn-ghost sp-model-add"
                                                onclick="event.stopPropagation(); openCreateWithModel('@modelGroup.Key.Id');">
                                            + Dodaj uređaj
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            foreach (var item in modelGroup.OrderBy(d => d.SerialNumber))
                            {
                                var installation = currentInstallation(item);
                                var hasLocation = installation != null;
                                var clientName = installation?.Location?.Client?.Name ?? "—";
                                var locationName = installation?.Location?.LocationName ?? "Nema lokacije";
                                var city = installation?.Location?.City;
                                var locationText = !string.IsNullOrWhiteSpace(city) ? locationName + " · " + city : locationName;
                                var dateText = hasLocation ? installation!.DateOfInstalation.ToString("dd.MM.yyyy") : "—";
                                var serviceCount = serviceCounts.TryGetValue(item.ID, out var sc) ? sc : 0;
                                var modelName = item.Model?.Name ?? "";
                                var manufacturerName = item.Model?.Manufacturer?.Name ?? "";
                                var rowClass = hasLocation ? "" : "sp-row-warn";

                                <tr class="@rowClass sp-data-row group-@manufacturerKey group-model-@modelKey"
                                    data-id="@item.ID"
                                    data-serial="@item.SerialNumber"
                                    data-model-id="@item.ModelID">
                                    <td>
                                        <div class="dv-serial">@item.SerialNumber</div>
                                        <span class="dv-id">ID: @item.ID</span>
                                    </td>
                                    <td>
                                        @if (hasLocation)
                                        {
                                            <span>@clientName</span>
                                        }
                                        else
                                        {
                                            <span class="dv-no-loc">Nema lokacije</span>
                                        }
                                    </td>
                                    <td>
                                        @if (hasLocation)
                                        {
                                            <span>@locationText</span>
                                        }
                                        else
                                        {
                                            <span class="dv-no-loc">Nema lokacije</span>
                                        }
                                    </td>
                                    <td><span class="sp-mono">@dateText</span></td>
                                    <td class="num">
                                        <a class="sp-badge sp-badge-ok dv-service-link"
                                               asp-controller="Devices"
                                               asp-action="ServiceHistory"
                                               asp-route-id="@item.ID"
                                               title="Otvori historiju servisa">
                                            @serviceCount
                                        </a>
                                    </td>
                                    <td>
                                        <div class="sp-more-wrap sp-row-actions">
                                            <button type="button" class="sp-iconbtn sp-more-trigger">
                                                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="3.5" cy="8" r=".9" fill="currentColor" /><circle cx="8" cy="8" r=".9" fill="currentColor" /><circle cx="12.5" cy="8" r=".9" fill="currentColor" /></svg>
                                            </button>
                                            <div class="sp-more-menu">
                                                <a class="sp-more-item"
                                                       asp-controller="Devices"
                                                       asp-action="ServiceHistory"
                                                       asp-route-id="@item.ID">
                                                    Historija servisa
                                                </a>
                                                <div class="sp-more-item sp-edit-trigger"
                                                     data-id="@item.ID"
                                                     data-serial="@item.SerialNumber"
                                                     data-model-id="@item.ModelID"
                                                     data-model-name="@modelName"
                                                     data-manufacturer-name="@manufacturerName">
                                                    Izmijeni
                                                </div>
                                                <div class="sp-more-item danger sp-delete-trigger"
                                                     data-id="@item.ID"
                                                     data-serial="@item.SerialNumber"
                                                     data-model-name="@modelName"
                                                     data-manufacturer-name="@manufacturerName"
                                                     data-service-count="@serviceCount"
                                                     data-has-location="@(hasLocation ? "true" : "false")">
                                                    Izbriši
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="sp-tablewrap">
            <div class="dv-empty">Nema uređaja za prikaz.</div>
        </div>
    }

    <div class="sp-mobile-cards">
        @foreach (var mfrGroup in byManufacturer)
        {
            <div class="sp-mc-mfr">
                <div class="sp-mc-mfr-head">
                    <div>
                        <div class="sp-mc-mfr-name">@mfrGroup.Key.Name</div>
                        <div class="sp-mc-mfr-meta">@mfrGroup.Count() uređaja</div>
                    </div>
                    <button type="button" class="sp-mc-mfr-add" onclick="openCreateModal()">+ Dodaj</button>
                </div>

                @foreach (var modelGroup in mfrGroup
                    .GroupBy(d => new { Id = d.Model?.ID, Name = d.Model?.Name ?? "—" })
                    .OrderBy(g => g.Key.Name))
                {
                    <div class="sp-mc-model">
                        <div class="sp-mc-model-head">
                            <div>
                                <span class="sp-mc-model-name">@modelGroup.Key.Name</span>
                                <span class="sp-mc-model-meta">@modelGroup.Count() uređaja</span>
                            </div>
                            <button type="button" class="sp-mc-model-add" onclick="openCreateWithModel('@modelGroup.Key.Id')">+ Dodaj</button>
                        </div>

                        @foreach (var item in modelGroup.OrderBy(d => d.SerialNumber))
                        {
                            var installation = currentInstallation(item);
                            var hasLocation = installation != null;
                            var clientName = installation?.Location?.Client?.Name;
                            var locationName = installation?.Location?.LocationName ?? "Nema lokacije";
                            var serviceCount = serviceCounts.TryGetValue(item.ID, out var sc) ? sc : 0;
                            var modelName = item.Model?.Name ?? "";
                            var manufacturerName = item.Model?.Manufacturer?.Name ?? "";

                            <div class="dv-card @(hasLocation ? "" : "sp-mc-item-out")">
                                <div class="dv-card-row1">
                                    <div class="dv-card-serial">@item.SerialNumber</div>
                                    <a class="sp-badge sp-badge-ok"
                                           asp-controller="Devices"
                                           asp-action="ServiceHistory"
                                           asp-route-id="@item.ID">
                                        @serviceCount servisa
                                    </a>
                                </div>
                                <div class="dv-card-row2">
                                    @if (hasLocation)
                                    {
                                        <span>@clientName</span>
                                        <span>@locationName</span>
                                    }
                                    else
                                    {
                                        <span class="dv-no-loc">Nema lokacije</span>
                                    }
                                </div>
                                <div class="dv-card-row3">
                                    <div class="dv-card-dates">
                                        <span>ID: @item.ID</span>
                                    </div>
                                    <div class="dv-mobile-actions">
                                        <a class="sp-btn sp-btn-xs sp-btn-ghost"
                                               asp-controller="Devices"
                                               asp-action="ServiceHistory"
                                               asp-route-id="@item.ID">
                                            Historija
                                        </a>
                                        <button type="button"
                                                class="sp-btn sp-btn-xs sp-btn-ghost sp-edit-trigger"
                                                data-id="@item.ID"
                                                data-serial="@item.SerialNumber"
                                                data-model-id="@item.ModelID"
                                                data-model-name="@modelName"
                                                data-manufacturer-name="@manufacturerName">
                                            Izmijeni
                                        </button>
                                        <button type="button"
                                                class="sp-btn sp-btn-xs sp-btn-ghost danger sp-delete-trigger"
                                                data-id="@item.ID"
                                                data-serial="@item.SerialNumber"
                                                data-model-name="@modelName"
                                                data-manufacturer-name="@manufacturerName"
                                                data-service-count="@serviceCount"
                                                data-has-location="@(hasLocation ? "true" : "false")">
                                            Izbriši
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="sp-modal-scrim" id="createDeviceScrim"></div>
<div class="sp-modal sp-modal-md" id="createDeviceModal">
    <form asp-controller="Devices" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Novi uređaj</div>
                <div class="sp-modal-sub">Kreiranje uređaja.</div>
            </div>
            <button type="button" class="sp-iconbtn" onclick="closeModal('createDeviceScrim', 'createDeviceModal')">×</button>
        </div>

        <div class="sp-modal-body">
            <div class="sp-formgrid">
                <div class="sp-field sp-col-2">
                    <label class="sp-label" for="createModelId">Model</label>
                    <select name="ModelID" id="createModelId" class="sp-input" required>
                        <option value="">Odaberi model</option>
                        @foreach (var group in groupedModelOptions)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var option in group)
                                {
                                    if (option.Value == selectedModelId.ToString())
                                    {
                                        <option value="@option.Value" selected>@option.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@option.Value">@option.Text</option>
                                    }
                                }
                            </optgroup>
                        }
                    </select>
                    <div class="sp-help">Lista je grupisana po proizvođačima. Opći rezervni dijelovi nisu prikazani.</div>
                </div>

                <div class="sp-field sp-col-2">
                    <label class="sp-label" for="createSerialNumber">Serijski broj</label>
                    <input type="text" name="SerialNumber" id="createSerialNumber" class="sp-input" maxlength="150" required />
                </div>
            </div>
        </div>

        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" onclick="closeModal('createDeviceScrim', 'createDeviceModal')">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-primary">Sačuvaj</button>
        </div>
    </form>
</div>

<div class="sp-modal-scrim" id="editDeviceScrim"></div>
<div class="sp-modal sp-modal-md" id="editDeviceModal">
    <form asp-controller="Devices" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ID" id="editDeviceId" />

        <div class="sp-modal-head">
            <div>
                <div class="sp-modal-title">Izmijeni uređaj</div>
                <div class="sp-modal-sub" id="editDeviceSubtitle">Uredi serijski broj i model.</div>
            </div>
            <button type="button" class="sp-iconbtn" onclick="closeModal('editDeviceScrim', 'editDeviceModal')">×</button>
        </div>

        <div class="sp-modal-body">
            <div class="sp-formgrid">
                <div class="sp-field sp-col-2">
                    <label class="sp-label" for="editModelId">Model</label>
                    <select name="ModelID" id="editModelId" class="sp-input" required>
                        <option value="">Odaberi model</option>
                        @foreach (var group in groupedModelOptions)
                        {
                            <optgroup label="@group.Key">
                                @foreach (var option in group)
                                {
                                    <option value="@option.Value">@option.Text</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <div class="sp-field sp-col-2">
                    <label class="sp-label" for="editSerialNumber">Serijski broj</label>
                    <input type="text" name="SerialNumber" id="editSerialNumber" class="sp-input" maxlength="150" required />
                </div>
            </div>
        </div>

        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" onclick="closeModal('editDeviceScrim', 'editDeviceModal')">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-primary">Sačuvaj izmjene</button>
        </div>
    </form>
</div>

<div class="sp-modal-scrim" id="deleteDeviceScrim"></div>
<div class="sp-modal sp-modal-sm sp-modal-danger" id="deleteDeviceModal">
    <form asp-controller="Devices" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" id="deleteDeviceId" />

        <div class="sp-modal-head">
            <div style="display:flex; gap:10px; align-items:flex-start;">
                <div class="sp-danger-icon">!</div>
                <div>
                    <div class="sp-modal-title">Izbriši uređaj</div>
                    <div class="sp-modal-sub">Brisanje je blokirano ako uređaj ima lokaciju ili servisnu historiju.</div>
                </div>
            </div>
            <button type="button" class="sp-iconbtn" onclick="closeModal('deleteDeviceScrim', 'deleteDeviceModal')">×</button>
        </div>

        <div class="sp-modal-body">
            <p class="sp-muted" id="deleteDeviceText" style="margin-top:14px;"></p>
            <label class="sp-confirm">
                <input type="checkbox" id="deleteDeviceConfirm" />
                <span>Potvrđujem brisanje uređaja.</span>
            </label>
        </div>

        <div class="sp-modal-foot">
            <button type="button" class="sp-btn sp-btn-ghost" onclick="closeModal('deleteDeviceScrim', 'deleteDeviceModal')">Odustani</button>
            <button type="submit" class="sp-btn sp-btn-danger" id="deleteDeviceSubmit" disabled>Izbriši</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function openModal(scrimId, modalId) {
            document.getElementById(scrimId).classList.add('open');
            document.getElementById(modalId).classList.add('open');
        }

        function closeModal(scrimId, modalId) {
            document.getElementById(scrimId).classList.remove('open');
            document.getElementById(modalId).classList.remove('open');
        }

        function closeAllMoreMenus() {
            document.querySelectorAll('.sp-more-menu.open').forEach(menu => menu.classList.remove('open'));
        }

        function openCreateModal() {
            const serial = document.getElementById('createSerialNumber');
            if (serial) serial.value = '';
            openModal('createDeviceScrim', 'createDeviceModal');
        }

        function openCreateWithModel(modelId) {
            openCreateModal();
            const select = document.getElementById('createModelId');
            if (select) select.value = modelId || '';
        }

        function toggleGroup(groupKey) {
            const arrow = document.getElementById('arrow-' + groupKey);
            if (!arrow) return;

            const collapsed = !arrow.classList.contains('collapsed');
            arrow.classList.toggle('collapsed', collapsed);

            document.querySelectorAll('.group-' + groupKey).forEach(row => {
                row.style.display = collapsed ? 'none' : '';
            });
        }

        function toggleModel(modelKey) {
            const arrow = document.getElementById('arrow-' + modelKey);
            if (!arrow) return;

            const collapsed = !arrow.classList.contains('collapsed');
            arrow.classList.toggle('collapsed', collapsed);

            document.querySelectorAll('.group-model-' + modelKey).forEach(row => {
                row.style.display = collapsed ? 'none' : '';
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.sp-modal, .sp-modal-scrim').forEach(el => el.classList.remove('open'));

            document.getElementById('btnOpenCreate')?.addEventListener('click', openCreateModal);

            document.querySelectorAll('.sp-more-trigger').forEach(btn => {
                btn.addEventListener('click', function (event) {
                    event.stopPropagation();
                    const menu = btn.closest('.sp-more-wrap')?.querySelector('.sp-more-menu');
                    if (!menu) return;

                    const alreadyOpen = menu.classList.contains('open');
                    closeAllMoreMenus();
                    if (!alreadyOpen) menu.classList.add('open');
                });
            });

            document.addEventListener('click', closeAllMoreMenus);

            document.querySelectorAll('.sp-more-menu').forEach(menu => {
                menu.addEventListener('click', function (event) {
                    event.stopPropagation();
                });
            });

            document.querySelectorAll('.sp-edit-trigger').forEach(btn => {
                btn.addEventListener('click', function () {
                    closeAllMoreMenus();

                    const id = btn.dataset.id || '';
                    const serial = btn.dataset.serial || '';
                    const modelId = btn.dataset.modelId || '';
                    const modelName = btn.dataset.modelName || '';
                    const manufacturerName = btn.dataset.manufacturerName || '';

                    document.getElementById('editDeviceId').value = id;
                    document.getElementById('editSerialNumber').value = serial;
                    document.getElementById('editModelId').value = modelId;
                    document.getElementById('editDeviceSubtitle').textContent = manufacturerName + ' · ' + modelName;

                    openModal('editDeviceScrim', 'editDeviceModal');
                });
            });

            document.querySelectorAll('.sp-delete-trigger').forEach(btn => {
                btn.addEventListener('click', function () {
                    closeAllMoreMenus();

                    const id = btn.dataset.id || '';
                    const serial = btn.dataset.serial || '';
                    const modelName = btn.dataset.modelName || '';
                    const manufacturerName = btn.dataset.manufacturerName || '';
                    const serviceCount = parseInt(btn.dataset.serviceCount || '0', 10);
                    const hasLocation = btn.dataset.hasLocation === 'true';

                    document.getElementById('deleteDeviceId').value = id;
                    document.getElementById('deleteDeviceConfirm').checked = false;
                    document.getElementById('deleteDeviceSubmit').disabled = true;

                    let text = 'Brišeš uređaj ' + serial + ' (' + manufacturerName + ' · ' + modelName + ').';
                    if (hasLocation) {
                        text += ' Uređaj trenutno ima lokaciju, zato brisanje treba biti blokirano u controlleru.';
                    }
                    if (serviceCount > 0) {
                        text += ' Uređaj ima ' + serviceCount + ' servisnih naloga. Historija servisa se ne smije brisati.';
                    }

                    document.getElementById('deleteDeviceText').textContent = text;
                    openModal('deleteDeviceScrim', 'deleteDeviceModal');
                });
            });

            document.getElementById('deleteDeviceConfirm')?.addEventListener('change', function () {
                document.getElementById('deleteDeviceSubmit').disabled = !this.checked;
            });

            ['createDeviceScrim', 'editDeviceScrim', 'deleteDeviceScrim'].forEach(id => {
                document.getElementById(id)?.addEventListener('click', function () {
                    if (id === 'createDeviceScrim') closeModal('createDeviceScrim', 'createDeviceModal');
                    if (id === 'editDeviceScrim') closeModal('editDeviceScrim', 'editDeviceModal');
                    if (id === 'deleteDeviceScrim') closeModal('deleteDeviceScrim', 'deleteDeviceModal');
                });
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeAllMoreMenus();
                    closeModal('createDeviceScrim', 'createDeviceModal');
                    closeModal('editDeviceScrim', 'editDeviceModal');
                    closeModal('deleteDeviceScrim', 'deleteDeviceModal');
                }
            });
        });
    </script>
}
