@model ServiserOnline.Models.Manufacturer

@{
    ViewBag.Title = "Brisanje proizvođača";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Brisanje proizvođača</h2>
    @Html.ActionLink("← Nazad na listu", "Index", "Manufacturers", new { }, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<div class="row">
    <div class="col-md-6">
        <div class="alert alert-danger">Sigurni ste da brišete?</div>

        <dl class="row mb-3">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Country)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Country)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Description)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2">
                <input type="submit" value="Izbriši" class="btn btn-danger" />
                @Html.ActionLink("Odustani", "Index", "Manufacturers", new { }, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    </div>
</div>