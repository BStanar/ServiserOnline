@model IEnumerable<ServiserOnline.Models.ContactPersonManufacturer>

@{
    ViewBag.Title = "Kontakti proizvođača";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Kontakti proizvođača</h2>
    @if (ViewBag.CreateID != Guid.Empty)
    {
        @Html.ActionLink("+ Kreiraj novi", "Create", "ContactPersonManufacturers",
            new { SelectedManufacturer = ViewBag.CreateID },
            new { @class = "btn btn-primary btn-sm" })
    }
    else
    {
        <button class="btn btn-primary btn-sm" disabled title="Odaberite proizvođača prije kreiranja">+ Kreiraj novi</button>
    }
</div>

@using (Html.BeginForm("Index", "ContactPersonManufacturers", FormMethod.Get))
{
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <label class="col-form-label">Proizvođač:</label>
        </div>
        <div class="col-auto">
            @Html.DropDownList("SelectedManufacturer", null, "Svi", new { @class = "form-select form-select-sm", id = "manufacturerFilter" })
        </div>
        <div class="col-auto">
            <input type="submit" value="Filter" class="btn btn-secondary btn-sm" />
        </div>
    </div>
}

<div class="table-responsive d-none d-md-block">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Manufacturer.Name)</th>
                <th>@Html.DisplayNameFor(model => model.ContactPersonRole)</th>
                <th>@Html.DisplayNameFor(model => model.Name)</th>
                <th>@Html.DisplayNameFor(model => model.Surname)</th>
                <th>@Html.DisplayNameFor(model => model.Telephone)</th>
                <th>@Html.DisplayNameFor(model => model.Mobile)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Manufacturer?.Name</td>
                    <td>@item.ContactPersonRole</td>
                    <td>@item.Name</td>
                    <td>@item.Surname</td>
                    <td>@item.Telephone</td>
                    <td>@item.Mobile</td>
                    <td>@item.Email</td>
                    <td>
                        <div class="d-flex flex-wrap gap-1">
                            @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                            @Html.ActionLink("Izbriši", "Delete", new { id = item.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="d-md-none">
    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>@item.Name @item.Surname</strong>
                <span class="badge bg-secondary">@item.Manufacturer?.Name</span>
            </div>
            <div class="card-body p-2">
                <div class="row g-1 mb-2">
                    <div class="col-5 text-muted small fw-semibold">Uloga</div>
                    <div class="col-7 small">@item.ContactPersonRole</div>
                    <div class="col-5 text-muted small fw-semibold">Telefon</div>
                    <div class="col-7 small">@item.Telephone</div>
                    <div class="col-5 text-muted small fw-semibold">Mobitel</div>
                    <div class="col-7 small">@item.Mobile</div>
                    <div class="col-5 text-muted small fw-semibold">Email</div>
                    <div class="col-7 small">@item.Email</div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    @Html.ActionLink("Izmjeni", "Edit", new { id = item.ID }, new { @class = "btn btn-outline-primary btn-sm" })
                    @Html.ActionLink("Izbriši", "Delete", new { id = item.ID }, new { @class = "btn btn-outline-danger btn-sm" })
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-3">
    @Html.ActionLink("← Lista proizvođača", "Index", "Manufacturers", new { }, new { @class = "btn btn-outline-secondary btn-sm" })
</div>
    @section Scripts {
<script>
    document.getElementById('manufacturerFilter').addEventListener('change', function () {
        const id = this.value;
        if (id)
            window.location.href = '/ContactPersonManufacturers?SelectedManufacturer=' + id;
        else
            window.location.href = '/ContactPersonManufacturers';
    });
</script>
}


